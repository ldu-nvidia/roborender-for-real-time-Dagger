+        if self._in_train_rollout and self.vg_enabled:
+            if (
+                self.vg_mode == "online"
+                and self.vg_rollout_action_source == "student"
+                and self._latest_gen_vision is not None
+                and "vision_obs" in obs_dict
+            ):
+                cur = obs_dict["vision_obs"]
+                stale = self._latest_gen_vision.to(device=cur.device, dtype=cur.dtype)
+                obs_dict = dict(obs_dict)
+                obs_dict["vision_obs"] = stale.reshape(cur.shape)
