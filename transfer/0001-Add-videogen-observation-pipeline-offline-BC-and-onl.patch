+    def policy_step(self, policy_model, obs_dict, cur_dones=None):
+        if (not self._in_train_rollout and self.vg_enabled
+                and self.vg_mode == "image_dagger"
+                and os.environ.get("IMAGE_DAGGER_EVAL_RELABEL") == "1"):
+            # diagnostic: evaluate with generated observations in the loop
+            obs_dict = self._image_dagger_relabel(obs_dict, cur_dones)
