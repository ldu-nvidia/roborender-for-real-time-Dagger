+    TRLDistillTrainerObjPredHomieAPI,
+)
+
+logger = _logging.getLogger(__name__)
+
+VIDEO_MODEL_CHUNK = 81
+
+
+class TRLDistillTrainerVideoGen(TRLDistillTrainerObjPredHomieAPI):
+    _tag_names = ["trl", "humanoid_distill_videogen"]
+
+    def _init_trl(self, *args, **kwargs):
+        super()._init_trl(*args, **kwargs)
+
+        vg = self.config.get("videogen", {})
+        self.vg_mode = vg.get("mode", "online")
+        assert self.vg_mode in ("online", "collect", "offline", "image_dagger")
+        self.vg_enabled = bool(vg.get("enable", True))
+        self.vg_prompt = vg.get("prompt", "A humanoid robot manipulating objects on a table.")
+        self.vg_seed = int(vg.get("seed", 42))
+        self.vg_depth_near = float(vg.get("depth_near", 0.25))
+        self.vg_depth_far = float(vg.get("depth_far", 6.0))
+        self.vg_invert_depth = bool(vg.get("invert_depth", True))
+        # "disparity": brightness ~ 1/z (near=white, bg falls to black) — matches
+        # the sim2realgen training depth videos. "linear": legacy linear ramp.
+        self.vg_depth_mode = vg.get("depth_mode", "disparity")
+        assert self.vg_depth_mode in ("disparity", "linear", "h5_v4")
+        self.vg_depth_near_per_view = dict(vg.get("depth_near_per_view", {}))
+        self.vg_depth_far_per_view = dict(vg.get("depth_far_per_view", {}))
+        # h5_v4 (the exact recipe that produced the video model's training
+        # depth, scripts/depth_methods.py in Sim2RealGen_Video_Model):
+        # raw clip -> per-video minmax [0,1] -> 1/(d+1e-3) -> inv clip ->
+        # log -> stretch to uint8. Params per view name.
+        self.vg_invalid_fill = vg.get("invalid_fill", "far")  # far|black
+        self.vg_h5v4_per_view = dict(vg.get("depth_h5v4_per_view", {}))
+        self.vg_h5v4_default = dict(vg.get("depth_h5v4_default",
+                                           {"raw_clip": [0.0, 10.0],
+                                            "inv_clip": [1.0, 20.0]}))
