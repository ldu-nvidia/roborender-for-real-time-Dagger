+# Copyright (c) 2026. Client for the warm Image3F per-frame render server.
+"""Per-frame 3-view image render client (fixed-lag DAgger conditioning).
+
+Server: fast_roborender/image3f_server.py (TCP mode). Protocol identical to
+videogen_client: length-prefixed pickles, arrays as raw-bytes dicts.
+"""
+from __future__ import annotations
+
+import pickle
+import socket
+import struct
+import time
+from typing import Dict, Optional
+
+import numpy as np
+
+from gr00t.rl.utils.videogen_client import encode_array, decode_array
+
+
+class Image3FFrameClient:
+    def __init__(self, host: str, port: int, timeout_s: float = 120.0,
+                 connect_retries: int = 30, connect_retry_interval_s: float = 5.0):
+        self.host, self.port = host, port
+        self.timeout_s = timeout_s
+        self.connect_retries = connect_retries
+        self.connect_retry_interval_s = connect_retry_interval_s
+        self._sock: Optional[socket.socket] = None
+
+    @classmethod
+    def from_endpoint_file(cls, path: str, **kw):
+        with open(path) as f:
+            host, port = f.read().split()
+        c = cls(host, int(port), **kw)
+        c._endpoint_path = path
+        return c
+
+    def _connect(self):
+        last = None
+        for _ in range(self.connect_retries):
+            try:
+                ep = getattr(self, "_endpoint_path", None)
+                if ep:
+                    # server may have been restarted on a new host/port:
+                    # re-read the endpoint file before every attempt
+                    try:
+                        with open(ep) as f:
+                            h, p = f.read().split()
+                        self.host, self.port = h, int(p)
+                    except (OSError, ValueError):
+                        pass
+                s = socket.create_connection((self.host, self.port), timeout=self.timeout_s)
+                s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
+                return s
+            except OSError as exc:
+                last = exc
+                time.sleep(self.connect_retry_interval_s)
+        raise ConnectionError(f"image3f server unreachable {self.host}:{self.port}: {last}")
+
+    def _sockget(self):
+        if self._sock is None:
+            self._sock = self._connect()
+        return self._sock
+
+    def close(self):
+        if self._sock is not None:
+            try:
+                self._sock.close()
+            finally:
+                self._sock = None
+
+    @staticmethod
+    def _recv_exact(sock, n):
+        buf = b""
+        while len(buf) < n:
+            c = sock.recv(n - len(buf))
+            if not c:
+                raise ConnectionError("server closed connection")
+            buf += c
+        return buf
+
+    def _roundtrip(self, req: dict) -> dict:
+        payload = pickle.dumps(req, protocol=pickle.HIGHEST_PROTOCOL)
+        for attempt in range(2):
+            try:
+                sock = self._sockget()
+                sock.sendall(struct.pack("!Q", len(payload)) + payload)
+                n = struct.unpack("!Q", self._recv_exact(sock, 8))[0]
+                return pickle.loads(self._recv_exact(sock, n))
+            except (ConnectionError, OSError):
+                self.close()
+                if attempt == 1:
+                    raise
+        raise ConnectionError("unreachable")
+
+    def ping(self) -> bool:
+        return bool(self._roundtrip({"cmd": "ping"}).get("ok"))
+
+    def render_frame(self, depth: Dict[str, np.ndarray], mask: Dict[str, np.ndarray],
+                     prev: Dict[str, np.ndarray], prompt: str, seed: int = 42
+                     ) -> Dict[str, np.ndarray]:
+        """depth: view->HxW u8 (or HxWx3); mask/prev: view->HxWx3 u8.
+        Returns view -> 240x416x3 u8 generated RGB."""
+        resp = self._roundtrip({
+            "cmd": "render_frame", "prompt": prompt, "seed": seed,
+            "depth": {v: encode_array(a) for v, a in depth.items()},
+            "mask": {v: encode_array(a) for v, a in mask.items()},
+            "prev": {v: encode_array(a) for v, a in prev.items()},
+        })
+        if not resp.get("ok"):
+            raise RuntimeError(f"image3f render failed: {resp.get('error')}")
+        return {v: decode_array(a) for v, a in resp["views"].items()}
