+            # native3view student): capture every configured view.
+            if self.vg_mode == "collect" and hasattr(self.env.simulator, "get_conditioning_views"):
+                views = self.env.simulator.get_conditioning_views()
+                if views:
+                    step_views = {}
+                    for vname, v in views.items():
