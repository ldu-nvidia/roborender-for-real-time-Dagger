@@ -0,0 +1,109 @@
+# Copyright (c) 2026. Client for the Raven video-gen render server.
+"""TCP client used by the videogen distillation trainer.
+
+The server (fast_roborender/roborender-acceleration/runtime/raven_render_server.py)
+holds the Wan/LADD student + TensorRT engines resident and converts 81-frame
+depth(+mask) chunks into realistic RGB chunks. Protocol: length-prefixed pickles.
+"""
+from __future__ import annotations
+
+import pickle
+import socket
+import struct
+import time
+from typing import Optional
+
+import numpy as np
+
+
+def encode_array(arr: np.ndarray) -> dict:
+    """numpy-version-agnostic wire format (raw bytes + dtype/shape)."""
+    arr = np.ascontiguousarray(arr)
+    return {"__nd__": True, "dtype": str(arr.dtype), "shape": tuple(arr.shape),
+            "data": arr.tobytes()}
+
+
+def decode_array(obj) -> np.ndarray:
+    if isinstance(obj, dict) and obj.get("__nd__"):
+        return np.frombuffer(obj["data"], dtype=np.dtype(obj["dtype"])).reshape(obj["shape"])
+    return obj
+
+
+class VideoGenRenderClient:
+    def __init__(self, host: str = "127.0.0.1", port: int = 18913,
+                 timeout_s: float = 900.0, connect_retries: int = 60,
+                 connect_retry_interval_s: float = 5.0):
+        self.host = host
+        self.port = port
+        self.timeout_s = timeout_s
+        self.connect_retries = connect_retries
+        self.connect_retry_interval_s = connect_retry_interval_s
+        self._sock: Optional[socket.socket] = None
+
+    def _connect(self) -> socket.socket:
+        last_err = None
+        for _ in range(self.connect_retries):
+            try:
+                sock = socket.create_connection((self.host, self.port), timeout=self.timeout_s)
+                sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
+                return sock
+            except OSError as exc:
+                last_err = exc
+                time.sleep(self.connect_retry_interval_s)
+        raise ConnectionError(
+            f"could not reach raven render server at {self.host}:{self.port}: {last_err}")
+
+    def _ensure_sock(self) -> socket.socket:
+        if self._sock is None:
+            self._sock = self._connect()
+        return self._sock
+
+    def close(self) -> None:
+        if self._sock is not None:
+            try:
+                self._sock.close()
+            finally:
+                self._sock = None
+
+    @staticmethod
+    def _recv_exact(sock: socket.socket, n: int) -> bytes:
+        buf = b""
+        while len(buf) < n:
+            chunk = sock.recv(n - len(buf))
+            if not chunk:
+                raise ConnectionError("server closed connection mid-message")
+            buf += chunk
+        return buf
+
+    def _roundtrip(self, req: dict) -> dict:
+        payload = pickle.dumps(req, protocol=pickle.HIGHEST_PROTOCOL)
+        for attempt in range(2):
+            sock = self._ensure_sock()
+            try:
+                sock.sendall(struct.pack("!Q", len(payload)) + payload)
+                (length,) = struct.unpack("!Q", self._recv_exact(sock, 8))
+                return pickle.loads(self._recv_exact(sock, length))
+            except (ConnectionError, OSError):
+                self.close()
+                if attempt == 1:
+                    raise
+        raise RuntimeError("unreachable")
+
+    def render_chunk(self, depth_per_view: dict[str, np.ndarray],
+                     mask_per_view: Optional[dict[str, np.ndarray]] = None,
+                     prompt: str = "", seed: int = 42) -> dict[str, np.ndarray]:
+        """Render one 81-frame chunk.
+
+        depth_per_view: {view_name: uint8 [81,H,W] or [81,H,W,3]} control depth video.
+        mask_per_view: optional {view_name: uint8 like depth} robot masks.
+        Returns {view_name: uint8 [81,240,416,3]} generated RGB.
+        """
+        views = []
+        for name, depth in depth_per_view.items():
+            mask = None if mask_per_view is None else mask_per_view.get(name)
+            views.append({"name": name, "depth": encode_array(depth),
+                          "mask": None if mask is None else encode_array(mask)})
+        resp = self._roundtrip({"views": views, "prompt": prompt, "seed": seed})
+        if "error" in resp:
+            raise RuntimeError(f"raven render server error: {resp['error']}")
+        return {name: decode_array(arr) for name, arr in resp["rgb"].items()}
