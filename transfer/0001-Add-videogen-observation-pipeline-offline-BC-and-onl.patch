+# Copyright (c) 2026. Video-generation-based DAgger/BC distillation trainer.
+"""Student distillation with generated (video-model) RGB instead of ray-traced RGB.
+
+Modes (algo.config.videogen.mode):
+
+  online  — teacher-driven 81-step rollouts; after each rollout the captured
+            depth chunks are rendered to RGB by the Raven server and overwrite
+            storage.vision_obs before the DAgger BC update. One update per
+            81-step chunk (the video model's clip length) instead of per step.
+
+  collect — teacher-driven rollouts only; per env-chunk saves an .npz with the
+            disparity control video, actor_obs, gt_actions and dones to
+            videogen.collect_dir. No generation, no meaningful learning —
+            run with many envs for fast data collection, then render offline
+            with fast_roborender/offline_render_dataset.py.
+
+  offline — no env stepping: each "rollout" loads num_envs pre-rendered chunks
+            (rgb_gen key added by the offline renderer) from
+            videogen.dataset_dir into storage and runs the BC update.
+            Set value_loss_coef: 0 and entropy_coef: 0 — advantages/returns
+            are zeros, so with num_learning_epochs 1 only the BC loss trains.
+
+Depth is captured from the high-res depth camera when configured
+(simulator.config.cameras.depth_hi_resolution: [240, 416]) so the control
+video needs no upscaling; falls back to the ego camera's depth otherwise.
+"""
+from __future__ import annotations
