+        # model input), control/mask sequences are area-downsized to this
+        # resolution at save time for antialiased edges. [H, W] or [] = off.
+        self.vg_control_res = [int(v) for v in vg.get("control_resolution", [])]
+        self.vg_rollout_action_source = vg.get("rollout_action_source", "teacher")
