+                self._id_sample_anchor(b)
+        if cur_dones is not None:
+            done_idx = torch.nonzero(cur_dones.reshape(-1)).reshape(-1).tolist()
+            for b in done_idx:
+                if b < B:
+                    self._id_sample_anchor(b)
+
+        cam_h, cam_w = int(self.camera_resolution[0]), int(self.camera_resolution[1])
+        t0 = time.perf_counter()
+        vision = obs_dict["vision_obs"]
+        new_vision = vision.clone().reshape(B, cam_h, cam_w, 3)
+        if self._id_env_clients is None or len(self._id_env_clients) != B:
+            from gr00t.rl.utils.image3f_frame_client import Image3FFrameClient
+            nf = len(self._id_endpoint_files)
+            self._id_env_clients = [
+                Image3FFrameClient.from_endpoint_file(self._id_endpoint_files[b % nf])
+                for b in range(B)
+            ]
+        gen_envs = [b for b in range(B)
+                    if not (self._id_use_raytraced or {}).get(b, False)]
+        reqs = {}
+        for b in gen_envs:
+            depth_d, mask_d, prev_d = {}, {}, {}
+            for vname in self.vg_view_names:
+                d = views[vname]["depth"][b, ..., :1].detach().to("cpu", torch.float32)
+                ctrl = self._h5v4_control(d.numpy()[None, None, ..., 0], vname)  # [1,1,H,W]
+                if self.vg_control_res:
+                    ctrl = self._resize_seq(ctrl, self.vg_control_res)
+                depth_d[vname] = ctrl[0, 0].astype(np.uint8)
+                rr = views[vname]["robot_rgb"]
+                m = rr[b].detach().to("cpu").numpy() if rr is not None else \
+                    np.zeros((*depth_d[vname].shape, 3), np.uint8)
+                if self.vg_control_res and m.shape[:2] != tuple(self.vg_control_res):
+                    m = self._resize_seq(m[None, None], self.vg_control_res)[0, 0]
+                mask_d[vname] = m.astype(np.uint8)
+                prev_d[vname] = self._id_anchors[b][vname]
+            reqs[b] = (depth_d, mask_d, prev_d)
+
+        from concurrent.futures import ThreadPoolExecutor
+
+        def _render(b):
+            depth_d, mask_d, prev_d = reqs[b]
+            return self._id_env_clients[b].render_frame(
+                depth_d, mask_d, prev_d, prompt=self._id_prompts[b], seed=self.vg_seed)
+
+        gens = {}
+        if gen_envs:
+            with ThreadPoolExecutor(max_workers=len(gen_envs)) as pool:
+                for b, g in zip(gen_envs, pool.map(_render, gen_envs)):
+                    gens[b] = g
+
+        dump_dir = os.environ.get("IMAGE_DAGGER_DUMP_DIR")
+        for b in gen_envs:
+            gen = gens[b]
+            rgb = gen[self.vg_primary_view]  # 240x416x3 u8
+            if dump_dir and len(self._id_gen_ms) < 15:
+                from PIL import Image as _PILImage
+                os.makedirs(dump_dir, exist_ok=True)
+                step_i = len(self._id_gen_ms)
+                panel = np.concatenate(
+                    [np.stack([reqs[b][0][v]] * 3, -1) for v in self.vg_view_names]
+                    + [gen[v] for v in self.vg_view_names], axis=1)
+                _PILImage.fromarray(panel).save(
+                    os.path.join(dump_dir, f"step{step_i:03d}_env{b}.png"))
+            rgb_t = torch.from_numpy(rgb.copy()).float() / 255.0
+            rgb_t = rgb_t.permute(2, 0, 1)[None]
+            rgb_t = F.interpolate(rgb_t, size=(cam_h, cam_w),
+                                  mode="bilinear", align_corners=False)
+            rgb_t = rgb_t[0].permute(1, 2, 0)
+            new_vision[b] = self._normalize_like_env(rgb_t[None])[0].to(
+                device=new_vision.device, dtype=new_vision.dtype)
+        self._id_gen_ms.append((time.perf_counter() - t0) * 1000)
+        if len(self._id_gen_ms) % 50 == 1:
+            logger.info("image_dagger: %d envs relabeled in %.0fms (avg over %d steps: %.0fms)",
+                        B, self._id_gen_ms[-1], len(self._id_gen_ms),
+                        float(np.mean(self._id_gen_ms)))
+        out = dict(obs_dict)
+        out["vision_obs"] = new_vision.reshape(vision.shape)
+        return out
+
+    def _rollout_step(self, model, obs_dict):
+        if self.vg_mode == "offline":
+            return self._offline_fill_storage(model, obs_dict)
+
+        self._depth_chunk = []
+        self._robot_rgb_chunk = []
+        self._views_chunk = []
+        self._in_train_rollout = True
+        try:
+            out_obs = super()._rollout_step(model, obs_dict)
+        finally:
+            self._in_train_rollout = False
+
+        if self.vg_enabled and self._depth_chunk:
+            if self.vg_mode == "online":
+                self._videogen_relabel()
+            elif self.vg_mode == "collect":
+                self._save_collected_chunks()
+        return out_obs
+
+    # --------------------------------------------------------------- conversion
+    def _depth_to_control_video(self, depth: torch.Tensor,
+                                view: str | None = None) -> np.ndarray:
+        """[T, B, H, W, 1] metric depth -> uint8 [T, B, H, W] control video.
+
+        Per-view near/far via videogen.depth_near_per_view /
+        depth_far_per_view (wrist cams need a much smaller near than the head
+        cam, matching the training data where only the closest few cm of
+        gripper saturate white)."""
+        d = depth.squeeze(-1).numpy()
+        if self.vg_depth_mode == "h5_v4":
+            return self._h5v4_control(d, view)
+        near, far = self.vg_depth_near, self.vg_depth_far
+        if view is not None:
+            near = float(self.vg_depth_near_per_view.get(view, near))
+            far = float(self.vg_depth_far_per_view.get(view, far))
+        # Treat invalid/zero depth (inf was zeroed by the simulator) as far.
+        d = np.where(d <= 1e-6, far, d)
+        d = np.clip(d, near, far)
+        if self.vg_depth_mode == "disparity":
+            d01 = (1.0 / d - 1.0 / far) / (1.0 / near - 1.0 / far)
+        else:
+            d01 = (d - near) / (far - near)
+            if self.vg_invert_depth:
+                d01 = 1.0 - d01
+        return (d01 * 255.0).round().astype(np.uint8)
+
+    def _h5v4_control(self, d: np.ndarray, view: str | None) -> np.ndarray:
+        """Exact h5_v4 recipe from Sim2RealGen depth_methods.py, applied per
+        env-chunk (the per-video unit here). d: [T, B, H, W] metric depth."""
+        params = self.vg_h5v4_per_view.get(view, self.vg_h5v4_default)
+        rlo, rhi = (float(v) for v in params.get("raw_clip", self.vg_h5v4_default["raw_clip"]))
+        ilo, ihi = (float(v) for v in params.get("inv_clip", self.vg_h5v4_default["inv_clip"]))
+        raw_pct = params.get("raw_pct", self.vg_h5v4_default.get("raw_pct"))
+        norm_range = params.get("norm_range")  # fixed [lo,hi] instead of per-video minmax
+
+        out = np.zeros(d.shape, dtype=np.uint8)
+        for b in range(d.shape[1]):
+            db = d[:, b]
+            finite = np.isfinite(db) & (db > 0)
+            if not finite.any():
+                continue
+            blo, bhi = rlo, rhi
+            if raw_pct is not None:
+                # depth_methods.py h5_v4 raw_pct: clip bounds from per-video
+                # percentiles (raw_clip acts as a hard pre-filter), so a few
+                # ultra-near own-robot pixels cannot anchor the range floor.
+                valid_raw = db[finite]
+                mask = (valid_raw >= rlo) & (valid_raw <= rhi)
+                if mask.any():
+                    valid_raw = valid_raw[mask]
+                blo = float(np.percentile(valid_raw, float(raw_pct[0])))
+                bhi = float(np.percentile(valid_raw, float(raw_pct[1])))
+                if bhi <= blo:
+                    bhi = blo + 1e-3
+            dc = np.where(finite, np.clip(db, blo, bhi), bhi)
+            valid = dc[finite]
+            if norm_range is not None:
+                # fixed normalization bounds: a close object no longer anchors
+                # the range to white (keeps object shape) — used for head/ego.
+                lo, hi = float(norm_range[0]), float(norm_range[1])
+            else:
+                lo, hi = float(valid.min()), float(valid.max())
+            if hi <= lo:
+                ob = np.full(db.shape, 128, dtype=np.uint8)
+                ob[~finite] = 0
+                out[:, b] = ob
+                continue
+            dn = np.clip((dc - lo) / (hi - lo), 0.0, 1.0)
+            inv = np.clip(1.0 / (dn + 1e-3), ilo, ihi)
+            x = np.log(inv)
+            p_lo, p_hi = np.log(ilo), np.log(ihi)
+            norm = np.clip((x - p_lo) / (p_hi - p_lo), 0.0, 1.0)
+            ob = (norm * 255.0).astype(np.uint8)
+            if self.vg_invalid_fill == "black":
+                ob[~finite] = 0
+            # "far" (default): invalid pixels keep their far-clip value (dark
+            # gray) instead of pure black — matches the approved far-gray fill.
+            out[:, b] = ob
+        return out
+
+    def _resize_seq(self, arr: np.ndarray, hw: list[int]) -> np.ndarray:
+        """Area-downsize [T,B,H,W] or [T,B,H,W,3] uint8 to (h,w)."""
+        import cv2
+        h, w = int(hw[0]), int(hw[1])
+        if arr.shape[2] == h and arr.shape[3] == w:
+            return arr
+        t, b = arr.shape[0], arr.shape[1]
+        out_shape = (t, b, h, w) + arr.shape[4:]
+        out = np.empty(out_shape, dtype=arr.dtype)
+        for ti in range(t):
+            for bi in range(b):
+                out[ti, bi] = cv2.resize(arr[ti, bi], (w, h),
+                                         interpolation=cv2.INTER_AREA)
+        return out
+
+    def _normalize_like_env(self, rgb01: torch.Tensor) -> torch.Tensor:
+        cam_cfg = self.env.config.simulator.config.cameras
+        if hasattr(cam_cfg, "image_mean") and hasattr(cam_cfg, "image_std"):
+            mean = torch.tensor(list(cam_cfg.image_mean), dtype=rgb01.dtype)
+            std = torch.tensor(list(cam_cfg.image_std), dtype=rgb01.dtype)
+            rgb01 = (rgb01 - mean) / std
+        return rgb01
+
+    # ------------------------------------------------------------------ collect
+    def _save_collected_chunks(self):
+        depth = torch.stack(self._depth_chunk, dim=0)  # [T, B, H, W, 1]
+        self._depth_chunk = []
+        control = self._depth_to_control_video(depth)  # [T, B, H, W]
+        num_envs = control.shape[1]
+
+        # Robot-only RGB (textured robot on black) — the video model's
+        # control_video_2 / rgb_robot conditioning.
+        robot_rgb = None
+        if self._robot_rgb_chunk and len(self._robot_rgb_chunk) == control.shape[0]:
+            robot_rgb = torch.stack(self._robot_rgb_chunk, dim=0).numpy()  # [T,B,H,W,3] u8
+        self._robot_rgb_chunk = []
+
+        # Multi-view conditioning: per-view depth control + robot RGB
+        # (keys depth_ctrl__{view} / rgb_robot__{view}).
+        view_arrays = {}
+        if self._views_chunk and len(self._views_chunk) == control.shape[0]:
+            for vname in self._views_chunk[0]:
+                vdepth = torch.stack([sv[vname]["depth"] for sv in self._views_chunk], dim=0)
+                if self.vg_save_raw_depth_native:
+                    dn_ = vdepth.squeeze(-1).numpy().astype(np.float32)
+                    shift, dmin, dmax = 3.5, 0.0, 10.0
+                    ln, lx = np.log(dmin + shift), np.log(dmax + shift)
+                    q = np.clip(((np.log(np.clip(dn_, 0, dmax) + shift) - ln)
+                                 / (lx - ln) * 16383).round(), 0, 16383).astype(np.uint16)
+                    view_arrays[f"depth_rawq__{vname}"] = q
+                if self.vg_save_raw_depth:
+                    raw = vdepth.squeeze(-1).numpy().astype(np.float16)
+                    if self.vg_control_res:
+                        import cv2
+                        h, w = self.vg_control_res
+                        raw = np.stack([np.stack([
+                            cv2.resize(raw[t, b], (w, h), interpolation=cv2.INTER_NEAREST)
+                            for b in range(raw.shape[1])]) for t in range(raw.shape[0])])
+                    view_arrays[f"depth_raw__{vname}"] = raw
+                ctrl = self._depth_to_control_video(vdepth, view=vname)
+                if self.vg_control_res:
+                    ctrl = self._resize_seq(ctrl, self.vg_control_res)
+                view_arrays[f"depth_ctrl__{vname}"] = ctrl
+                if all(sv[vname]["robot_rgb"] is not None for sv in self._views_chunk):
+                    rr = torch.stack(
+                        [sv[vname]["robot_rgb"] for sv in self._views_chunk], dim=0).numpy()
+                    if self.vg_control_res:
+                        rr = self._resize_seq(rr, self.vg_control_res)
+                    view_arrays[f"rgb_robot__{vname}"] = rr
+                if all(sv[vname].get("rgb") is not None for sv in self._views_chunk):
+                    rs = torch.stack(
+                        [sv[vname]["rgb"] for sv in self._views_chunk], dim=0).numpy()
+                    if self.vg_control_res:
+                        rs = self._resize_seq(rs, self.vg_control_res)
+                    view_arrays[f"rgb_sim__{vname}"] = rs
+        self._views_chunk = []
+
+        # Save every registered obs key except vision (vision is what the
+        # offline renderer synthesizes) so offline policy forwards see the
+        # same obs dict as online ones (actor_obs, homie_obs, ...).
+        obs_arrays = {}
+        for key in self.algo_obs_dim_dict:
+            if key == "vision_obs":
+                continue
+            obs_arrays[f"obs_{key}"] = getattr(self.storage, key).cpu().numpy()
+        gt_actions = self.storage.gt_actions.cpu().numpy()    # [T, B, A]
+        dones = self.storage.dones.cpu().numpy()               # [T, B, 1]
+
+        num_steps = control.shape[0]
+        if self._ep_buf is None:
+            self._ep_buf = [{} for _ in range(num_envs)]
+            self._ep_seq_base = [0] * num_envs
+
+        def _flush(b):
+            self._ep_buf[b] = {}
+
+        def _append(b, t):
+            buf = self._ep_buf[b]
+            if not buf:
+                buf["frames"] = {k: [] for k in view_arrays} if view_arrays else {"depth_ctrl": []}
+                buf["gt"] = []
+                buf["obs"] = {k: [] for k in obs_arrays}
+                if not view_arrays and robot_rgb is not None:
+                    buf["frames"]["rgb_robot"] = []
+            if view_arrays:
+                for k, v in view_arrays.items():
+                    buf["frames"][k].append(v[t, b])
+            else:
+                buf["frames"]["depth_ctrl"].append(control[t, b])
+                if robot_rgb is not None:
+                    buf["frames"]["rgb_robot"].append(robot_rgb[t, b])
+            buf["gt"].append(gt_actions[t, b])
+            for k, v in obs_arrays.items():
+                buf["obs"][k].append(v[t, b])
+
+        def _emit(b):
+            buf = self._ep_buf[b]
+            idx = self._vg_saved_chunks
+            path = os.path.join(
+                self.vg_collect_dir, f"chunk_{self._vg_run_tag}_{idx:07d}.npz")
+            np.savez_compressed(
+                path,
+                gt_actions=np.stack(buf["gt"]).astype(np.float32),
+                dones=np.zeros(VIDEO_MODEL_CHUNK, dtype=bool),
+                prompt=np.array(self.vg_prompt),
+                env_id=np.array(b),
+                seq=np.array(self._ep_seq_base[b]),
+                **{k: np.stack(v) for k, v in buf["frames"].items()},
+                **{k: np.stack(v).astype(np.float32) for k, v in buf["obs"].items()},
+            )
+            self._vg_saved_chunks += 1
+            self._ep_seq_base[b] += 1
+            buf["frames"] = {k: [] for k in buf["frames"]}
+            buf["gt"] = []
+            buf["obs"] = {k: [] for k in buf["obs"]}
+
+        for b in range(num_envs):
+            for t in range(num_steps):
+                _append(b, t)
+                if len(self._ep_buf[b]["gt"]) == VIDEO_MODEL_CHUNK:
+                    _emit(b)
+                if bool(dones[t, b, 0]):
+                    # discard the partial tail of the ended episode and break
+                    # chaining: bump seq so the renderer never chains across
+                    # episode boundaries.
+                    _flush(b)
+                    self._ep_seq_base[b] += 2
+        if self._vg_saved_chunks % (10 * num_envs) < num_envs:
+            logger.info("videogen collect: %d chunks saved to %s",
+                        self._vg_saved_chunks, self.vg_collect_dir)
+
+    # ------------------------------------------------------------------ offline
+    def _next_offline_batch(self, batch: int) -> list[dict]:
+        out = []
+        for _ in range(batch):
+            path = self._offline_files[self._offline_cursor % len(self._offline_files)]
+            self._offline_cursor += 1
+            with np.load(path) as z:
+                if "rgb_gen" not in z:
+                    raise RuntimeError(
+                        f"{path} has no rgb_gen — run offline_render_dataset.py first")
+                out.append({k: z[k].copy() for k in z.files})
+        return out
+
+    def _offline_fill_storage(self, model, obs_dict):
+        """Fill storage from pre-rendered dataset chunks instead of env rollout."""
+        device = self.accelerator.device
+        policy_model = model.policy
+        policy_model.init_rollout()
+        self.storage.clear()
+
+        num_envs = self.env.num_envs
+        chunks = self._next_offline_batch(num_envs)
+        num_steps = self.num_steps_per_env
+
+        cam_h, cam_w = int(self.camera_resolution[0]), int(self.camera_resolution[1])
+
+        rgb = np.stack([c["rgb_gen"][:num_steps] for c in chunks], axis=1)  # [T,B,h,w,3]
+        rgb_t = torch.from_numpy(rgb).float() / 255.0
+        rgb_t = self._normalize_like_env(rgb_t)
+        # Restore every saved obs key (obs_actor_obs, obs_homie_obs,
+        # obs_teacher_obs, ...). teacher_obs IS fed to policy_step: the parent
+        # trainers (gt-label branch, enforce_teacher_rollout) expect gt_actions
+        # to exist, and the loaded ref_model recomputes them deterministically
+        # from the saved teacher_obs — identical to the dataset's gt_actions.
+        obs_seq = {}
+        for c_key in chunks[0]:
+            if c_key.startswith("obs_"):
+                obs_seq[c_key[4:]] = torch.from_numpy(
+                    np.stack([c[c_key][:num_steps] for c in chunks], axis=1)).float()
+        gt_actions = torch.from_numpy(
+            np.stack([c["gt_actions"][:num_steps] for c in chunks], axis=1)).float()
+        dones_np = np.stack([c["dones"][:num_steps] for c in chunks], axis=1)  # [T,B]
+
+        with torch.no_grad():
+            last_obs = None
+            for t in range(num_steps):
+                step_obs = {key: seq[t].to(device) for key, seq in obs_seq.items()}
+                step_obs["vision_obs"] = rgb_t[t].reshape(num_envs, cam_h, cam_w, 3).to(device)
+                last_obs = step_obs
+                policy_state_dict = super().policy_step(policy_model, step_obs)
+
+                for key, value in step_obs.items():
+                    self.storage.update_key(key, value)
+                for key, value in policy_state_dict.items():
+                    if key != "hidden_states":
+                        self.storage.update_key(key, value)
+
+                self.storage.update_key("gt_actions", gt_actions[t].to(device))
+                if self.learn_normalized_actions and "normalized_gt_actions" not in policy_state_dict:
+                    self.storage.update_key(
+                        "normalized_gt_actions", gt_actions[t].to(device))
+
+                zeros1 = torch.zeros(num_envs, 1, device=device)
+                d = torch.from_numpy(dones_np[t].astype(np.float32)).to(device)
+                self.storage.update_key("rewards", zeros1)
+                self.storage.update_key("dones", d.unsqueeze(1).bool())
+                self.storage.update_key("time_outs", torch.zeros(num_envs, 1, device=device).bool())
+                self.storage.update_key("values", zeros1)
+                self.storage.update_key("returns", zeros1)
+                self.storage.update_key("advantages", zeros1)
+                self.storage.increment_step()
+
+        # No env stepping happened, so the logging path needs a well-formed
+        # (empty) episode-info entry to iterate over.
+        self.ep_infos.append({})
+
+        policy_model.clear_rollout() if hasattr(policy_model, "clear_rollout") else None
+        return last_obs
+
+    # --------------------------------------------------------------- generation
+    def _dump_chunk(self, chunk_idx: int, env_i: int,
+                    control: np.ndarray, rgb: np.ndarray) -> None:
+        """Save depth-control + generated RGB side by side as an mp4."""
+        import cv2
+
+        dump_dir = self.vg_dump_dir or os.path.join(
+            getattr(self, "log_dir", None) or "videogen_debug", "videogen_frames")
+        os.makedirs(dump_dir, exist_ok=True)
+        path = os.path.join(dump_dir, f"chunk{chunk_idx:04d}_env{env_i}.mp4")
+
+        t = min(len(control), len(rgb))
+        gen_h, gen_w = rgb.shape[1], rgb.shape[2]
+        writer = cv2.VideoWriter(path, cv2.VideoWriter_fourcc(*"mp4v"),
+                                 15, (gen_w * 2, gen_h))
+        for i in range(t):
+            ctrl = cv2.resize(control[i], (gen_w, gen_h), interpolation=cv2.INTER_NEAREST)
+            ctrl3 = np.repeat(ctrl[..., None], 3, axis=-1)
+            side = np.concatenate([ctrl3, rgb[i]], axis=1)
+            writer.write(cv2.cvtColor(side, cv2.COLOR_RGB2BGR))
+        writer.release()
+        logger.info("videogen: dumped %s", path)
+
+    def _videogen_relabel(self):
+        depth = torch.stack(self._depth_chunk, dim=0)  # [T, B, H, W, 1]
+        self._depth_chunk = []
+        num_steps, num_envs = depth.shape[0], depth.shape[1]
+
+        vs = self.storage.vision_obs  # registered shape [T, B, H, W, C]
+        cam_h, cam_w = int(self.camera_resolution[0]), int(self.camera_resolution[1])
+        expected = num_steps * num_envs * cam_h * cam_w * 3
+        if vs.numel() != expected:
+            raise RuntimeError(
+                "videogen requires a single-frame 3-channel vision_obs "
+                f"(storage {tuple(vs.shape)} vs expected T={num_steps} B={num_envs} "
+                f"H={cam_h} W={cam_w} C=3)."
+            )
+
+        control = self._depth_to_control_video(depth)  # [T, B, H, W]
+        robot_rgb = None
+        if self._robot_rgb_chunk and len(self._robot_rgb_chunk) == num_steps:
+            robot_rgb = torch.stack(self._robot_rgb_chunk, dim=0).numpy()  # [T,B,H,W,3]
+        self._robot_rgb_chunk = []
+
+        gen_all = torch.empty((num_steps, num_envs, cam_h, cam_w, 3), dtype=torch.float32)
+        t_start = time.perf_counter()
+        for env_i in range(num_envs):
+            frames = control[:, env_i]  # [T, H, W]
+            depth_views = {name: frames for name in self.vg_view_names}
+            mask_views = None
+            if robot_rgb is not None:
+                mask_views = {name: robot_rgb[:, env_i] for name in self.vg_view_names}
+            rgb = self._vg_client.render_chunk(
+                depth_views, mask_per_view=mask_views, prompt=self.vg_prompt,
+                seed=self.vg_seed,
+            )[self.vg_primary_view]  # uint8 [T, 240, 416, 3]
+
+            if self._vg_total_chunks < self.vg_dump_first_n_chunks:
+                self._dump_chunk(self._vg_total_chunks, env_i, frames, rgb)
+
+            rgb_t = torch.from_numpy(rgb[:num_steps].copy()).float() / 255.0
+            rgb_t = rgb_t.permute(0, 3, 1, 2)
+            rgb_t = F.interpolate(rgb_t, size=(cam_h, cam_w),
+                                  mode="bilinear", align_corners=False)
+            rgb_t = rgb_t.permute(0, 2, 3, 1)
+            gen_all[:, env_i] = self._normalize_like_env(rgb_t)
+
+        elapsed = time.perf_counter() - t_start
+        self._vg_total_gen_time += elapsed
+        self._vg_total_chunks += 1
+        logger.info(
+            "videogen: relabeled %d envs x %d steps in %.1fs (%.1fs/env, chunk #%d)",
+            num_envs, num_steps, elapsed, elapsed / max(num_envs, 1), self._vg_total_chunks,
+        )
+
+        vs.copy_(gen_all.reshape(vs.shape).to(device=vs.device, dtype=vs.dtype))
+        self._latest_gen_vision = gen_all[-1].clone()
