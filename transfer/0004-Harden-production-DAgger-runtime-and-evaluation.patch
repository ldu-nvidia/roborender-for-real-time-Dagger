+def _begin_validation_rollout_metrics(accelerator, device):
+    """Synchronize the explicit validation arm and start scalar measurements."""
+
+    accelerator.wait_for_everyone()
+    cuda_enabled = bool(
+        getattr(device, "type", None) == "cuda" and torch.cuda.is_available()
+    )
+    baseline_allocated = None
+    baseline_reserved = None
+    if cuda_enabled:
+        torch.cuda.synchronize(device)
+        torch.cuda.reset_peak_memory_stats(device)
+        baseline_allocated = int(torch.cuda.memory_allocated(device))
+        baseline_reserved = int(torch.cuda.memory_reserved(device))
+    return {
+        "started_at": time.perf_counter(),
+        "cuda_enabled": cuda_enabled,
+        "device": str(device),
+        "baseline_allocated_bytes": baseline_allocated,
+        "baseline_reserved_bytes": baseline_reserved,
+    }
+
+
+def _finish_validation_rollout_metrics(accelerator, device, state):
+    """Finish synchronized informational timing and CUDA peak measurements."""
+
+    if state["cuda_enabled"]:
+        torch.cuda.synchronize(device)
+    accelerator.wait_for_everyone()
+    wall_seconds = float(time.perf_counter() - state["started_at"])
+    peak_allocated = None
+    peak_reserved = None
+    peak_delta_allocated = None
+    peak_delta_reserved = None
+    if state["cuda_enabled"]:
+        peak_allocated = int(torch.cuda.max_memory_allocated(device))
+        peak_reserved = int(torch.cuda.max_memory_reserved(device))
+        peak_delta_allocated = max(
+            0, peak_allocated - int(state["baseline_allocated_bytes"])
+        )
+        peak_delta_reserved = max(
+            0, peak_reserved - int(state["baseline_reserved_bytes"])
+        )
+    return {
+        "wall_seconds": wall_seconds,
+        "synchronized": True,
+        "cuda": {
+            "enabled": bool(state["cuda_enabled"]),
+            "device": state["device"],
+            "baseline_allocated_bytes": state["baseline_allocated_bytes"],
+            "baseline_reserved_bytes": state["baseline_reserved_bytes"],
+            "peak_allocated_bytes": peak_allocated,
+            "peak_reserved_bytes": peak_reserved,
+            "peak_delta_allocated_bytes": peak_delta_allocated,
+            "peak_delta_reserved_bytes": peak_delta_reserved,
+        },
+    }
 
 
