+"""Fail-closed runtime evidence for paired RoboRender DAgger evaluation.
+
+This module deliberately does not run evaluation or decide promotion.  It
+records the facts produced by one fixed-seed evaluator invocation and emits
+the exact metrics fragment consumed by :mod:`round_dagger.evaluation`.
+
+The accumulator is strict and transactional: every generated policy step
+must contain all environments and exactly the three production views, every
+completed episode must have one expert/student action pair per step, and the
+runtime scenario identity must match the immutable paired-evaluation
+contract.  Any missing, duplicate, non-finite, or renderer-error evidence
+prevents finalization.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import math
+import os
+import re
+from collections.abc import Mapping, Sequence
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+from gr00t.rl.utils.image3f_frame_client import image3f_request_accounting_snapshot
+
+CONTRACT_SCHEMA = "fast_roborender.round_dagger.paired_evaluation_contract.v1"
+RUNTIME_SCHEMA = "fast_roborender.round_dagger.paired_evaluation_runtime.v1"
+POLICY_VIEWS = ("head_color", "hand_left", "hand_right")
+VIEW_LAYOUT = "vertical"
+RAYTRACED_MIX_PROB = 0.0
+REFERENCE_LAG = 256
+_SHA_RE = re.compile(r"[0-9a-f]{64}")
+
+
+class PairedEvaluationEvidenceError(RuntimeError):
+    """The runtime evidence is incomplete, inconsistent, or unsafe to attest."""
+
+
+def _integer(value: Any, name: str, *, minimum: int = 0) -> int:
+    if type(value) is not int or value < minimum:
+        raise PairedEvaluationEvidenceError(
+            f"{name} must be an integer >= {minimum}"
+        )
+    return value
+
+
+def _sha256(value: Any, name: str) -> str:
+    if not isinstance(value, str) or _SHA_RE.fullmatch(value) is None:
+        raise PairedEvaluationEvidenceError(f"{name} must be a lowercase SHA-256")
+    return value
+
+
+def _boolean(value: Any, name: str) -> bool:
+    if type(value) is not bool:
+        raise PairedEvaluationEvidenceError(f"{name} must be boolean")
+    return value
+
+
+def _json_object_no_duplicates(path: Path) -> dict[str, Any]:
+    def pairs(values: list[tuple[str, Any]]) -> dict[str, Any]:
+        result: dict[str, Any] = {}
+        for key, value in values:
+            if key in result:
+                raise PairedEvaluationEvidenceError(
+                    f"paired evaluation contract contains duplicate key {key!r}"
+                )
+            result[key] = value
+        return result
+
+    try:
+        with path.open("r", encoding="utf-8") as handle:
+            value = json.load(handle, object_pairs_hook=pairs)
+    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
+        raise PairedEvaluationEvidenceError(
+            f"cannot read paired evaluation contract: {exc}"
+        ) from exc
+    if not isinstance(value, dict):
+        raise PairedEvaluationEvidenceError(
+            "paired evaluation contract must be a JSON object"
+        )
+    return value
+
+
+def _as_numpy(value: Any, name: str) -> np.ndarray:
+    """Convert NumPy/torch/sequence values without retaining device state."""
+
+    detach = getattr(value, "detach", None)
+    if callable(detach):
+        value = detach()
+        cpu = getattr(value, "cpu", None)
+        if callable(cpu):
+            value = cpu()
+        contiguous = getattr(value, "contiguous", None)
+        if callable(contiguous):
+            value = contiguous()
+        numpy = getattr(value, "numpy", None)
+        if callable(numpy):
+            value = numpy()
+    try:
+        array = np.asarray(value)
+    except (TypeError, ValueError) as exc:
+        raise PairedEvaluationEvidenceError(
+            f"{name} cannot be represented as an array"
+        ) from exc
+    if array.size == 0:
+        raise PairedEvaluationEvidenceError(f"{name} must not be empty")
+    if array.dtype.hasobject:
+        raise PairedEvaluationEvidenceError(f"{name} must not use object dtype")
+    return np.ascontiguousarray(array)
+
+
+def generated_view_sha256(value: Any) -> str:
+    """Return a representation-aware identity for one generated RGB view.
+
+    A caller may pass a previously computed lowercase SHA-256.  Array hashes
+    bind dtype and shape in addition to bytes, so differently interpreted
+    payloads cannot share an identity merely because their raw buffers match.
+    """
+
+    if isinstance(value, str):
+        return _sha256(value, "generated view identity")
+    digest = hashlib.sha256()
+    if isinstance(value, (bytes, bytearray, memoryview)):
+        payload = bytes(value)
+        if not payload:
+            raise PairedEvaluationEvidenceError("generated view bytes must not be empty")
+        digest.update(b"bytes\0")
+        digest.update(len(payload).to_bytes(8, "big"))
+        digest.update(payload)
+        return digest.hexdigest()
+    array = _as_numpy(value, "generated view")
+    header = json.dumps(
+        {"dtype": array.dtype.str, "shape": list(array.shape)},
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("ascii")
+    digest.update(b"ndarray\0")
+    digest.update(len(header).to_bytes(8, "big"))
+    digest.update(header)
+    digest.update(memoryview(array).cast("B"))
+    return digest.hexdigest()
+
+
+class PairedEvaluationEvidence:
+    """Accumulate one seed's generated-only, one-episode-per-env evidence."""
+
+    def __init__(
+        self,
+        *,
+        num_envs: int,
+        generation_seed: int,
+        scenario_ids_by_env: Mapping[int, str],
+        runtime_policy_sha256: str,
+        evaluation_config_sha256: str,
+        evaluator_code_sha256: str,
+    ) -> None:
+        self.num_envs = _integer(num_envs, "num_envs", minimum=1)
+        self.generation_seed = _integer(generation_seed, "generation_seed")
+        expected_envs = set(range(self.num_envs))
+        if not isinstance(scenario_ids_by_env, Mapping):
+            raise PairedEvaluationEvidenceError(
+                "scenario_ids_by_env must be a mapping"
+            )
+        if set(scenario_ids_by_env) != expected_envs or any(
+            type(key) is not int for key in scenario_ids_by_env
+        ):
+            raise PairedEvaluationEvidenceError(
+                "scenario_ids_by_env must cover integer env indices 0..N-1"
+            )
+        self._scenario_ids = {
+            env: _sha256(scenario_ids_by_env[env], f"scenario_ids_by_env[{env}]")
+            for env in range(self.num_envs)
+        }
+        self.runtime_policy_sha256 = _sha256(
+            runtime_policy_sha256, "runtime_policy_sha256"
+        )
+        self.evaluation_config_sha256 = _sha256(
+            evaluation_config_sha256, "evaluation_config_sha256"
+        )
+        self.evaluator_code_sha256 = _sha256(
+            evaluator_code_sha256, "evaluator_code_sha256"
+        )
+        self._generated_policy_steps = 0
+        self._generated_frames = 0
+        self._first_generated_views: dict[int, dict[str, str]] = {}
+        self._action_squared_error = {env: 0.0 for env in range(self.num_envs)}
+        self._action_element_count = {env: 0 for env in range(self.num_envs)}
+        self._action_step_count = {env: 0 for env in range(self.num_envs)}
+        self._episodes: dict[int, dict[str, Any]] = {}
+        self._renderer_errors = 0
+        self._renderer_replays = 0
+        self._renderer_accounting_baseline = image3f_request_accounting_snapshot()
+        self._sealed = False
+        self._finalized: dict[str, Any] | None = None
+
+    @classmethod
+    def from_contract(
+        cls,
+        contract: Mapping[str, Any],
+        *,
+        num_envs: int,
+        generation_seed: int,
+        runtime_policy_sha256: str,
+        policy_views: Sequence[str],
+        view_layout: str,
+        raytraced_mix_prob: float,
+        reference_lag: int,
+        training_enabled: bool,
+        eval_relabel_enabled: bool,
+        one_episode_per_environment: bool,
+    ) -> "PairedEvaluationEvidence":
+        """Validate actual evaluator settings against an immutable contract."""
+
+        if not isinstance(contract, Mapping) or contract.get("schema") != CONTRACT_SCHEMA:
+            raise PairedEvaluationEvidenceError(
+                "paired evaluation contract schema mismatch"
+            )
+        if type(reference_lag) is not int:
+            raise PairedEvaluationEvidenceError("reference_lag must be an integer")
+        training_enabled = _boolean(training_enabled, "training_enabled")
+        eval_relabel_enabled = _boolean(
+            eval_relabel_enabled, "eval_relabel_enabled"
+        )
+        one_episode_per_environment = _boolean(
+            one_episode_per_environment, "one_episode_per_environment"
+        )
+        if isinstance(raytraced_mix_prob, bool):
+            raise PairedEvaluationEvidenceError(
+                "raytraced_mix_prob must be a finite number"
+            )
+        try:
+            raytraced_mix_prob = float(raytraced_mix_prob)
+        except (TypeError, ValueError) as exc:
+            raise PairedEvaluationEvidenceError(
+                "raytraced_mix_prob must be a finite number"
+            ) from exc
+        if not math.isfinite(raytraced_mix_prob):
+            raise PairedEvaluationEvidenceError(
+                "raytraced_mix_prob must be a finite number"
+            )
+        actual_runtime = {
+            "policy_views": list(policy_views),
+            "view_layout": view_layout,
+            "raytraced_mix_prob": raytraced_mix_prob,
+            "reference_lag": reference_lag,
+            "training_enabled": training_enabled,
+            "one_episode_per_environment": one_episode_per_environment,
+        }
+        expected_runtime = {
+            "policy_views": list(POLICY_VIEWS),
+            "view_layout": VIEW_LAYOUT,
+            "raytraced_mix_prob": RAYTRACED_MIX_PROB,
+            "reference_lag": REFERENCE_LAG,
+            "training_enabled": False,
+            "one_episode_per_environment": True,
+        }
+        if contract.get("runtime") != expected_runtime:
+            raise PairedEvaluationEvidenceError(
+                "contract runtime is not generated-only three-view lag-256 evaluation"
+            )
+        if actual_runtime != expected_runtime:
+            raise PairedEvaluationEvidenceError(
+                "actual evaluator runtime differs from the paired evaluation contract"
+            )
+        if not eval_relabel_enabled:
+            raise PairedEvaluationEvidenceError(
+                "paired evaluation requires generated observation relabeling"
+            )
+        num_envs = _integer(num_envs, "num_envs", minimum=1)
+        generation_seed = _integer(generation_seed, "generation_seed")
+        if _integer(
+            contract.get("num_envs_per_seed"),
+            "contract.num_envs_per_seed",
+            minimum=1,
+        ) != num_envs:
+            raise PairedEvaluationEvidenceError(
+                "runtime environment count differs from paired evaluation contract"
+            )
+
+        runtime_policy_sha256 = _sha256(
+            runtime_policy_sha256, "runtime_policy_sha256"
+        )
+        policies = contract.get("policies")
+        if not isinstance(policies, list):
+            raise PairedEvaluationEvidenceError("contract policies are missing")
+        matching = [
+            policy
+            for policy in policies
+            if isinstance(policy, Mapping)
+            and policy.get("runtime_policy_sha256") == runtime_policy_sha256
+        ]
+        if len(matching) != 1:
+            raise PairedEvaluationEvidenceError(
+                "runtime policy identity does not select exactly one contract policy"
+            )
+
+        cases = contract.get("scenario_cases")
+        if not isinstance(cases, list):
+            raise PairedEvaluationEvidenceError("contract scenario cases are missing")
+        selected: dict[int, str] = {}
+        for case in cases:
+            if not isinstance(case, Mapping):
+                continue
+            case_seed = case.get("seed")
+            if type(case_seed) is not int or case_seed != generation_seed:
+                continue
+            env_index = case.get("env_index")
+            if type(env_index) is not int or env_index in selected:
+                raise PairedEvaluationEvidenceError(
+                    "contract has malformed or duplicate environment cases"
+                )
+            selected[env_index] = _sha256(
+                case.get("scenario_id"), f"scenario case {env_index}"
+            )
+        if set(selected) != set(range(num_envs)):
+            raise PairedEvaluationEvidenceError(
+                "contract has no complete scenario block for the generation seed"
+            )
+        return cls(
+            num_envs=num_envs,
+            generation_seed=generation_seed,
+            scenario_ids_by_env=selected,
+            runtime_policy_sha256=runtime_policy_sha256,
+            evaluation_config_sha256=_sha256(
+                contract.get("evaluation_config_sha256"),
+                "contract.evaluation_config_sha256",
+            ),
+            evaluator_code_sha256=_sha256(
+                contract.get("evaluator_code_sha256"),
+                "contract.evaluator_code_sha256",
+            ),
+        )
+
+    @classmethod
+    def from_environment(
+        cls,
+        *,
+        num_envs: int,
+        generation_seed: int,
+        actual_runtime_policy_sha256: str,
+        policy_views: Sequence[str],
+        view_layout: str,
+        raytraced_mix_prob: float,
+        reference_lag: int,
+        training_enabled: bool,
+        eval_relabel_enabled: bool,
+        one_episode_per_environment: bool,
+        environ: Mapping[str, str] | None = None,
+    ) -> "PairedEvaluationEvidence":
+        """Load and bind the contract selected by the evaluator environment."""
+
+        values = os.environ if environ is None else environ
+        if values.get("IMAGE_DAGGER_PAIRED_EVAL") != "1":
+            raise PairedEvaluationEvidenceError(
+                "IMAGE_DAGGER_PAIRED_EVAL=1 is required"
+            )
+        contract_value = values.get("IMAGE_DAGGER_PAIRED_EVAL_CONTRACT")
+        if not contract_value:
+            raise PairedEvaluationEvidenceError(
+                "IMAGE_DAGGER_PAIRED_EVAL_CONTRACT is required"
+            )
+        runtime_policy = values.get("IMAGE_DAGGER_EXPECT_RUNTIME_POLICY_SHA256")
+        if runtime_policy is None:
+            raise PairedEvaluationEvidenceError(
+                "IMAGE_DAGGER_EXPECT_RUNTIME_POLICY_SHA256 is required"
+            )
+        actual_runtime_policy_sha256 = _sha256(
+            actual_runtime_policy_sha256, "actual_runtime_policy_sha256"
+        )
+        if runtime_policy != actual_runtime_policy_sha256:
+            raise PairedEvaluationEvidenceError(
+                "loaded runtime policy identity differs from evaluator environment"
+            )
+        contract = _json_object_no_duplicates(Path(contract_value))
+        return cls.from_contract(
+            contract,
+            num_envs=num_envs,
+            generation_seed=generation_seed,
+            runtime_policy_sha256=actual_runtime_policy_sha256,
+            policy_views=policy_views,
+            view_layout=view_layout,
+            raytraced_mix_prob=raytraced_mix_prob,
+            reference_lag=reference_lag,
+            training_enabled=training_enabled,
+            eval_relabel_enabled=eval_relabel_enabled,
+            one_episode_per_environment=one_episode_per_environment,
+        )
+
+    def _ensure_open(self) -> None:
+        if self._sealed:
+            raise PairedEvaluationEvidenceError(
+                "paired evaluation evidence has already been finalized"
+            )
+
+    def _env_index(self, value: Any) -> int:
+        env_index = _integer(value, "env_index")
+        if env_index >= self.num_envs:
+            raise PairedEvaluationEvidenceError("env_index is outside 0..N-1")
+        return env_index
+
+    def scenario_id_for_env(self, env_index: int) -> str:
+        """Return the immutable scenario identity assigned to one environment."""
+
+        return self._scenario_ids[self._env_index(env_index)]
+
+    def record_generation_step(
+        self, generated_by_env: Mapping[int, Mapping[str, Any]]
+    ) -> None:
+        """Record one renderer request per environment, transactionally."""
+
+        self._ensure_open()
+        if not isinstance(generated_by_env, Mapping) or set(generated_by_env) != set(
+            range(self.num_envs)
+        ):
+            raise PairedEvaluationEvidenceError(
+                "each generated policy step must cover every environment exactly once"
+            )
+        pending: dict[int, dict[str, str]] = {}
+        for env_index in range(self.num_envs):
+            raw_views = generated_by_env[env_index]
+            if not isinstance(raw_views, Mapping) or set(raw_views) != set(POLICY_VIEWS):
+                raise PairedEvaluationEvidenceError(
+                    f"environment {env_index} must contain exactly {POLICY_VIEWS}"
+                )
+            pending[env_index] = {
+                view: generated_view_sha256(raw_views[view]) for view in POLICY_VIEWS
+            }
+        self._generated_policy_steps += 1
+        self._generated_frames += self.num_envs
+        for env_index, identities in pending.items():
+            self._first_generated_views.setdefault(env_index, identities)
+
+    def record_action_pair(
+        self, env_index: int, expert_action: Any, student_action: Any
+    ) -> None:
+        """Accumulate finite elementwise imitation error for one policy step."""
+
+        self._ensure_open()
+        env_index = self._env_index(env_index)
+        if env_index in self._episodes:
+            raise PairedEvaluationEvidenceError(
+                f"environment {env_index} already completed its first episode"
+            )
+        expert = _as_numpy(expert_action, "expert action")
+        student = _as_numpy(student_action, "student action")
+        if expert.shape != student.shape:
+            raise PairedEvaluationEvidenceError(
+                "expert and student actions must have identical shapes"
+            )
+        if expert.dtype.kind not in "iuf" or student.dtype.kind not in "iuf":
+            raise PairedEvaluationEvidenceError("actions must be real numeric arrays")
+        expert64 = expert.astype(np.float64, copy=False)
+        student64 = student.astype(np.float64, copy=False)
+        if not np.isfinite(expert64).all() or not np.isfinite(student64).all():
+            raise PairedEvaluationEvidenceError("actions must contain only finite values")
+        difference = expert64 - student64
+        squared_error = float(np.dot(difference.reshape(-1), difference.reshape(-1)))
+        if not math.isfinite(squared_error):
+            raise PairedEvaluationEvidenceError("action squared error is non-finite")
+        self._action_squared_error[env_index] += squared_error
+        self._action_element_count[env_index] += int(difference.size)
+        self._action_step_count[env_index] += 1
+
+    def record_action_batch(
+        self,
+        expert_actions: Any,
+        student_actions: Any,
+        *,
+        env_indices: Sequence[int] | None = None,
+    ) -> None:
+        """Record selected rows from a full environment action batch."""
+
+        self._ensure_open()
+        expert = _as_numpy(expert_actions, "expert action batch")
+        student = _as_numpy(student_actions, "student action batch")
+        if expert.shape != student.shape or expert.ndim < 1:
+            raise PairedEvaluationEvidenceError(
+                "expert and student action batches must have identical non-scalar shapes"
+            )
+        selected = list(range(self.num_envs)) if env_indices is None else list(env_indices)
+        if len(set(selected)) != len(selected):
+            raise PairedEvaluationEvidenceError("env_indices must not contain duplicates")
+        validated = [self._env_index(value) for value in selected]
+        if expert.shape[0] != self.num_envs:
+            raise PairedEvaluationEvidenceError(
+                "action batch leading dimension must equal num_envs"
+            )
+        # Validate the complete selected batch before mutating the accumulator.
+        pairs = [(env, expert[env], student[env]) for env in validated]
+        for env, expert_row, student_row in pairs:
+            if env in self._episodes:
+                raise PairedEvaluationEvidenceError(
+                    f"environment {env} already completed its first episode"
+                )
+            for row, name in ((expert_row, "expert action"), (student_row, "student action")):
+                if row.dtype.kind not in "iuf" or not np.isfinite(
+                    row.astype(np.float64, copy=False)
+                ).all():
+                    raise PairedEvaluationEvidenceError(
+                        f"{name} must contain only finite real numbers"
+                    )
+        for env, expert_row, student_row in pairs:
+            self.record_action_pair(env, expert_row, student_row)
+
+    def record_episode_outcome(
+        self,
+        env_index: int,
+        *,
+        scenario_id: str,
+        success: bool,
+        safety_violation: bool,
+        episode_length: int,
+    ) -> None:
+        """Seal one environment's first episode after completeness checks."""
+
+        self._ensure_open()
+        env_index = self._env_index(env_index)
+        if env_index in self._episodes:
+            raise PairedEvaluationEvidenceError(
+                f"environment {env_index} has a duplicate first episode"
+            )
+        scenario_id = _sha256(scenario_id, "scenario_id")
+        if scenario_id != self._scenario_ids[env_index]:
+            raise PairedEvaluationEvidenceError(
+                f"environment {env_index} scenario identity differs from contract"
+            )
+        success = _boolean(success, "success")
+        safety_violation = _boolean(safety_violation, "safety_violation")
+        episode_length = _integer(episode_length, "episode_length", minimum=1)
+        if env_index not in self._first_generated_views:
+            raise PairedEvaluationEvidenceError(
+                f"environment {env_index} has no generated three-view identity"
+            )
+        if self._action_element_count[env_index] < 1:
+            raise PairedEvaluationEvidenceError(
+                f"environment {env_index} has no expert/student action pairs"
+            )
+        if self._action_step_count[env_index] != episode_length:
+            raise PairedEvaluationEvidenceError(
+                f"environment {env_index} action steps differ from episode length"
+            )
+        mse = self._action_squared_error[env_index] / self._action_element_count[env_index]
+        if not math.isfinite(mse) or mse < 0.0:
+            raise PairedEvaluationEvidenceError("action imitation MSE is invalid")
+        self._episodes[env_index] = {
+            "env_index": env_index,
+            "seed": self.generation_seed,
+            "scenario_id": scenario_id,
+            "success": success,
+            "safety_violation": safety_violation,
+            "action_imitation_mse": float(mse),
+            "episode_length": episode_length,
+            "generated_view_sha256": dict(self._first_generated_views[env_index]),
+        }
+
+    def record_renderer_status(
+        self, *, errors_delta: int = 0, replays_delta: int = 0
+    ) -> None:
+        """Accumulate renderer error counters; nonzero totals fail finalization."""
+
+        self._ensure_open()
+        self._renderer_errors += _integer(errors_delta, "renderer errors delta")
+        self._renderer_replays += _integer(replays_delta, "renderer replays delta")
+
+    def finalize(self) -> dict[str, Any]:
+        """Return the exact metrics fragment accepted by the promotion gate."""
+
+        if self._finalized is not None:
+            return copy.deepcopy(self._finalized)
+        renderer_accounting = image3f_request_accounting_snapshot()
+        renderer_errors_delta = (
+            renderer_accounting["errors"]
+            - self._renderer_accounting_baseline["errors"]
+        )
+        renderer_replays_delta = (
+            renderer_accounting["replays"]
+            - self._renderer_accounting_baseline["replays"]
+        )
+        if renderer_errors_delta < 0 or renderer_replays_delta < 0:
+            raise PairedEvaluationEvidenceError(
+                "Image3F request accounting moved backwards"
+            )
+        if (
+            self._renderer_errors + renderer_errors_delta
+            or self._renderer_replays + renderer_replays_delta
+        ):
+            raise PairedEvaluationEvidenceError(
+                "renderer errors or replays make paired evidence unattestable"
+            )
+        if self._generated_policy_steps < 1:
+            raise PairedEvaluationEvidenceError("no generated policy steps were recorded")
+        if self._generated_frames != self._generated_policy_steps * self.num_envs:
+            raise PairedEvaluationEvidenceError("generated frame accounting is inconsistent")
+        expected_envs = set(range(self.num_envs))
+        if set(self._first_generated_views) != expected_envs:
+            raise PairedEvaluationEvidenceError(
+                "generated view identity coverage is incomplete"
+            )
+        if set(self._episodes) != expected_envs:
+            raise PairedEvaluationEvidenceError(
+                "first-episode outcome coverage is incomplete"
+            )
+        runtime = {
+            "schema": RUNTIME_SCHEMA,
+            "eval_relabel_enabled": True,
+            "policy_views": list(POLICY_VIEWS),
+            "view_layout": VIEW_LAYOUT,
+            "raytraced_mix_prob": RAYTRACED_MIX_PROB,
+            "reference_lag": REFERENCE_LAG,
+            "training_enabled": False,
+            "one_episode_per_environment": True,
+            "generation_seed": self.generation_seed,
+            "runtime_policy_sha256": self.runtime_policy_sha256,
+            "evaluation_config_sha256": self.evaluation_config_sha256,
+            "evaluator_code_sha256": self.evaluator_code_sha256,
+        }
+        self._finalized = {
+            "_roborender_paired_evaluation": runtime,
+            "generated_policy_steps": self._generated_policy_steps,
+            "generated_frames": self._generated_frames,
+            "_roborender_paired_episodes": [
+                copy.deepcopy(self._episodes[env]) for env in range(self.num_envs)
+            ],
+        }
+        self._sealed = True
+        return copy.deepcopy(self._finalized)
+
+
+__all__ = [
+    "CONTRACT_SCHEMA",
+    "POLICY_VIEWS",
+    "RUNTIME_SCHEMA",
+    "PairedEvaluationEvidence",
+    "PairedEvaluationEvidenceError",
+    "generated_view_sha256",
+]
