+def _atomic_write_json(path, document):
+    """Durably replace one JSON marker without exposing a partial file."""
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    fd, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
+    temporary = Path(temporary_name)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as handle:
+            json.dump(document, handle, indent=2, sort_keys=True, allow_nan=False)
+            handle.write("\n")
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(temporary, path)
+        directory_fd = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
+        try:
+            os.fsync(directory_fd)
+        finally:
+            os.close(directory_fd)
+    finally:
+        if temporary.exists():
+            temporary.unlink()
+
+
+def _immutable_validation_json_path(raw_path):
+    """Require one existing, real run directory and a fresh JSON target."""
+
+    path = Path(raw_path)
+    run_dir = Path(os.environ["TRAIN_RUN_DIR"])
+    try:
+        resolved_run_dir = run_dir.resolve(strict=True)
+        resolved_parent = path.parent.resolve(strict=True)
+    except OSError as exc:
+        raise RuntimeError(
+            "runtime validation run and evidence directories must already exist"
+        ) from exc
+    if (
+        not resolved_run_dir.is_dir()
+        or run_dir.is_symlink()
+        or resolved_run_dir != run_dir
+    ):
+        raise RuntimeError("runtime validation TRAIN_RUN_DIR must be a canonical real directory")
+    if (
+        not resolved_parent.is_dir()
+        or path.parent.is_symlink()
+        or resolved_parent != path.parent
+    ):
+        raise RuntimeError(
+            "runtime validation evidence parent must be a canonical real directory"
+        )
+    if resolved_run_dir not in resolved_parent.parents and resolved_parent != resolved_run_dir:
+        raise RuntimeError("runtime validation evidence must remain inside TRAIN_RUN_DIR")
+    if path.exists() or path.is_symlink():
+        raise FileExistsError(
+            f"refusing to replace runtime validation evidence: {path}"
+        )
+    return path
+
+
+def _atomic_publish_validation_json(path, document):
+    """Durably publish one informational validation JSON without overwrite."""
+
+    path = _immutable_validation_json_path(path)
+    fd, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
+    temporary = Path(temporary_name)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as handle:
+            json.dump(document, handle, indent=2, sort_keys=True, allow_nan=False)
+            handle.write("\n")
+            handle.flush()
+            os.fchmod(handle.fileno(), 0o444)
+            os.fsync(handle.fileno())
+        os.link(temporary, path, follow_symlinks=False)
+        directory_fd = os.open(
+            path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
+        )
+        try:
+            os.fsync(directory_fd)
+        finally:
+            os.close(directory_fd)
+    finally:
+        if temporary.exists():
+            temporary.unlink()
+
