index 0000000000000000000000000000000000000000..70f8bf01393e3dfdd2b05ed4762335052ced6c1e
--- /dev/null
+++ b/gr00t/rl/trl/trainer/anchor_io.py
@@ -0,0 +1,239 @@
+"""Content-bound, pickle-free loading for Image3F anchor pools."""
+
+from __future__ import annotations
+
+import hashlib
+import io
+import math
+import os
+import re
+import stat
+from contextlib import contextmanager
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Iterator, Sequence
+
+
+SHA256_RE = re.compile(r"[0-9a-f]{64}\Z")
+INVENTORY_ALGORITHM = "len64be(path_utf8)+path_utf8+size64be+sha256_binary"
+
+
+class AnchorIOError(RuntimeError):
+    """An anchor pool or selected archive differs from its contract."""
+
+
+def _true_nonnegative_integer(value: Any, name: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+        raise AnchorIOError(f"{name} must be a non-negative integer")
+    return value
+
+
+def deterministic_anchor_index(
+    *,
+    pool_size: int,
+    seed: int,
+    macro_round: int,
+    episode_id: int,
+    global_env_id: int,
+    global_environment_count: int,
+) -> int:
+    """Select an episode anchor as a stateless, collision-free permutation.
+
+    The former process-local RNG assigned the same anchor sequence to local
+    environment ``b`` in every actor rank and cohort.  In a 256-environment
+    campaign with 32 environments per rank, that exposed only 32 distinct
+    anchors at episode start.  This selector instead uses the immutable global
+    environment identity.  For a fixed ``(seed, macro_round, episode_id)`` the
+    affine map is a permutation of the pool, so all simultaneously active
+    environments receive distinct anchors whenever the pool is large enough.
+
+    Anchor appearance remains intentional domain randomization; this function
+    does not claim that an anchor's synthetic texture metadata describes the
+    simulator's ray-traced materials.
+    """
+
+    pool_size = _true_nonnegative_integer(pool_size, "pool_size")
+    seed = _true_nonnegative_integer(seed, "seed")
+    macro_round = _true_nonnegative_integer(macro_round, "macro_round")
+    episode_id = _true_nonnegative_integer(episode_id, "episode_id")
+    global_env_id = _true_nonnegative_integer(global_env_id, "global_env_id")
+    global_environment_count = _true_nonnegative_integer(
+        global_environment_count, "global_environment_count"
+    )
+    if pool_size == 0:
+        raise AnchorIOError("pool_size must be positive")
+    if global_environment_count == 0:
+        raise AnchorIOError("global_environment_count must be positive")
+    if global_environment_count > pool_size:
+        raise AnchorIOError(
+            "anchor pool must contain at least one entry per global environment"
+        )
+    if global_env_id >= global_environment_count:
+        raise AnchorIOError("global_env_id is outside global_environment_count")
+
+    identity = (
+        "fast-roborender-anchor-permutation-v1\0"
+        f"{seed}\0{macro_round}\0{episode_id}"
+    ).encode("ascii")
+    digest = hashlib.sha256(identity).digest()
+    offset = int.from_bytes(digest[:8], "big") % pool_size
+    stride = int.from_bytes(digest[8:16], "big") % pool_size
+    if stride == 0:
+        stride = 1
+    while math.gcd(stride, pool_size) != 1:
+        stride = (stride + 1) % pool_size
+        if stride == 0:
+            stride = 1
+    return (offset + stride * global_env_id) % pool_size
+
+
+@dataclass(frozen=True)
+class AnchorRecord:
+    path: Path
+    relative_path: str
+    size: int
+    sha256: str
+
+
+def _identity(value: os.stat_result) -> tuple[int, ...]:
+    return (
+        value.st_dev,
+        value.st_ino,
+        value.st_mode,
+        value.st_size,
+        value.st_mtime_ns,
+        value.st_ctime_ns,
+    )
+
+
+def _snapshot_file(path: Path) -> tuple[io.BytesIO, str, os.stat_result]:
+    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
+    try:
+        descriptor = os.open(path, flags)
+    except OSError as exc:
+        raise AnchorIOError(f"cannot safely open anchor {path}: {exc}") from None
+    try:
+        before = os.fstat(descriptor)
+        if not stat.S_ISREG(before.st_mode):
+            raise AnchorIOError(f"anchor is not a regular file: {path}")
+        snapshot = io.BytesIO()
+        digest = hashlib.sha256()
+        observed = 0
+        with os.fdopen(descriptor, "rb", closefd=False) as stream:
+            for block in iter(lambda: stream.read(1024 * 1024), b""):
+                observed += len(block)
+                digest.update(block)
+                snapshot.write(block)
+        after = os.fstat(descriptor)
+        if _identity(before) != _identity(after) or observed != before.st_size:
+            raise AnchorIOError(f"anchor changed while it was snapshotted: {path}")
+        snapshot.seek(0)
+        return snapshot, digest.hexdigest(), before
+    finally:
+        os.close(descriptor)
+
+
+def _directory_state(root: Path) -> tuple[tuple[str, tuple[int, ...]], ...]:
+    try:
+        entries = sorted(os.scandir(root), key=lambda item: item.name)
+    except OSError as exc:
+        raise AnchorIOError(f"cannot enumerate anchor pool {root}: {exc}") from None
+    result: list[tuple[str, tuple[int, ...]]] = []
+    for entry in entries:
+        try:
+            metadata = entry.stat(follow_symlinks=False)
+        except OSError as exc:
+            raise AnchorIOError(f"cannot inspect anchor-pool entry {entry.name}: {exc}") from None
+        if stat.S_ISLNK(metadata.st_mode):
+            raise AnchorIOError(f"anchor pool contains a symbolic link: {entry.name}")
+        if not (stat.S_ISREG(metadata.st_mode) or stat.S_ISDIR(metadata.st_mode)):
+            raise AnchorIOError(f"anchor pool contains a special file: {entry.name}")
+        result.append((entry.name, _identity(metadata)))
+    return tuple(result)
+
+
+def inventory_sha256(records: Sequence[AnchorRecord]) -> str:
+    digest = hashlib.sha256()
+    for record in records:
+        relative = record.relative_path.encode("utf-8")
+        digest.update(len(relative).to_bytes(8, "big"))
+        digest.update(relative)
+        digest.update(record.size.to_bytes(8, "big"))
+        digest.update(bytes.fromhex(record.sha256))
+    return digest.hexdigest()
+
+
+def verify_anchor_pool(
+    root: str | os.PathLike[str],
+    *,
+    expected_count: int,
+    expected_inventory_sha256: str,
+) -> tuple[tuple[Path, ...], dict[str, str], str]:
+    """Bind every top-level NPZ name, size, and byte to one aggregate digest."""
+
+    candidate = Path(os.path.abspath(Path(root).expanduser()))
+    try:
+        root_info = candidate.lstat()
+    except OSError as exc:
+        raise AnchorIOError(f"cannot inspect anchor pool {candidate}: {exc}") from None
+    if stat.S_ISLNK(root_info.st_mode) or not stat.S_ISDIR(root_info.st_mode):
+        raise AnchorIOError("anchor pool must be a real directory")
+    if type(expected_count) is not int or expected_count <= 0:
+        raise AnchorIOError("expected anchor count must be a positive integer")
+    if SHA256_RE.fullmatch(expected_inventory_sha256) is None:
+        raise AnchorIOError("expected anchor inventory must be lowercase SHA-256")
+
+    before = _directory_state(candidate)
+    paths = tuple(
+        candidate / name
+        for name, identity in before
+        if name.endswith(".npz") and stat.S_ISREG(identity[2])
+    )
+    if len(paths) != expected_count:
+        raise AnchorIOError(
+            f"anchor pool contains {len(paths)} NPZ files; expected {expected_count}"
+        )
+    records: list[AnchorRecord] = []
+    for path in paths:
+        snapshot, digest, metadata = _snapshot_file(path)
+        snapshot.close()
+        records.append(
+            AnchorRecord(path, path.relative_to(candidate).as_posix(), metadata.st_size, digest)
+        )
+    if _directory_state(candidate) != before:
+        raise AnchorIOError("anchor pool changed while its inventory was computed")
+    actual = inventory_sha256(records)
+    if actual != expected_inventory_sha256:
+        raise AnchorIOError(
+            f"anchor inventory SHA-256 mismatch: {actual} != {expected_inventory_sha256}"
+        )
+    return (
+        tuple(record.path for record in records),
+        {str(record.path): record.sha256 for record in records},
+        actual,
+    )
+
+
+@contextmanager
+def load_verified_npz(
+    numpy_module: Any,
+    path: str | os.PathLike[str],
+    *,
+    expected_sha256: str | None,
+) -> Iterator[Any]:
+    """Load an NPZ only from an immutable verified snapshot, never with pickle."""
+
+    candidate = Path(os.path.abspath(Path(path).expanduser()))
+    if expected_sha256 is not None and SHA256_RE.fullmatch(expected_sha256) is None:
+        raise AnchorIOError("expected anchor SHA-256 is malformed")
+    snapshot, actual, _ = _snapshot_file(candidate)
+    if expected_sha256 is not None and actual != expected_sha256:
+        snapshot.close()
+        raise AnchorIOError(
+            f"selected anchor SHA-256 mismatch: {actual} != {expected_sha256}"
+        )
+    try:
+        with numpy_module.load(snapshot, allow_pickle=False) as archive:
+            yield archive
+    finally:
+        snapshot.close()
