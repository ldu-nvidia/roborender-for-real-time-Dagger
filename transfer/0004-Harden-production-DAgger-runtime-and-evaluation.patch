+        "torch.backends.cudnn.allow_tf32 = False",
+        "torch.backends.cuda.matmul.allow_tf32 = False",
+        "torch.set_float32_matmul_precision('highest')",
+        "torch.use_deterministic_algorithms(True)",
+    ):
+        assert setting in seeding_source
+
+
+def test_deterministic_seeding_sets_and_restores_torch_runtime_state():
+    import random
+
+    import numpy as np
+    import torch
+
+    seeding_fn = _train_function("seeding")
+    namespace = {
+        "os": os,
+        "random": random,
+        "np": np,
+        "RUNTIME_ADAPTER_CUBLAS_WORKSPACE_CONFIG": ":4096:8",
+    }
+    exec(
+        compile(
+            ast.Module(body=[seeding_fn], type_ignores=[]),
+            str(TRAIN_SOURCE),
+            "exec",
+        ),
+        namespace,
+    )
+    seeding = namespace["seeding"]
+
+    missing = object()
+    original_cublas = os.environ.get("CUBLAS_WORKSPACE_CONFIG", missing)
+    original_pythonhashseed = os.environ.get("PYTHONHASHSEED", missing)
+    python_random_state = random.getstate()
+    numpy_random_state = np.random.get_state()
+    torch_random_state = torch.random.get_rng_state()
+    cuda_random_states = (
+        torch.cuda.get_rng_state_all() if torch.cuda.is_available() else None
+    )
+    original = {
+        "cudnn_benchmark": torch.backends.cudnn.benchmark,
+        "cudnn_deterministic": torch.backends.cudnn.deterministic,
+        "cudnn_allow_tf32": torch.backends.cudnn.allow_tf32,
+        "matmul_allow_tf32": torch.backends.cuda.matmul.allow_tf32,
+        "matmul_precision": torch.get_float32_matmul_precision(),
+        "deterministic_algorithms": (
+            torch.are_deterministic_algorithms_enabled()
+        ),
+        "deterministic_warn_only": (
+            torch.is_deterministic_algorithms_warn_only_enabled()
+        ),
+    }
+    try:
+        os.environ["CUBLAS_WORKSPACE_CONFIG"] = ":4096:8"
+        seeding(17, torch_deterministic=True)
+
+        assert torch.backends.cudnn.benchmark is False
+        assert torch.backends.cudnn.deterministic is True
+        assert torch.backends.cudnn.allow_tf32 is False
+        assert torch.backends.cuda.matmul.allow_tf32 is False
+        assert torch.get_float32_matmul_precision() == "highest"
+        assert torch.are_deterministic_algorithms_enabled() is True
+        assert torch.is_deterministic_algorithms_warn_only_enabled() is False
+    finally:
+        torch.backends.cudnn.benchmark = original["cudnn_benchmark"]
+        torch.backends.cudnn.deterministic = original["cudnn_deterministic"]
+        torch.backends.cudnn.allow_tf32 = original["cudnn_allow_tf32"]
+        torch.backends.cuda.matmul.allow_tf32 = original["matmul_allow_tf32"]
+        torch.set_float32_matmul_precision(original["matmul_precision"])
+        torch.use_deterministic_algorithms(
+            original["deterministic_algorithms"],
+            warn_only=original["deterministic_warn_only"],
+        )
+        random.setstate(python_random_state)
+        np.random.set_state(numpy_random_state)
+        torch.random.set_rng_state(torch_random_state)
+        if cuda_random_states is not None:
+            torch.cuda.set_rng_state_all(cuda_random_states)
+        for name, value in (
+            ("CUBLAS_WORKSPACE_CONFIG", original_cublas),
+            ("PYTHONHASHSEED", original_pythonhashseed),
+        ):
+            if value is missing:
+                os.environ.pop(name, None)
+            else:
+                os.environ[name] = value
+
+
+def test_validation_metrics_are_synchronized_and_capture_cuda_peaks():
+    begin = _module_function("_begin_validation_rollout_metrics")
+    finish = _module_function("_finish_validation_rollout_metrics")
+    assert len(_attribute_calls(begin, "wait_for_everyone")) == 1
+    assert len(_attribute_calls(begin, "synchronize")) == 1
+    assert len(_attribute_calls(begin, "reset_peak_memory_stats")) == 1
+    assert len(_attribute_calls(begin, "memory_allocated")) == 1
+    assert len(_attribute_calls(begin, "memory_reserved")) == 1
+    assert len(_attribute_calls(finish, "wait_for_everyone")) == 1
+    assert len(_attribute_calls(finish, "synchronize")) == 1
+    assert len(_attribute_calls(finish, "max_memory_allocated")) == 1
+    assert len(_attribute_calls(finish, "max_memory_reserved")) == 1
+
+
+def test_validation_json_is_fsynced_and_published_without_overwrite():
+    publish = _module_function("_atomic_publish_validation_json")
+    source = ast.unparse(publish)
+    assert "_immutable_validation_json_path(path)" in source
+    assert "os.link(temporary, path, follow_symlinks=False)" in source
+    assert "os.fchmod(handle.fileno(), 292)" in source
+    assert source.count("os.fsync") == 2
+    assert "os.replace" not in source
+
+
+def test_validation_json_publication_is_atomic_and_refuses_a_second_writer(
+    tmp_path, monkeypatch
+):
+    validate_path, publish = _load_module_functions(
+        "_immutable_validation_json_path",
+        "_atomic_publish_validation_json",
+    )
+    run_dir = tmp_path / "run"
+    evidence_dir = run_dir / "evidence"
+    evidence_dir.mkdir(parents=True)
+    destination = evidence_dir / "legacy.json"
+    monkeypatch.setenv("TRAIN_RUN_DIR", str(run_dir))
+
+    assert validate_path(destination) == destination
+    publish(destination, {"schema": "test", "value": 7})
+    assert json.loads(destination.read_text(encoding="utf-8")) == {
+        "schema": "test",
+        "value": 7,
+    }
+    assert stat.S_IMODE(destination.stat().st_mode) == 0o444
+    assert not tuple(evidence_dir.glob(f".{destination.name}.*"))
+    try:
+        publish(destination, {"value": 8})
+    except FileExistsError:
+        pass
+    else:
+        raise AssertionError("validation evidence publication replaced its target")
+
+
+def test_cpu_validation_metrics_are_synchronized_and_scalar_only():
+    import torch
+
+    begin, finish = _load_module_functions(
+        "_begin_validation_rollout_metrics",
+        "_finish_validation_rollout_metrics",
+        extra_globals={"torch": torch},
+    )
+
+    class Accelerator:
+        def __init__(self):
+            self.waits = 0
+
+        def wait_for_everyone(self):
+            self.waits += 1
+
+    accelerator = Accelerator()
+    device = torch.device("cpu")
+    state = begin(accelerator, device)
+    metrics = finish(accelerator, device, state)
+    assert accelerator.waits == 2
+    assert metrics["synchronized"] is True
+    assert metrics["wall_seconds"] >= 0.0
+    assert metrics["cuda"] == {
+        "enabled": False,
+        "device": "cpu",
+        "baseline_allocated_bytes": None,
+        "baseline_reserved_bytes": None,
+        "peak_allocated_bytes": None,
+        "peak_reserved_bytes": None,
+        "peak_delta_allocated_bytes": None,
+        "peak_delta_reserved_bytes": None,
+    }
