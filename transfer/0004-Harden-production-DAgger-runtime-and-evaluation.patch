+    """Content-address the exact float tensor consumed by the visual policy."""
+
+    if not isinstance(value, torch.Tensor):
+        raise RuntimeError("runtime validation vision_obs must be a torch tensor")
+    array = value.detach().contiguous().to("cpu").numpy()
+    digest = hashlib.sha256()
+    dtype = str(value.dtype)
+    encoded_dtype = dtype.encode("ascii")
+    digest.update(len(encoded_dtype).to_bytes(8, "big"))
+    digest.update(encoded_dtype)
+    digest.update(array.ndim.to_bytes(8, "big"))
+    for dimension in array.shape:
+        digest.update(int(dimension).to_bytes(8, "big"))
+    payload = array.tobytes(order="C")
+    digest.update(len(payload).to_bytes(8, "big"))
+    digest.update(payload)
+    return {
+        "dtype": dtype,
+        "sha256": digest.hexdigest(),
+        "shape": list(array.shape),
+        "step": int(step),
+    }
+
