+"""Focused adversarial tests for production gate parsing in the trainer."""
+
+from __future__ import annotations
+
+import ast
+import math
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+
+SOURCE = (
+    Path(__file__).resolve().parents[1]
+    / "gr00t/rl/trl/trainer/distill_trainer_videogen.py"
+)
+
+
+def _tree() -> ast.Module:
+    return ast.parse(SOURCE.read_text(encoding="utf-8"))
+
+
+def _module_functions(*names: str):
+    selected = [
+        node
+        for node in _tree().body
+        if isinstance(node, ast.FunctionDef) and node.name in names
+    ]
+    assert {node.name for node in selected} == set(names)
+    namespace = {"math": math, "np": np}
+    exec(
+        compile(
+            ast.Module(body=selected, type_ignores=[]),
+            str(SOURCE),
+            "exec",
+        ),
+        namespace,
+    )
+    return tuple(namespace[name] for name in names)
+
+
+def _trainer_method(name: str) -> ast.FunctionDef:
+    trainer = next(
+        node
+        for node in _tree().body
+        if isinstance(node, ast.ClassDef)
+        and node.name == "TRLDistillTrainerVideoGen"
+    )
+    return next(
+        node
+        for node in trainer.body
+        if isinstance(node, ast.FunctionDef) and node.name == name
+    )
+
+
+@pytest.mark.parametrize(
+    "value",
+    (
+        float("nan"),
+        float("inf"),
+        float("-inf"),
+        "nan",
+        "+inf",
+        "-Infinity",
+        True,
+        np.bool_(False),
+        None,
+        "not-a-number",
+    ),
+)
+def test_finite_gate_number_rejects_nonfinite_and_ambiguous_values(value):
+    (parse_number,) = _module_functions("_parse_finite_gate_number")
+
+    with pytest.raises(RuntimeError, match="must be a finite number"):
+        parse_number(value, "test value")
+
+
+@pytest.mark.parametrize("value", (0, 1, -0.25, "2.5", np.float32(0.5)))
+def test_finite_gate_number_accepts_finite_numeric_values(value):
+    (parse_number,) = _module_functions("_parse_finite_gate_number")
+
+    assert parse_number(value, "test value") == float(value)
+
+
+@pytest.mark.parametrize(
+    ("configured", "expected"),
+    (
+        (float("nan"), "0.0"),
+        (0.0, "nan"),
+        (float("inf"), "inf"),
+        (float("-inf"), "-inf"),
+    ),
+)
+def test_gate_match_never_treats_nonfinite_values_as_equal(configured, expected):
+    parse_number, require_match = _module_functions(
+        "_parse_finite_gate_number",
+        "_require_finite_gate_match",
+    )
+    assert parse_number is not None
+
+    with pytest.raises(RuntimeError, match="must be a finite number"):
+        require_match(configured, expected, "test value", 1e-12)
+
+
+def test_gate_match_preserves_tolerance_and_rejects_finite_mismatch():
+    _parse_number, require_match = _module_functions(
+        "_parse_finite_gate_number",
+        "_require_finite_gate_match",
+    )
+
+    assert require_match(0.5, "0.5000000001", "test value", 1e-9) == 0.5
+    with pytest.raises(RuntimeError, match="test value mismatch"):
+        require_match(0.5, "0.50001", "test value", 1e-9)
+
+
+@pytest.mark.parametrize("value", ("tru", "fales", "", "2", object()))
+def test_boolean_gate_rejects_noncanonical_values(value):
+    (parse_boolean,) = _module_functions("_parse_boolean_gate")
+
+    with pytest.raises(RuntimeError, match="must be a boolean value"):
+        parse_boolean(value, "TEST_BOOLEAN")
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    ((True, True), (False, False), ("true", True), ("false", False)),
+)
+def test_boolean_gate_accepts_explicit_boolean_values(value, expected):
+    (parse_boolean,) = _module_functions("_parse_boolean_gate")
+
+    assert parse_boolean(value, "TEST_BOOLEAN") is expected
+
+
+@pytest.mark.parametrize(
+    ("opt_homie", "threshold"),
+    ((False, 0.5), ("false", "0.5"), (0, np.float32(0.5))),
+)
+def test_production_homie_runtime_accepts_only_pinned_settings(
+    opt_homie, threshold
+):
+    (
+        _parse_boolean,
+        _parse_number,
+        _require_match,
+        require_runtime,
+    ) = _module_functions(
+        "_parse_boolean_gate",
+        "_parse_finite_gate_number",
+        "_require_finite_gate_match",
+        "_require_production_homie_runtime",
+    )
+
+    assert require_runtime(opt_homie, threshold) == 0.5
+
+
+@pytest.mark.parametrize("opt_homie", (None, True, "true", 1, "invalid"))
+def test_production_homie_runtime_rejects_enabled_missing_or_malformed_mode(
+    opt_homie,
+):
+    (
+        _parse_boolean,
+        _parse_number,
+        _require_match,
+        require_runtime,
+    ) = _module_functions(
+        "_parse_boolean_gate",
+        "_parse_finite_gate_number",
+        "_require_finite_gate_match",
+        "_require_production_homie_runtime",
+    )
+
+    with pytest.raises(RuntimeError, match="opt_homie"):
+        require_runtime(opt_homie, 0.5)
+
+
+@pytest.mark.parametrize(
+    "threshold",
+    (
+        None,
+        True,
+        float("nan"),
+        float("inf"),
+        float("-inf"),
+        "nan",
+        "not-a-number",
+        0.0,
+        0.499999999999,
+        0.500000000001,
+    ),
+)
+def test_production_homie_runtime_rejects_missing_nonfinite_or_inexact_threshold(
+    threshold,
+):
+    (
+        _parse_boolean,
+        _parse_number,
+        _require_match,
+        require_runtime,
+    ) = _module_functions(
+        "_parse_boolean_gate",
+        "_parse_finite_gate_number",
+        "_require_finite_gate_match",
+        "_require_production_homie_runtime",
+    )
+
+    with pytest.raises(RuntimeError, match="Homie switch threshold|explicitly 0.5"):
+        require_runtime(False, threshold)
+
+
+def test_production_and_round_actor_gates_use_strict_helpers():
+    init_source = ast.unparse(_trainer_method("_init_trl"))
+    train_source = ast.unparse(_trainer_method("train"))
+
+    assert init_source.count("_require_finite_gate_match(") == 5
+    assert "_gate_enforce.lower() == 'true'" not in init_source
+    assert "bool(self.config.get('enforce_teacher_rollout'" not in init_source
+    assert "_parse_boolean_gate(_gate_enforce" in init_source
+    assert "_parse_boolean_gate(self.config.get('enforce_teacher_rollout'" in (
+        init_source
+    )
+    assert "if _production_anchor_consumer:" in init_source
+    assert "_require_production_homie_runtime(" in init_source
+
+    assert train_source.count("_require_finite_gate_match(") == 2
+    assert "abs(self.vg_beta_start - self.vg_beta_end)" not in train_source
