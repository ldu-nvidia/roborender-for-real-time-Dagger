new file mode 100644
index 0000000000000000000000000000000000000000..f7a3dbd303cd9cd0a02a4b07e512bac987da74da
--- /dev/null
+++ b/tests/test_homie_trainer_lineage.py
@@ -0,0 +1,135 @@
+"""Static lineage contract for the legacy walk/stand Homie trainer."""
+
+from __future__ import annotations
+
+import ast
+import unittest
+from pathlib import Path
+
+
+SOURCE = (
+    Path(__file__).resolve().parents[1]
+    / "gr00t/rl/trl/trainer/ppo_trainer_homie_api.py"
+)
+
+
+def _trainer_method(name: str) -> ast.FunctionDef:
+    tree = ast.parse(SOURCE.read_text(encoding="utf-8"))
+    trainer = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.ClassDef) and node.name == "TRLPPOTrainer"
+    )
+    return next(
+        node
+        for node in trainer.body
+        if isinstance(node, ast.FunctionDef) and node.name == name
+    )
+
+
+def _call_name(call: ast.Call) -> str | None:
+    if isinstance(call.func, ast.Name):
+        return call.func.id
+    if isinstance(call.func, ast.Attribute):
+        return call.func.attr
+    return None
+
+
+class HomieTrainerLineageTest(unittest.TestCase):
+    def test_both_controller_files_are_loaded_and_hashed_as_one_byte_snapshot(self) -> None:
+        method = _trainer_method("_init_trl")
+        loader_calls = [
+            node
+            for node in ast.walk(method)
+            if isinstance(node, ast.Call)
+            and _call_name(node) == "load_homie_controller_checkpoint"
+        ]
+        self.assertEqual(len(loader_calls), 2)
+        self.assertEqual(
+            {
+                ast.unparse(call.args[1])
+                for call in loader_calls
+            },
+            {
+                "self.config.homie_walk_model_path",
+                "self.config.homie_stand_model_path",
+            },
+        )
+        for call in loader_calls:
+            self.assertEqual(ast.unparse(call.args[0]), "torch")
+            self.assertEqual(
+                ast.unparse(next(item.value for item in call.keywords if item.arg == "map_location")),
+                "self.device",
+            )
+
+        text = ast.unparse(method)
+        self.assertIn(
+            "self.homie_controller_sha256 = {'walk': homie_walk_sha256, 'stand': homie_stand_sha256}",
+            text,
+        )
+        self.assertIn(
+            "self.model.homie_controller_sha256 = dict(self.homie_controller_sha256)",
+            text,
+        )
+
+    def test_every_checkpoint_load_requires_and_checks_controller_lineage(self) -> None:
+        method = _trainer_method("load_checkpoint")
+        text = ast.unparse(method)
+        self.assertIn(
+            "validate_homie_controller_sha256(checkpoint.get('homie_controller_sha256'))",
+            text,
+        )
+        self.assertIn(
+            "checkpoint_controller_sha256 != self.homie_controller_sha256",
+            text,
+        )
+
+        validation = next(
+            node
+            for node in ast.walk(method)
+            if isinstance(node, ast.Call)
+            and _call_name(node) == "validate_homie_controller_sha256"
+        )
+        policy_load = next(
+            node
+            for node in ast.walk(method)
+            if isinstance(node, ast.Call)
+            and ast.unparse(node.func) == "model.policy.load_state_dict"
+        )
+        optimizer_load = next(
+            node
+            for node in ast.walk(method)
+            if isinstance(node, ast.Call)
+            and ast.unparse(node.func) == "self.optimizer.load_state_dict"
+        )
+        self.assertLess(validation.lineno, policy_load.lineno)
+        self.assertLess(policy_load.lineno, optimizer_load.lineno)
+
+    def test_trusted_runtime_gate_binds_policy_and_both_controllers(self) -> None:
+        method = _trainer_method("load_checkpoint")
+        text = ast.unparse(method)
+        self.assertIn("ROUND_DAGGER_RUNTIME_POLICY_SHA256", text)
+        self.assertIn("IMAGE_DAGGER_EXPECT_RUNTIME_POLICY_SHA256", text)
+        self.assertIn("runtime policy identity gates disagree", text)
+
+        runtime_call = next(
+            node
+            for node in ast.walk(method)
+            if isinstance(node, ast.Call) and _call_name(node) == "runtime_policy_sha256"
+        )
+        self.assertEqual(ast.unparse(runtime_call.args[0]), "model.policy")
+        keywords = {item.arg: ast.unparse(item.value) for item in runtime_call.keywords}
+        self.assertEqual(
+            keywords["homie_controller_sha256"], "self.homie_controller_sha256"
+        )
+        optimizer_load = next(
+            node
+            for node in ast.walk(method)
+            if isinstance(node, ast.Call)
+            and ast.unparse(node.func) == "self.optimizer.load_state_dict"
+        )
+        self.assertLess(runtime_call.lineno, optimizer_load.lineno)
+
+
+if __name__ == "__main__":
+    unittest.main()
