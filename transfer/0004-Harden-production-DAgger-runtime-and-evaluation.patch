+++ b/tests/test_homie_controller_identity.py
@@ -0,0 +1,111 @@
+import hashlib
+import os
+from pathlib import Path
+from unittest import mock
+
+import pytest
+
+from gr00t.rl.utils import homie_controller_identity
+from gr00t.rl.utils.homie_controller_identity import (
+    load_homie_controller_checkpoint,
+    validate_homie_controller_sha256,
+)
+
+
+class _RecordingTorch:
+    def __init__(self):
+        self.loaded_payload = None
+        self.kwargs = None
+
+    def load(self, buffer, **kwargs):
+        self.loaded_payload = buffer.read()
+        self.kwargs = kwargs
+        return {"payload": self.loaded_payload}
+
+
+def test_loader_hashes_and_deserializes_the_same_descriptor_bytes(tmp_path):
+    payload = b"fixed-controller-checkpoint"
+    checkpoint = tmp_path / "controller.pt"
+    checkpoint.write_bytes(payload)
+    torch_module = _RecordingTorch()
+
+    document, digest = load_homie_controller_checkpoint(
+        torch_module, checkpoint, map_location="cpu"
+    )
+
+    assert document == {"payload": payload}
+    assert torch_module.loaded_payload == payload
+    assert torch_module.kwargs == {
+        "map_location": "cpu",
+        "weights_only": False,
+    }
+    assert digest == hashlib.sha256(payload).hexdigest()
+
+
+def test_loader_rejects_a_final_component_symlink(tmp_path):
+    target = tmp_path / "target.pt"
+    target.write_bytes(b"controller")
+    link = tmp_path / "controller.pt"
+    link.symlink_to(target)
+
+    with pytest.raises(RuntimeError, match="non-symlink"):
+        load_homie_controller_checkpoint(
+            _RecordingTorch(), link, map_location="cpu"
+        )
+
+
+def test_pathname_swap_after_open_cannot_change_loaded_bytes(tmp_path):
+    original_payload = b"controller-selected-by-open"
+    replacement_payload = b"controller-swapped-into-path"
+    checkpoint = tmp_path / "controller.pt"
+    replacement = tmp_path / "replacement.pt"
+    checkpoint.write_bytes(original_payload)
+    replacement.write_bytes(replacement_payload)
+    real_open = os.open
+
+    def open_then_swap(path, flags):
+        descriptor = real_open(path, flags)
+        os.replace(replacement, checkpoint)
+        return descriptor
+
+    torch_module = _RecordingTorch()
+    with mock.patch.object(
+        homie_controller_identity.os, "open", side_effect=open_then_swap
+    ):
+        _, digest = load_homie_controller_checkpoint(
+            torch_module, checkpoint, map_location="cpu"
+        )
+
+    assert checkpoint.read_bytes() == replacement_payload
+    assert torch_module.loaded_payload == original_payload
+    assert digest == hashlib.sha256(original_payload).hexdigest()
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        None,
+        {"walk": "1" * 64},
+        {"walk": "1" * 64, "stand": "2" * 64, "extra": "3" * 64},
+        {"walk": "A" * 64, "stand": "2" * 64},
+    ],
+)
+def test_controller_mapping_is_exact_and_canonical(value):
+    with pytest.raises(RuntimeError):
+        validate_homie_controller_sha256(value)
+
+
+def test_checkpoint_producers_and_consumers_bind_controller_mapping():
+    root = Path(__file__).resolve().parents[1]
+    callback = (
+        root / "gr00t/rl/trl/callbacks/model_save_callback.py"
+    ).read_text(encoding="utf-8")
+    homie_trainer = (
+        root / "gr00t/rl/trl/trainer/distill_trainer_obj_pred_homie_api.py"
+    ).read_text(encoding="utf-8")
+
+    assert 'checkpoint["homie_controller_sha256"]' in callback
+    assert "validate_homie_controller_sha256(" in callback
+    assert "checkpoint.get(\"homie_controller_sha256\")" in homie_trainer
+    assert "checkpoint Homie controllers differ" in homie_trainer
+    assert "_complete_runtime_policy_sha256" in homie_trainer
