+        # Deserialization must never consume the mutable filesystem object.
+        # The complete, race-checked byte snapshot is the only pickle input.
+        snapshot.seek(0)
+        payload = torch_module.load(
+            snapshot, map_location=map_location, weights_only=weights_only
+        )
+    finally:
+        if descriptor >= 0:
+            os.close(descriptor)
+    return payload, actual_sha256
