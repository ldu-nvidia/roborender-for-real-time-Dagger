+"""Tests for content-bound, immutable Image3F anchor consumption."""
+
+from __future__ import annotations
+
+import hashlib
+import tempfile
+import unittest
+from pathlib import Path
+
+import numpy as np
+
+from gr00t.rl.trl.trainer.anchor_io import (
+    AnchorIOError,
+    deterministic_anchor_index,
+    inventory_sha256,
+    load_verified_npz,
+    verify_anchor_pool,
+)
+
+
+class _Archive:
+    def __init__(self, value: bytes) -> None:
+        self.value = value
+
+    def __enter__(self):
+        return self.value
+
+    def __exit__(self, *_args):
+        return False
+
+
+class _MutatingNumpy:
+    def __init__(self, source: Path, replacement: bytes) -> None:
+        self.source = source
+        self.replacement = replacement
+        self.calls = 0
+        self.consumed = b""
+        self.allow_pickle = None
+
+    def load(self, stream, *, allow_pickle):
+        self.calls += 1
+        self.allow_pickle = allow_pickle
+        self.source.write_bytes(self.replacement)
+        self.consumed = stream.read()
+        return _Archive(self.consumed)
+
+
+class AnchorIOTest(unittest.TestCase):
+    def test_production_anchor_assignment_is_unique_and_stateless(self) -> None:
+        assignments = [
+            deterministic_anchor_index(
+                pool_size=2048,
+                seed=42,
+                macro_round=0,
+                episode_id=0,
+                global_env_id=global_env_id,
+                global_environment_count=256,
+            )
+            for global_env_id in range(256)
+        ]
+        self.assertEqual(len(set(assignments)), 256)
+        self.assertEqual(
+            assignments,
+            [
+                deterministic_anchor_index(
+                    pool_size=2048,
+                    seed=42,
+                    macro_round=0,
+                    episode_id=0,
+                    global_env_id=global_env_id,
+                    global_environment_count=256,
+                )
+                for global_env_id in range(256)
+            ],
+        )
+        next_episode = [
+            deterministic_anchor_index(
+                pool_size=2048,
+                seed=42,
+                macro_round=0,
+                episode_id=1,
+                global_env_id=global_env_id,
+                global_environment_count=256,
+            )
+            for global_env_id in range(256)
+        ]
+        self.assertEqual(len(set(next_episode)), 256)
+        self.assertNotEqual(assignments, next_episode)
+
+    def test_anchor_assignment_rejects_undersized_pool_and_bad_identity(self) -> None:
+        arguments = {
+            "pool_size": 255,
+            "seed": 42,
+            "macro_round": 0,
+            "episode_id": 0,
+            "global_env_id": 0,
+            "global_environment_count": 256,
+        }
+        with self.assertRaisesRegex(AnchorIOError, "at least one entry"):
+            deterministic_anchor_index(**arguments)
+        arguments.update(pool_size=2048, global_env_id=256)
+        with self.assertRaisesRegex(AnchorIOError, "outside"):
+            deterministic_anchor_index(**arguments)
+
+    def _pool(self, root: Path) -> str:
+        np.savez(
+            root / "anchor_00001.npz",
+            frames=np.array([0], dtype=np.int64),
+            prompt=np.array("one"),
+            gen__head_color=np.zeros((1, 2, 2, 3), dtype=np.uint8),
+        )
+        np.savez(
+            root / "anchor_00002.npz",
+            frames=np.array([0], dtype=np.int64),
+            prompt=np.array("two"),
+            gen__head_color=np.ones((1, 2, 2, 3), dtype=np.uint8),
+        )
+        records = []
+        from gr00t.rl.trl.trainer.anchor_io import AnchorRecord
+
+        for path in sorted(root.glob("*.npz")):
+            records.append(
+                AnchorRecord(
+                    path,
+                    path.name,
+                    path.stat().st_size,
+                    hashlib.sha256(path.read_bytes()).hexdigest(),
+                )
+            )
+        return inventory_sha256(records)
+
+    def test_pool_inventory_and_pickle_free_npz_load_pass(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            expected = self._pool(root)
+            paths, digests, actual = verify_anchor_pool(
+                root, expected_count=2, expected_inventory_sha256=expected
+            )
+            self.assertEqual(actual, expected)
+            self.assertEqual([path.name for path in paths], ["anchor_00001.npz", "anchor_00002.npz"])
+            with load_verified_npz(
+                np, paths[0], expected_sha256=digests[str(paths[0])]
+            ) as archive:
+                self.assertEqual(str(archive["prompt"]), "one")
+
+    def test_changed_anchor_is_rejected_before_numpy_load(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            expected = self._pool(root)
+            paths, digests, _ = verify_anchor_pool(
+                root, expected_count=2, expected_inventory_sha256=expected
+            )
+            selected = paths[0]
+            selected.write_bytes(b"malicious replacement")
+            fake = _MutatingNumpy(selected, b"never reached")
+            with self.assertRaisesRegex(AnchorIOError, "selected anchor SHA-256 mismatch"):
+                with load_verified_npz(
+                    fake, selected, expected_sha256=digests[str(selected)]
+                ):
+                    pass
+            self.assertEqual(fake.calls, 0)
+
+    def test_in_place_mutation_at_numpy_load_cannot_change_snapshot(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary:
+            source = Path(temporary) / "anchor.npz"
+            benign = b"BENIGN_ANCHOR_BYTES"
+            source.write_bytes(benign)
+            fake = _MutatingNumpy(source, b"MALICIOUS_ANCHOR_BYTES")
+            with load_verified_npz(
+                fake,
+                source,
+                expected_sha256=hashlib.sha256(benign).hexdigest(),
+            ) as value:
+                self.assertEqual(value, benign)
+            self.assertEqual(fake.consumed, benign)
+            self.assertFalse(fake.allow_pickle)
+
+
+if __name__ == "__main__":
+    unittest.main()
