index 0000000000000000000000000000000000000000..592aef45e105282e08df404514ab9fbe4b6285c6
--- /dev/null
+++ b/tests/test_image3f_retry_accounting.py
@@ -0,0 +1,95 @@
+"""Retry/error accounting gates for paired Image3F evaluation evidence."""
+
+from __future__ import annotations
+
+import pytest
+
+from gr00t.rl.utils import image3f_frame_client as client_module
+from gr00t.rl.utils.image3f_frame_client import (
+    Image3FFrameClient,
+    image3f_request_accounting_snapshot,
+)
+from gr00t.rl.utils.round_dagger_paired_eval import (
+    PairedEvaluationEvidence,
+    PairedEvaluationEvidenceError,
+)
+
+
+def _request_with_responses(monkeypatch, *responses):
+    pending = iter(responses)
+    client = Image3FFrameClient("127.0.0.1", 1)
+    monkeypatch.setattr(client, "_connect", lambda: object())
+    monkeypatch.setattr(client_module, "_send_msg", lambda _sock, _payload: None)
+
+    def receive(_sock):
+        response = next(pending)
+        if isinstance(response, BaseException):
+            raise response
+        return response
+
+    monkeypatch.setattr(client_module, "_recv_msg", receive)
+    monkeypatch.setattr(client_module.time, "sleep", lambda _seconds: None)
+    return client._request(
+        {"cmd": "render_frame", "reference_lag": 0}, retries=len(responses) - 1
+    )
+
+
+def _evidence():
+    return PairedEvaluationEvidence(
+        num_envs=1,
+        generation_seed=7,
+        scenario_ids_by_env={0: "a" * 64},
+        runtime_policy_sha256="b" * 64,
+        evaluation_config_sha256="c" * 64,
+        evaluator_code_sha256="d" * 64,
+    )
+
+
+def test_retryable_response_increments_error_accounting(monkeypatch):
+    before = image3f_request_accounting_snapshot()
+
+    response = _request_with_responses(
+        monkeypatch,
+        {"ok": False, "retryable": True, "error": "in flight"},
+        {"ok": True},
+    )
+
+    after = image3f_request_accounting_snapshot()
+    assert response["ok"] is True
+    assert after["errors"] - before["errors"] == 1
+    assert after["replays"] - before["replays"] == 0
+
+
+def test_transport_retry_increments_error_accounting(monkeypatch):
+    before = image3f_request_accounting_snapshot()
+
+    response = _request_with_responses(
+        monkeypatch,
+        ConnectionError("lost response"),
+        {"ok": True},
+    )
+
+    after = image3f_request_accounting_snapshot()
+    assert response["ok"] is True
+    assert after["errors"] - before["errors"] == 1
+    assert after["replays"] - before["replays"] == 0
+
+
+def test_paired_evidence_rejects_success_after_retryable_error(monkeypatch):
+    evidence = _evidence()
+    _request_with_responses(
+        monkeypatch,
+        {"ok": False, "retryable": True, "error": "in flight"},
+        {"ok": True},
+    )
+
+    with pytest.raises(PairedEvaluationEvidenceError, match="errors or replays"):
+        evidence.finalize()
+
+
+def test_paired_evidence_rejects_idempotent_replay(monkeypatch):
+    evidence = _evidence()
+    _request_with_responses(monkeypatch, {"ok": True, "replayed": True})
+
+    with pytest.raises(PairedEvaluationEvidenceError, match="errors or replays"):
+        evidence.finalize()
