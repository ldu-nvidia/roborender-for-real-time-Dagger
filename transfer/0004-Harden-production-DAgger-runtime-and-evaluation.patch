new file mode 100644
index 0000000000000000000000000000000000000000..5b7a6e4df29ca082166b90aa51d512299c6f6ba8
--- /dev/null
+++ b/gr00t/rl/utils/camera_rendering_contract.py
@@ -0,0 +1,122 @@
+"""Fail-closed rendering settings for headless Isaac camera workloads.
+
+Isaac Lab applies its rendering-mode preset after the experience file is
+loaded.  Headless camera runs therefore provide NRD-disable settings as early
+Kit command-line arguments, select the performance preset, and verify the
+resolved Carb settings after SimulationContext construction.
+"""
+
+from __future__ import annotations
+
+HEADLESS_CAMERA_RENDERING_MODE = "performance"
+
+ACTIVE_REQUIRED_DISABLED_CARB_SETTINGS = (
+    "/rtx/directLighting/sampledLighting/enabled",
+    "/rtx/directLighting/sampledLighting/autoEnable",
+    "/rtx/directLighting/sampledLighting/enforceDenoiser",
+    "/rtx/directLighting/sampledLighting/irradiance/denoiser/enabled",
+    "/rtx/reflections/denoiser/enabled",
+    "/rtx/indirectDiffuse/denoiser/enabled",
+    "/rtx/indirectDiffuse/nrd/enabled",
+    "/rtx/shadows/denoiser/enable",
+    "/rtx-transient/dldenoiser/enabled",
+)
+
+
+def _rtx_default_mirrors(paths: tuple[str, ...]) -> tuple[str, ...]:
+    mirrors = []
+    for path in paths:
+        if path.startswith("/rtx/"):
+            mirrors.append(f"/rtx-defaults/{path.removeprefix('/rtx/')}")
+        elif path.startswith("/rtx-transient/"):
+            mirrors.append(
+                f"/rtx-defaults-transient/{path.removeprefix('/rtx-transient/')}"
+            )
+    return tuple(mirrors)
+
+
+# USD stage initialization reapplies the /rtx-defaults namespace after Kit
+# startup.  Pin and validate both namespaces so those defaults cannot restore
+# NRD after the active /rtx paths were disabled.
+DEFAULT_REQUIRED_DISABLED_CARB_SETTINGS = _rtx_default_mirrors(
+    ACTIVE_REQUIRED_DISABLED_CARB_SETTINGS
+)
+REQUIRED_DISABLED_CARB_SETTINGS = (
+    ACTIVE_REQUIRED_DISABLED_CARB_SETTINGS
+    + DEFAULT_REQUIRED_DISABLED_CARB_SETTINGS
+)
+
+# These broader renderer paths are already disabled in the camera experience,
+# but enforcing them on Kit's command line prevents extension startup from
+# transiently constructing an NRD pipeline before the experience is resolved.
+ACTIVE_EARLY_DISABLED_CARB_SETTINGS = ACTIVE_REQUIRED_DISABLED_CARB_SETTINGS + (
+    "/rtx/reflections/enabled",
+    "/rtx/indirectDiffuse/enabled",
+    "/rtx/ambientOcclusion/enabled",
+    "/rtx/translucency/enabled",
+    "/rtx/raytracing/cached/enabled",
+    "/rtx-transient/dlssg/enabled",
+)
+EARLY_DISABLED_CARB_SETTINGS = (
+    ACTIVE_EARLY_DISABLED_CARB_SETTINGS
+    + _rtx_default_mirrors(ACTIVE_EARLY_DISABLED_CARB_SETTINGS)
+)
+
+
+def configure_headless_camera_rendering(args_cli) -> bool:
+    """Enforce NRD-free Kit startup and the matching Isaac render preset."""
+
+    enabled = bool(args_cli.enable_cameras) and bool(args_cli.headless)
+    if enabled:
+        args_cli.rendering_mode = HEADLESS_CAMERA_RENDERING_MODE
+        enforced_prefixes = tuple(f"--{path}=" for path in EARLY_DISABLED_CARB_SETTINGS)
+        existing = str(getattr(args_cli, "kit_args", "") or "").split()
+        preserved = [token for token in existing if not token.startswith(enforced_prefixes)]
+        enforced = [f"--{path}=false" for path in EARLY_DISABLED_CARB_SETTINGS]
+        args_cli.kit_args = " ".join((*preserved, *enforced))
+    return enabled
+
+
+def headless_camera_render_cfg_kwargs() -> dict[str, object]:
+    """Build the late-binding RenderCfg overrides used by SimulationContext."""
+
+    return {
+        "rendering_mode": HEADLESS_CAMERA_RENDERING_MODE,
+        # Keep the non-sampled direct-lighting path available for nonblack RGB.
+        "enable_direct_lighting": True,
+        "carb_settings": {
+            path: False for path in REQUIRED_DISABLED_CARB_SETTINGS
+        },
+    }
+
+
+def validate_headless_camera_rendering(settings) -> dict[str, object]:
+    """Validate resolved post-launch Carb settings or fail before training."""
+
+    resolved = {path: settings.get(path) for path in REQUIRED_DISABLED_CARB_SETTINGS}
+    invalid = {
+        path: value
+        for path, value in resolved.items()
+        if value is None or value not in (False, 0)
+    }
+    if invalid:
+        details = ", ".join(f"{path}={value!r}" for path, value in invalid.items())
+        raise RuntimeError(
+            "Unsafe headless camera rendering configuration: NRD-dependent "
+            f"paths are not disabled ({details})"
+        )
+    return resolved
+
+
+def reassert_headless_camera_rendering(settings) -> dict[str, object]:
+    """Reapply the required disables after environment construction.
+
+    Isaac scene and camera initialization can reapply RTX defaults after the
+    SimulationContext has been created.  Write every required active/default
+    setting again at that lifecycle boundary, then fail closed if any write did
+    not stick.
+    """
+
+    for path in REQUIRED_DISABLED_CARB_SETTINGS:
+        settings.set_bool(path, False)
+    return validate_headless_camera_rendering(settings)
