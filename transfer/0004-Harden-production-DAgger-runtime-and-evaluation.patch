+import stat
+import tempfile
+import unittest
+from pathlib import Path
+
+import numpy as np
+
+from gr00t.rl.utils.dagger_telemetry import DaggerTelemetry, _atomic_write
+
+
+class DaggerTelemetryPermissionsTest(unittest.TestCase):
+    def test_atomic_artifact_is_read_only_for_cross_user_handoff(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "artifact.json"
+            _atomic_write(path, b"{}\n")
+            self.assertEqual(stat.S_IMODE(path.stat().st_mode), 0o444)
+            self.assertEqual(path.read_bytes(), b"{}\n")
+
+    def test_video_fallback_and_manifest_are_cross_user_readable(self):
+        with tempfile.TemporaryDirectory() as directory:
+            telemetry = DaggerTelemetry(
+                directory,
+                scalar_every=1,
+                image_every=1,
+                clip_every=1,
+                clip_frames=2,
+                ffmpeg_path="",
+            )
+            telemetry._frames.extend(
+                [
+                    np.zeros((4, 6, 3), dtype=np.uint8),
+                    np.ones((4, 6, 3), dtype=np.uint8),
+                ]
+            )
+            fallback = telemetry._write_video_or_fallback(1)
+            self.assertEqual(stat.S_IMODE(fallback.stat().st_mode), 0o444)
+            self.assertEqual(
+                stat.S_IMODE(fallback.with_suffix(".json").stat().st_mode),
+                0o444,
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
