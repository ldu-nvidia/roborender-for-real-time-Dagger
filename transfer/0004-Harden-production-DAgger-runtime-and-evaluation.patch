+def _enforce_policy_view_contract(
+    actual_views,
+    configured_count,
+    actual_layout,
+    actual_shape,
+    *,
+    expected_views=None,
+    expected_count=None,
+    expected_layout=None,
+    expected_shape=None,
+):
+    """Fail closed when an enabled production three-view contract differs.
+
+    Keeping this gate opt-in preserves historical/smoke configurations.  The
+    production launcher enables every field, making view order, config count,
+    tiling layout, and the tensor consumed by the policy one atomic contract.
+    """
+    if expected_views is not None:
+        expected = _parse_contract_csv(expected_views, "policy views")
+        actual = tuple(str(view) for view in actual_views)
+        if actual != expected:
+            raise RuntimeError(
+                "production gate failed: policy views mismatch "
+                f"(expected {expected}, got {actual})"
+            )
+
+    if expected_count is not None:
+        parsed = _parse_contract_csv(expected_count, "policy view count", int)
+        if len(parsed) != 1 or parsed[0] <= 0:
+            raise RuntimeError(
+                f"production gate failed: invalid policy view count: {expected_count!r}"
+            )
+        expected = parsed[0]
+        try:
+            actual = int(configured_count)
+        except (TypeError, ValueError) as exc:
+            raise RuntimeError(
+                "production gate failed: policy view count is missing or invalid"
+            ) from exc
+        if actual != expected or len(tuple(actual_views)) != expected:
+            raise RuntimeError(
+                "production gate failed: policy view count mismatch "
+                f"(expected {expected}, configured {actual}, views {len(tuple(actual_views))})"
+            )
+
+    if expected_layout is not None:
+        expected = str(expected_layout).strip()
+        if not expected:
+            raise RuntimeError("production gate failed: invalid policy view layout")
+        actual = None if actual_layout is None else str(actual_layout).strip()
+        if actual != expected:
+            raise RuntimeError(
+                "production gate failed: policy view layout mismatch "
+                f"(expected {expected!r}, got {actual!r})"
+            )
+
+    if expected_shape is not None:
+        expected = _parse_contract_csv(expected_shape, "policy image shape", int)
+        if len(expected) != 3 or any(dim <= 0 for dim in expected):
+            raise RuntimeError(
+                f"production gate failed: invalid policy image shape: {expected_shape!r}"
+            )
+        actual = None if actual_shape is None else tuple(int(dim) for dim in actual_shape)
+        if actual != expected:
+            raise RuntimeError(
+                "production gate failed: policy image shape mismatch "
+                f"(expected {expected}, got {actual})"
+            )
+
+
+def _sha256_named_parameters(named_parameters):
+    """Return a bit-exact, ordering-stable SHA-256 for model parameters."""
+    digest = hashlib.sha256()
+    count = 0
+    for name, parameter in sorted(named_parameters, key=lambda item: item[0]):
+        tensor = parameter.detach().contiguous().to(device="cpu")
+        metadata = json.dumps(
+            {
+                "name": str(name),
+                "dtype": str(tensor.dtype),
+                "shape": list(tensor.shape),
+            },
+            sort_keys=True,
+            separators=(",", ":"),
+        ).encode("utf-8")
+        payload = tensor.reshape(-1).view(torch.uint8).numpy().tobytes(order="C")
+        digest.update(len(metadata).to_bytes(8, "big"))
+        digest.update(metadata)
+        digest.update(len(payload).to_bytes(8, "big"))
+        digest.update(payload)
+        count += 1
+    if count == 0:
+        raise RuntimeError("DDP sync verification found no policy parameters")
+    return digest.hexdigest(), count
+
+
+def _decode_rank_digests(gathered_values, world_size, digest_size=32):
+    """Decode gathered SHA-256 bytes and reject any cross-rank mismatch."""
+    payload = bytes(int(value) for value in gathered_values)
+    expected_bytes = int(world_size) * int(digest_size)
+    if len(payload) != expected_bytes:
+        raise RuntimeError(
+            "DDP sync verification gathered an invalid digest payload: "
+            f"expected {expected_bytes} bytes, got {len(payload)}"
+        )
+    rank_digests = tuple(
+        payload[offset : offset + digest_size].hex()
+        for offset in range(0, len(payload), digest_size)
+    )
+    if len(set(rank_digests)) != 1:
+        prefixes = [value[:12] for value in rank_digests]
+        raise RuntimeError(
+            "DDP sync verification failed: policy parameters differ across "
+            f"ranks (SHA-256 prefixes={prefixes})"
+        )
+    return rank_digests
+
+
+def _parse_dump_bounds(max_steps_raw=None, max_envs_raw=None):
+    """Parse bounded diagnostic output limits; ``None`` envs means all."""
+    try:
+        max_steps = 15 if max_steps_raw is None else int(max_steps_raw)
+        max_envs = None if max_envs_raw is None else int(max_envs_raw)
+    except (TypeError, ValueError) as exc:
+        raise RuntimeError(
+            "IMAGE_DAGGER_DUMP_MAX_STEPS and IMAGE_DAGGER_DUMP_MAX_ENVS "
+            "must be non-negative integers"
+        ) from exc
+    if max_steps < 0 or (max_envs is not None and max_envs < 0):
+        raise RuntimeError(
+            "IMAGE_DAGGER_DUMP_MAX_STEPS and IMAGE_DAGGER_DUMP_MAX_ENVS "
+            "must be non-negative integers"
+        )
+    return max_steps, max_envs
+
+
+def _parse_boolean_gate(raw, name):
+    """Parse an opt-in boolean environment gate without truthy ambiguity."""
+    if raw is None:
+        return False
+    normalized = str(raw).strip().lower()
+    if normalized in {"1", "true", "yes"}:
+        return True
+    if normalized in {"0", "false", "no"}:
+        return False
+    raise RuntimeError(f"{name} must be a boolean value")
+
+
+def _parse_finite_gate_number(raw, name):
+    """Parse one production-gate number and reject ambiguous/non-finite input."""
+    if isinstance(raw, (bool, np.bool_)):
+        raise RuntimeError(
+            f"production gate failed: {name} must be a finite number"
+        )
+    try:
+        value = float(raw)
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise RuntimeError(
+            f"production gate failed: {name} must be a finite number"
+        ) from exc
+    if not math.isfinite(value):
+        raise RuntimeError(
+            f"production gate failed: {name} must be a finite number"
+        )
+    return value
+
+
+def _require_finite_gate_match(configured, expected, name, tolerance):
+    """Fail unless two finite production values match within a fixed tolerance."""
+    configured_value = _parse_finite_gate_number(
+        configured, f"configured {name}"
+    )
+    expected_value = _parse_finite_gate_number(expected, f"expected {name}")
+    tolerance_value = _parse_finite_gate_number(
+        tolerance, f"{name} comparison tolerance"
+    )
+    if tolerance_value < 0.0:
+        raise RuntimeError(
+            f"production gate failed: {name} comparison tolerance must be "
+            "non-negative"
+        )
+    if abs(configured_value - expected_value) > tolerance_value:
+        raise RuntimeError(f"production gate failed: {name} mismatch")
+    return configured_value
+
+
+def _require_production_homie_runtime(opt_homie, homie_switch_threshold):
+    """Pin Homie execution settings that are outside policy byte identity."""
+    if opt_homie is None:
+        raise RuntimeError(
+            "production gate failed: algo.config.opt_homie must be explicitly false"
+        )
+    if _parse_boolean_gate(opt_homie, "algo.config.opt_homie"):
+        raise RuntimeError(
+            "production gate failed: algo.config.opt_homie must be false"
+        )
+    if homie_switch_threshold is None:
+        raise RuntimeError(
+            "production gate failed: algo.config.homie_switch_threshold "
+            "must be explicitly 0.5"
+        )
+    return _require_finite_gate_match(
+        homie_switch_threshold,
+        0.5,
+        "Homie switch threshold",
+        0.0,
+    )
+
+
+def _install_relabelled_vision_obs(obs_dict, relabelled_obs_dict):
+    """Install the policy image in-place so rollout storage sees it too.
+
+    The parent rollout loop stores the original ``obs_dict`` object after
+    ``policy_step`` returns.  Merely rebinding the local variable in
+    ``policy_step`` lets the student act on generated RGB while silently
+    storing the simulator RGB for training.  Updating the shared dictionary
+    closes that action/replay mismatch.
+    """
+
+    if "vision_obs" not in obs_dict:
+        raise RuntimeError("image DAgger observation has no vision_obs")
+    if "vision_obs" not in relabelled_obs_dict:
+        raise RuntimeError("image DAgger relabel result has no vision_obs")
+    generated = relabelled_obs_dict["vision_obs"]
+    if tuple(generated.shape) != tuple(obs_dict["vision_obs"].shape):
+        raise RuntimeError(
+            "image DAgger relabel changed the policy observation shape: "
+            f"{tuple(obs_dict['vision_obs'].shape)} -> {tuple(generated.shape)}"
+        )
+    obs_dict["vision_obs"] = generated
+    return obs_dict
+
+
+def _finite_nonnegative_loss_mean(values):
+    """Validate every gathered loss value before returning their mean."""
+    losses = tuple(float(value) for value in values)
+    if not losses:
+        raise RuntimeError("DAgger BC loss verification gathered no loss values")
+    if not all(math.isfinite(value) for value in losses):
+        raise RuntimeError(
+            "DAgger BC loss verification failed: non-finite loss detected"
+        )
+    if any(value < 0.0 for value in losses):
+        raise RuntimeError(
+            "DAgger BC loss verification failed: negative loss detected"
+        )
+    return math.fsum(losses) / len(losses)
+
