+                expected_rung_contract_sha256,
+                environment,
+            )
+        )
+        return {"status": "authorized"}
+
+    monkeypatch.setattr(
+        runtime_scale,
+        "authorize_runtime_scale_process",
+        authorize_runtime_scale_process,
+    )
+    assert requested(scale_complete) is True
+    assert scale_authorization_calls == [
+        (
+            "/tmp/scale-plan.json",
+            "c" * 64,
+            "d" * 64,
+            scale_complete,
+        )
+    ]
+
+    for invalid in (
+        {
+            **scale_complete,
+            "ROUND_DAGGER_RUNTIME_SCALE_EVIDENCE": "",
+        },
+        {
+            **scale_complete,
+            "ROUND_DAGGER_RUNTIME_AB_PLAN": "/tmp/plan.json",
+        },
+        {
+            **scale_complete,
+            "ROUND_DAGGER_RUNTIME_AB_EVIDENCE": "/tmp/ab-evidence.json",
+        },
+        {
+            **complete,
+            "ROUND_DAGGER_RUNTIME_SCALE_PLAN": "/tmp/scale-plan.json",
+        },
+    ):
+        try:
+            requested(invalid)
+        except RuntimeError as exc:
+            assert "not bound to one complete recognized validation plan" in str(exc)
+        else:
+            raise AssertionError("partial or mixed validation namespace was accepted")
+
+    run_training = _train_function("_run_training")
+    source = ast.unparse(run_training)
+    assert "runtime_ab_deterministic_cuda_requested()" not in source
+    assert "torch_deterministic=_PREHYDRA_TORCH_DETERMINISTIC" in source
+    assert "authorization must run before Hydra creates outputs" in source
+    main_fn = _train_function("main")
+    main_source = ast.unparse(main_fn)
+    authorization = (
+        "_PREHYDRA_TORCH_DETERMINISTIC = "
+        "runtime_ab_deterministic_cuda_requested()"
+    )
+    assert authorization in main_source
+    assert main_source.index(authorization) < main_source.index("return _hydra_main()")
+    seeding_fn = _train_function("seeding")
+    seeding_source = ast.unparse(seeding_fn)
+    for setting in (
+        "torch.backends.cudnn.benchmark = False",
