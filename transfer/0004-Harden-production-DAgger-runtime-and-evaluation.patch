diff --git a/gr00t/rl/config/exp/loco_manip/wsdpt_round_actor_3view.yaml b/gr00t/rl/config/exp/loco_manip/wsdpt_round_actor_3view.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..427e119ea5cd9f17d89ea7bb14d0892d751b2b53
--- /dev/null
+++ b/gr00t/rl/config/exp/loco_manip/wsdpt_round_actor_3view.yaml
@@ -0,0 +1,97 @@
+# @package _global_
+# Frozen three-view actor for one round-based DAgger collection cohort.
+#
+# This configuration deliberately performs no learner update.  One invocation
+# collects 300 transitions for each local environment, publishes immutable
+# rank-local shards, proves the actor parameter digest did not change, and
+# exits.  ROUND_DAGGER_* environment variables bind it to a macro-round.
+
+defaults:
+  - loco_manip/wsdpt_student_for_teacher_v8q8.002_resnet_rgb_delay
+  - _self_
+
+exp_var: round_dagger_actor_3view
+
+trainer:
+  _target_: gr00t.rl.trl.trainer.distill_trainer_videogen.TRLDistillTrainerVideoGen
+
+# Two local ranks x 32 environments = one 64-environment cohort.
+num_envs: 32
+
+simulator:
+  config:
+    cameras:
+      enable_cameras: true
+      camera_types:
+        - rgb: true
+        - depth: true
+      camera_resolutions: [108, 192]
+      stack_depth_image: false
+      depth_hi_resolution: [480, 832]
+      depth_hi_robot_rgb: true
+      policy_views: [head_color, hand_left, hand_right]
+      policy_view_layout: vertical
+      add_scene_walls: true
+      wall_distance: 2.5
+      wall_height: 2.5
+      conditioning_views:
+        - {name: hand_left, link: left_wrist_yaw_link, pos: [-0.08, 0.0, -0.06], rot: [1.0, 0.0, 0.0, 0.0]}
+        - {name: hand_right, link: right_wrist_yaw_link, pos: [-0.08, 0.0, -0.06], rot: [1.0, 0.0, 0.0, 0.0]}
+        - {name: head_color, link: d435_link, pos: [0.0, 0.035, 0.0], rot: [0.99955, 0.0, 0.0299955, 0.0]}
+
+env:
+  config:
+    image_dagger_policy_view_count: ${policy_view_count}
+
+algo:
+  config:
+    num_mini_batches: 1
+    num_learning_epochs: 0
+    value_loss_coef: 0.0
+    entropy_coef: 0.0
+    num_steps_per_env: 300
+    rollout_with_teacher_num_steps: 0
+    enforce_teacher_rollout: false
+
+    videogen:
+      enable: true
+      mode: round_actor
+      image3f_endpoint_files: []
+      anchor_pool_dir: null
+      anchor_index: 0
+      # Generated observations are the learner input.  Keep zero for the
+      # production dataset; nonzero remains an explicit ablation only.
+      raytraced_mix_prob: 0.0
+      save_raw_depth: false
+      save_raw_depth_native: false
+      prompt: "This video shows in the background, a bright minimalist room with light gray walls and a light wooden floor. In the foreground, on the white table, there is a plastic bottle and a shallow gray tray. The robot is instructed to pick up the bottle and place it into the tray."
+      seed: 42
+      control_resolution: [240, 416]
+      depth_mode: h5_v4
+      depth_h5v4_per_view:
+        head_color: {raw_clip: [0.05, 10.0], inv_clip: [1.0, 40.0], norm_range: [0.05, 2.6]}
+        hand_left: {raw_clip: [0.0, 1.5], inv_clip: [0.7, 100.0], raw_pct: [1, 99]}
+        hand_right: {raw_clip: [0.0, 1.5], inv_clip: [0.7, 100.0], raw_pct: [1, 99]}
+      depth_near: 0.25
+      depth_near_per_view:
+        hand_left: 0.08
+        hand_right: 0.08
+        head_color: 0.25
+      depth_far: 6.0
+      invert_depth: true
+
+      # The coordinator overrides both values with the one beta frozen in the
+      # macro-round contract.  Every cohort must use that identical value.
+      rollout_action_source: beta
+      beta_schedule: constant
+      beta_start: 0.5
+      beta_end: 0.5
+      beta_decay_iters: 1
+      reference_lag: 256
+
+      dump_first_n_chunks: 0
+      dump_dir: null
+      view_names: [head_color, hand_left, hand_right]
+      primary_view: head_color
+
+policy_view_count: 3
