new file mode 100644
index 0000000000000000000000000000000000000000..2f2623a68911f0e40c062373a3016282e5a63ddd
--- /dev/null
+++ b/gr00t/rl/utils/simulation_app_lifecycle.py
@@ -0,0 +1,176 @@
+"""Deterministic lifecycle management for an Isaac ``SimulationApp``.
+
+This module intentionally uses only the Python standard library so its failure
+semantics can be tested without importing Isaac Sim.
+"""
+
+from __future__ import annotations
+
+import os
+import signal
+import sys
+import traceback
+from types import FrameType
+from typing import Any, Optional, Type
+
+
+_SKIP_CLEANUP_ENV = "IMAGE_DAGGER_SIMULATION_APP_SKIP_CLEANUP"
+
+
+def _skip_cleanup_from_environment() -> bool:
+    """Return the explicitly selected Isaac shutdown behavior.
+
+    Isaac Sim's default graceful close is preserved unless the batch launcher
+    opts into ``SimulationApp.close(skip_cleanup=True)``.  Restricting the
+    accepted values to literal ``0`` and ``1`` prevents a typo from silently
+    changing process-shutdown semantics.
+    """
+
+    raw_value = os.environ.get(_SKIP_CLEANUP_ENV)
+    if raw_value is None or raw_value == "0":
+        return False
+    if raw_value == "1":
+        return True
+    raise RuntimeError(
+        f"{_SKIP_CLEANUP_ENV} must be exactly 0 or 1 when set; "
+        f"received {raw_value!r}"
+    )
+
+
+class SimulationAppLifecycle:
+    """Own one optional ``SimulationApp`` and close it exactly once.
+
+    ``SIGTERM`` is converted to ``SystemExit`` while the context is active so
+    Python unwinds through ``__exit__`` instead of abandoning the app.  A close
+    failure is propagated after a successful body.  If the body is already
+    failing, a close failure is reported but cannot replace the active error.
+    """
+
+    def __init__(self) -> None:
+        self._skip_cleanup = _skip_cleanup_from_environment()
+        self._app: Any = None
+        self._close_attempted = False
+        self._previous_sigterm_handler: Any = None
+        self._entered = False
+        self._used = False
+
+    @staticmethod
+    def _handle_sigterm(signum: int, _frame: Optional[FrameType]) -> None:
+        raise SystemExit(128 + signum)
+
+    @staticmethod
+    def _report_secondary_failure(label: str, error: BaseException) -> None:
+        try:
+            print(
+                f"SimulationApp lifecycle {label}; preserving the active exception:",
+                file=sys.stderr,
+            )
+            traceback.print_exception(
+                type(error), error, error.__traceback__, file=sys.stderr
+            )
+            sys.stderr.flush()
+        except BaseException:
+            # Diagnostic I/O must never replace the exception already in flight.
+            pass
+
+    @staticmethod
+    def _report_active_exception(
+        exception_type: Type[BaseException],
+        exception: BaseException,
+        exception_traceback: Any,
+    ) -> None:
+        """Expose a body failure before ``SimulationApp.close()`` can block."""
+
+        try:
+            print(
+                "SimulationApp lifecycle body failed; active exception before close:",
+                file=sys.stderr,
+            )
+            traceback.print_exception(
+                exception_type,
+                exception,
+                exception_traceback,
+                file=sys.stderr,
+            )
+        except BaseException:
+            # Failure reporting must never replace the exception from the body.
+            pass
+        try:
+            sys.stderr.flush()
+        except BaseException:
+            # Preserve the body exception even if the diagnostic stream is broken.
+            pass
+
+    def __enter__(self) -> "SimulationAppLifecycle":
+        if self._used:
+            raise RuntimeError("SimulationAppLifecycle cannot be reused")
+        self._used = True
+        self._previous_sigterm_handler = signal.getsignal(signal.SIGTERM)
+        signal.signal(signal.SIGTERM, self._handle_sigterm)
+        self._entered = True
+        return self
+
+    def attach(self, app: Any) -> None:
+        """Transfer ownership of a newly launched app to this context."""
+
+        if not self._entered:
+            raise RuntimeError("SimulationApp must be attached inside its lifecycle")
+        if app is None:
+            raise ValueError("SimulationApp cannot be None")
+        if self._app is not None:
+            raise RuntimeError("SimulationAppLifecycle already owns an app")
+        self._app = app
+
+    def _close_once(self) -> None:
+        if self._app is None or self._close_attempted:
+            return
+        self._close_attempted = True
+        if self._skip_cleanup:
+            self._app.close(skip_cleanup=True)
+        else:
+            # Keep Isaac's graceful default, including its replicator wait,
+            # byte-for-byte equivalent to the lifecycle's original behavior.
+            self._app.close()
+
+    def __exit__(
+        self,
+        exception_type: Optional[Type[BaseException]],
+        exception: Optional[BaseException],
+        exception_traceback: Any,
+    ) -> bool:
+        if exception_type is not None and exception is not None:
+            self._report_active_exception(
+                exception_type, exception, exception_traceback
+            )
+
+        close_error: Optional[BaseException] = None
+        restore_error: Optional[BaseException] = None
+        try:
+            self._close_once()
+        except BaseException as error:  # cleanup must also handle SystemExit
+            close_error = error
+        finally:
+            self._entered = False
+            try:
+                signal.signal(signal.SIGTERM, self._previous_sigterm_handler)
+            except BaseException as error:
+                restore_error = error
+
+        if exception_type is not None:
+            if close_error is not None:
+                self._report_secondary_failure("close failed", close_error)
+            if restore_error is not None:
+                self._report_secondary_failure(
+                    "SIGTERM handler restoration failed", restore_error
+                )
+            return False
+
+        if close_error is not None:
+            if restore_error is not None:
+                self._report_secondary_failure(
+                    "SIGTERM handler restoration also failed", restore_error
+                )
+            raise close_error
+        if restore_error is not None:
+            raise restore_error
+        return False
