+"""Regression gates for rank-local, digest-bound teacher restoration."""
+
+from __future__ import annotations
+
+import ast
+import unittest
+from pathlib import Path
+
+
+SOURCE = (
+    Path(__file__).resolve().parents[1]
+    / "gr00t/rl/trl/trainer/distill_trainer.py"
+)
+
+
+class TeacherCheckpointDeviceTest(unittest.TestCase):
+    def _load_method(self) -> ast.FunctionDef:
+        tree = ast.parse(SOURCE.read_text(encoding="utf-8"))
+        return next(
+            node
+            for node in ast.walk(tree)
+            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
+            and node.name == "load_teacher_actor"
+        )
+
+    def test_teacher_load_uses_same_descriptor_digest_gate_on_cpu(self) -> None:
+        method = self._load_method()
+        loads = [
+            node
+            for node in ast.walk(method)
+            if isinstance(node, ast.Call)
+            and isinstance(node.func, ast.Name)
+            and node.func.id == "load_verified_torch_checkpoint"
+        ]
+        self.assertEqual(len(loads), 1)
+        keywords = {item.arg: item.value for item in loads[0].keywords}
+        self.assertIn("map_location", keywords)
+        self.assertEqual(ast.literal_eval(keywords["map_location"]), "cpu")
+        expected = ast.unparse(keywords["expected_sha256"])
+        self.assertIn("ROUND_DAGGER_TEACHER_SHA256", expected)
+        self.assertEqual(ast.unparse(keywords["require_expected_sha256"]), "production_consumer")
+
+    def test_teacher_load_has_no_path_based_torch_load_fallback(self) -> None:
+        method = self._load_method()
+        unsafe = [
+            node
+            for node in ast.walk(method)
+            if isinstance(node, ast.Call)
+            and isinstance(node.func, ast.Attribute)
+            and isinstance(node.func.value, ast.Name)
+            and node.func.value.id == "torch"
+            and node.func.attr == "load"
+        ]
+        self.assertEqual(unsafe, [])
+
+    def test_production_and_paired_eval_require_teacher_digest(self) -> None:
+        method_text = ast.unparse(self._load_method())
+        self.assertIn('RUN_PROFILE', method_text)
+        self.assertIn('production_256x300', method_text)
+        self.assertIn('IMAGE_DAGGER_PAIRED_EVAL', method_text)
+
+
+if __name__ == "__main__":
+    unittest.main()
