+++ b/tests/test_simulation_app_lifecycle.py
@@ -0,0 +1,144 @@
+import io
+
+import pytest
+
+from gr00t.rl.utils import simulation_app_lifecycle as lifecycle_module
+from gr00t.rl.utils.simulation_app_lifecycle import SimulationAppLifecycle
+
+
+class RecordingStderr(io.StringIO):
+    def __init__(self, events):
+        super().__init__()
+        self.events = events
+
+    def write(self, text):
+        self.events.append(("write", text))
+        return super().write(text)
+
+    def flush(self):
+        self.events.append(("flush", None))
+        return super().flush()
+
+
+class RecordingApp:
+    def __init__(self, events, close_error=None):
+        self.events = events
+        self.close_error = close_error
+
+    def close(self):
+        self.events.append(("close", None))
+        if self.close_error is not None:
+            raise self.close_error
+
+
+class ImmediateCloseRecordingApp:
+    def __init__(self):
+        self.close_kwargs = []
+
+    def close(self, **kwargs):
+        self.close_kwargs.append(kwargs)
+
+
+class BrokenStderr:
+    def write(self, _text):
+        raise OSError("stderr is unavailable")
+
+    def flush(self):
+        raise OSError("stderr is unavailable")
+
+
+@pytest.fixture
+def isolated_lifecycle(monkeypatch):
+    monkeypatch.delenv(
+        "IMAGE_DAGGER_SIMULATION_APP_SKIP_CLEANUP", raising=False
+    )
+    previous_handler = object()
+    monkeypatch.setattr(
+        lifecycle_module.signal, "getsignal", lambda _signum: previous_handler
+    )
+    monkeypatch.setattr(lifecycle_module.signal, "signal", lambda *_args: None)
+
+
+def test_body_exception_is_printed_and_flushed_before_close(
+    monkeypatch, isolated_lifecycle
+):
+    events = []
+    stderr = RecordingStderr(events)
+    app = RecordingApp(events)
+    original_error = RuntimeError("body exploded")
+    monkeypatch.setattr(lifecycle_module.sys, "stderr", stderr)
+
+    with pytest.raises(RuntimeError) as raised:
+        with SimulationAppLifecycle() as lifecycle:
+            lifecycle.attach(app)
+            raise original_error
+
+    assert raised.value is original_error
+    close_index = events.index(("close", None))
+    before_close = events[:close_index]
+    before_close_text = "".join(
+        value for kind, value in before_close if kind == "write"
+    )
+    assert "active exception before close" in before_close_text
+    assert "RuntimeError: body exploded" in before_close_text
+    assert ("flush", None) in before_close
+
+
+def test_close_failure_does_not_replace_body_exception(monkeypatch, isolated_lifecycle):
+    events = []
+    stderr = RecordingStderr(events)
+    close_error = OSError("close exploded")
+    app = RecordingApp(events, close_error=close_error)
+    original_error = ValueError("body remains primary")
+    monkeypatch.setattr(lifecycle_module.sys, "stderr", stderr)
+
+    with pytest.raises(ValueError) as raised:
+        with SimulationAppLifecycle() as lifecycle:
+            lifecycle.attach(app)
+            raise original_error
+
+    assert raised.value is original_error
+    assert app.events.count(("close", None)) == 1
+    assert "OSError: close exploded" in stderr.getvalue()
+
+
+def test_broken_stderr_and_close_failure_do_not_replace_body_exception(
+    monkeypatch, isolated_lifecycle
+):
+    events = []
+    app = RecordingApp(events, close_error=OSError("close exploded"))
+    original_error = ValueError("body remains primary")
+    monkeypatch.setattr(lifecycle_module.sys, "stderr", BrokenStderr())
+
+    with pytest.raises(ValueError) as raised:
+        with SimulationAppLifecycle() as lifecycle:
+            lifecycle.attach(app)
+            raise original_error
+
+    assert raised.value is original_error
+    assert app.events.count(("close", None)) == 1
+
+
+def test_immediate_close_is_an_explicit_opt_in(monkeypatch, isolated_lifecycle):
+    monkeypatch.setenv("IMAGE_DAGGER_SIMULATION_APP_SKIP_CLEANUP", "1")
+    app = ImmediateCloseRecordingApp()
+
+    with SimulationAppLifecycle() as lifecycle:
+        lifecycle.attach(app)
+
+    assert app.close_kwargs == [{"skip_cleanup": True}]
+
+
+@pytest.mark.parametrize("invalid_value", ["", "true", "yes", "2", " 1"])
+def test_invalid_immediate_close_value_fails_closed(
+    monkeypatch, isolated_lifecycle, invalid_value
+):
+    monkeypatch.setenv(
+        "IMAGE_DAGGER_SIMULATION_APP_SKIP_CLEANUP", invalid_value
+    )
+
+    with pytest.raises(
+        RuntimeError,
+        match="IMAGE_DAGGER_SIMULATION_APP_SKIP_CLEANUP must be exactly 0 or 1",
+    ):
+        SimulationAppLifecycle()

