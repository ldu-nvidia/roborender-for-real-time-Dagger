+++ b/tests/test_videogen_rollout_buffering.py
@@ -0,0 +1,144 @@
+"""Regression tests for high-resolution rollout chunk retention."""
+
+from __future__ import annotations
+
+import ast
+import copy
+from pathlib import Path
+
+import pytest
+
+
+SOURCE = (
+    Path(__file__).resolve().parents[1]
+    / "gr00t/rl/trl/trainer/distill_trainer_videogen.py"
+)
+
+
+def _policy_step() -> ast.FunctionDef:
+    tree = ast.parse(SOURCE.read_text(encoding="utf-8"))
+    trainer = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.ClassDef)
+        and node.name == "TRLDistillTrainerVideoGen"
+    )
+    return next(
+        node
+        for node in trainer.body
+        if isinstance(node, ast.FunctionDef) and node.name == "policy_step"
+    )
+
+
+def _chunk_buffer_guard() -> ast.If:
+    guards = [
+        node
+        for node in ast.walk(_policy_step())
+        if isinstance(node, ast.If)
+        and ast.unparse(node.test) == "self.vg_mode in ('online', 'collect')"
+    ]
+    assert len(guards) == 1
+    return guards[0]
+
+
+def _chunk_append_lines(node: ast.AST) -> set[tuple[str, int]]:
+    appends = set()
+    for item in ast.walk(node):
+        if not (
+            isinstance(item, ast.Call)
+            and isinstance(item.func, ast.Attribute)
+            and item.func.attr == "append"
+            and isinstance(item.func.value, ast.Attribute)
+            and isinstance(item.func.value.value, ast.Name)
+            and item.func.value.value.id == "self"
+            and item.func.value.attr in {"_depth_chunk", "_robot_rgb_chunk"}
+        ):
+            continue
+        appends.add((item.func.value.attr, item.lineno))
+    return appends
+
+
+def _compile_guard():
+    guard = copy.deepcopy(_chunk_buffer_guard())
+    function = ast.FunctionDef(
+        name="capture_chunks",
+        args=ast.arguments(
+            posonlyargs=[],
+            args=[ast.arg(arg="self")],
+            kwonlyargs=[],
+            kw_defaults=[],
+            defaults=[],
+        ),
+        body=[guard],
+        decorator_list=[],
+    )
+    module = ast.fix_missing_locations(ast.Module(body=[function], type_ignores=[]))
+    namespace = {}
+    exec(compile(module, str(SOURCE), "exec"), namespace)
+    return namespace["capture_chunks"]
+
+
+class _Frame:
+    def detach(self):
+        return self
+
+    def to(self, device):
+        assert device == "cpu"
+        return self
+
+
+class _Simulator:
+    def __init__(self):
+        self.robot_rgb_calls = 0
+
+    def get_robot_rgb_image(self):
+        self.robot_rgb_calls += 1
+        return _Frame()
+
+
+class _Trainer:
+    def __init__(self, mode):
+        self.vg_mode = mode
+        self._depth_chunk = []
+        self._robot_rgb_chunk = []
+        self.depth_calls = 0
+        self.env = type("Env", (), {"simulator": _Simulator()})()
+
+    def _get_depth_frame(self):
+        self.depth_calls += 1
+        return _Frame()
+
+
+def test_all_high_resolution_chunk_appends_are_inside_mode_guard():
+    method_appends = _chunk_append_lines(_policy_step())
+    guard_appends = _chunk_append_lines(_chunk_buffer_guard())
+
+    assert {name for name, _line in method_appends} == {
+        "_depth_chunk",
+        "_robot_rgb_chunk",
+    }
+    assert method_appends == guard_appends
+
+
+@pytest.mark.parametrize("mode", ("online", "collect"))
+def test_post_rollout_modes_retain_conditioning_chunks(mode):
+    trainer = _Trainer(mode)
+
+    _compile_guard()(trainer)
+
+    assert trainer.depth_calls == 1
+    assert trainer.env.simulator.robot_rgb_calls == 1
+    assert len(trainer._depth_chunk) == 1
+    assert len(trainer._robot_rgb_chunk) == 1
+
+
+@pytest.mark.parametrize("mode", ("image_dagger", "round_actor", "offline"))
+def test_per_frame_and_offline_modes_do_not_retain_conditioning_chunks(mode):
+    trainer = _Trainer(mode)
+
+    _compile_guard()(trainer)
+
+    assert trainer.depth_calls == 0
+    assert trainer.env.simulator.robot_rgb_calls == 0
+    assert trainer._depth_chunk == []
+    assert trainer._robot_rgb_chunk == []
