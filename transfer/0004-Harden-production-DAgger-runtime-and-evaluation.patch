@@ -0,0 +1,180 @@
+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+"""Runtime binding for the image-DAgger policy-view count contract."""
+
+from __future__ import annotations
+
+
+_BOUND_POLICY_VIEW_COUNT_ATTRIBUTE = "_image_dagger_bound_policy_view_count"
+
+
+def _get_config_value(config, key):
+    if config is None:
+        return None
+    getter = getattr(config, "get", None)
+    if callable(getter):
+        return getter(key, None)
+    return getattr(config, key, None)
+
+
+def _positive_integer(value, label):
+    if isinstance(value, bool):
+        raise RuntimeError(f"production gate failed: invalid {label}: {value!r}")
+    try:
+        parsed = int(value)
+    except (TypeError, ValueError) as exc:
+        raise RuntimeError(
+            f"production gate failed: invalid {label}: {value!r}"
+        ) from exc
+    if parsed <= 0 or (isinstance(value, float) and not value.is_integer()):
+        raise RuntimeError(f"production gate failed: invalid {label}: {value!r}")
+    return parsed
+
+
+def bind_policy_view_count_contract(root_config, env, expected_count=None):
+    """Bind the composed root view count onto the constructed environment.
+
+    Hydra's root configuration is the authority for observation sizing.  Some
+    environment construction paths detach or rebuild ``env.config`` and can
+    lose the mirrored ``image_dagger_policy_view_count`` field.  Production
+    launchers provide ``expected_count``; in that mode this function verifies
+    the root declaration and composed env mirror agree, rejects a conflicting
+    runtime value, and then publishes one validated scalar on both the runtime
+    config for the trainer to consume.
+
+    When no production expectation is enabled this is intentionally a no-op,
+    preserving historical single-view entry points.
+    """
+
+    if expected_count is None:
+        return None
+
+    expected = _positive_integer(expected_count, "expected policy view count")
+    root_count = _positive_integer(
+        _get_config_value(root_config, "policy_view_count"),
+        "root policy view count",
+    )
+    composed_env = _get_config_value(root_config, "env")
+    composed_env_config = _get_config_value(composed_env, "config")
+    composed_count = _positive_integer(
+        _get_config_value(
+            composed_env_config, "image_dagger_policy_view_count"
+        ),
+        "composed env policy view count",
+    )
+
+    if root_count != expected or composed_count != root_count:
+        raise RuntimeError(
+            "production gate failed: policy view count declarations disagree "
+            f"(expected {expected}, root {root_count}, composed env {composed_count})"
+        )
+
+    runtime_config = getattr(env, "config", None)
+    if runtime_config is None:
+        raise RuntimeError("production gate failed: runtime env config is missing")
+    runtime_raw = _get_config_value(
+        runtime_config, "image_dagger_policy_view_count"
+    )
+    if runtime_raw is not None:
+        runtime_count = _positive_integer(
+            runtime_raw, "runtime env policy view count"
+        )
+        if runtime_count != root_count:
+            raise RuntimeError(
+                "production gate failed: runtime policy view count disagrees "
+                f"(root {root_count}, runtime {runtime_count})"
+            )
+
+    try:
+        setattr(runtime_config, "image_dagger_policy_view_count", root_count)
+    except (AttributeError, TypeError, ValueError) as exc:
+        raise RuntimeError(
+            "production gate failed: could not bind runtime policy view count"
+        ) from exc
+
+    rebound = _positive_integer(
+        _get_config_value(runtime_config, "image_dagger_policy_view_count"),
+        "bound runtime env policy view count",
+    )
+    if rebound != root_count:
+        raise RuntimeError(
+            "production gate failed: runtime policy view count binding did not persist"
+        )
+
+    # Keep the validated scalar on the stable environment object as well as on
+    # its config.  Some Isaac environment wrappers expose ``config`` through a
+    # property that returns a detached/fresh object; a value published only on
+    # one such object can disappear before the trainer's subclass initialization
+    # runs.  The private environment attribute is therefore the durable handoff
+    # from this root/composed/runtime validation gate to the trainer gate.
+    prior_bound_raw = getattr(env, _BOUND_POLICY_VIEW_COUNT_ATTRIBUTE, None)
+    if prior_bound_raw is not None:
+        prior_bound = _positive_integer(
+            prior_bound_raw, "previously bound policy view count"
+        )
+        if prior_bound != root_count:
+            raise RuntimeError(
+                "production gate failed: bound policy view count disagrees "
+                f"(root {root_count}, bound {prior_bound})"
+            )
+    try:
+        setattr(env, _BOUND_POLICY_VIEW_COUNT_ATTRIBUTE, root_count)
+    except (AttributeError, TypeError, ValueError) as exc:
+        raise RuntimeError(
+            "production gate failed: could not persist policy view count on runtime env"
+        ) from exc
+    persisted = _positive_integer(
+        getattr(env, _BOUND_POLICY_VIEW_COUNT_ATTRIBUTE, None),
+        "persisted policy view count",
+    )
+    if persisted != root_count:
+        raise RuntimeError(
+            "production gate failed: runtime env policy view count did not persist"
+        )
+    return root_count
+
+
+def policy_view_count_for_trainer(env, expected_count=None):
+    """Return the count consumed by the trainer's production contract gate.
+
+    Production mode accepts only the stable scalar installed by
+    :func:`bind_policy_view_count_contract`; this proves the root, composed, and
+    initially constructed runtime configs were already checked.  A currently
+    visible runtime-config mirror is checked too, but may legitimately be absent
+    when an environment exposes a fresh/detached config object on each access.
+
+    Without a production expectation this preserves the historical behavior and
+    simply returns the value currently visible on ``env.config``.
+    """
+
+    runtime_config = getattr(env, "config", None)
+    runtime_raw = _get_config_value(
+        runtime_config, "image_dagger_policy_view_count"
+    )
+    if expected_count is None:
+        return runtime_raw
+
+    expected = _positive_integer(expected_count, "expected policy view count")
+    bound_raw = getattr(env, _BOUND_POLICY_VIEW_COUNT_ATTRIBUTE, None)
+    if bound_raw is None:
+        raise RuntimeError(
+            "production gate failed: validated policy view count binding is missing"
+        )
+    bound = _positive_integer(bound_raw, "bound policy view count")
+    if bound != expected:
+        raise RuntimeError(
+            "production gate failed: bound policy view count disagrees "
+            f"(expected {expected}, bound {bound})"
+        )
+
+    if runtime_raw is not None:
+        runtime_count = _positive_integer(
+            runtime_raw, "runtime env policy view count"
+        )
+        if runtime_count != bound:
+            raise RuntimeError(
+                "production gate failed: runtime policy view count disagrees "
+                f"(bound {bound}, runtime {runtime_count})"
+            )
+    return bound
