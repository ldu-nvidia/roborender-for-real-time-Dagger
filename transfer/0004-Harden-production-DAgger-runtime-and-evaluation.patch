+
+The checkpoint bytes are hashed and deserialized through the same open file
+descriptor.  This prevents a path replacement between an external hash check
+and ``torch.load`` from selecting different bytes.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import io
+import os
+import re
+import stat
+from pathlib import Path
+from typing import Any
+
+
+SHA256_RE = re.compile(r"[0-9a-f]{64}\Z")
+
+
+def select_rank_checkpoint_sha256(
+    raw_sha256s: str | None,
+    *,
+    rank: int,
+    world_size: int,
+    required: bool,
+) -> str | None:
+    """Select one rank's hash from an ordered, launcher-pinned CSV contract."""
+
+    if type(rank) is not int or type(world_size) is not int:
+        raise RuntimeError("runtime checkpoint rank and world size must be true integers")
+    if world_size < 1 or rank < 0 or rank >= world_size:
+        raise RuntimeError("runtime checkpoint rank/world-size contract is invalid")
+    if raw_sha256s in (None, "", "NONE"):
+        if required:
+            raise RuntimeError(
+                "strict production resume requires per-rank runtime checkpoint SHA-256s"
+            )
+        return None
+    values = tuple(value.strip() for value in str(raw_sha256s).split(","))
+    if len(values) != world_size:
+        raise RuntimeError(
+            "per-rank runtime checkpoint SHA-256 count does not match world size"
+        )
+    if any(SHA256_RE.fullmatch(value) is None for value in values):
+        raise RuntimeError("per-rank runtime checkpoint SHA-256 list is malformed")
+    return values[rank]
+
+
+def load_verified_torch_checkpoint(
+    torch_module: Any,
+    checkpoint_path: str | os.PathLike[str],
+    *,
+    map_location: Any,
+    expected_sha256: str | None = None,
+    require_expected_sha256: bool = False,
+    weights_only: bool = False,
+) -> tuple[Any, str]:
+    """Hash and deserialize one regular checkpoint through one safe descriptor."""
+
+    if type(weights_only) is not bool:
+        raise RuntimeError("weights_only must be a true boolean")
+    expected = None if expected_sha256 in (None, "", "NONE") else expected_sha256
+    if require_expected_sha256 and expected is None:
+        raise RuntimeError("strict production resume requires a checkpoint SHA-256")
+    if expected is not None and (
+        not isinstance(expected, str) or SHA256_RE.fullmatch(expected) is None
+    ):
+        raise RuntimeError("expected checkpoint SHA-256 must be 64 lowercase hex characters")
+
+    path = Path(checkpoint_path).expanduser()
+    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
+    try:
+        descriptor = os.open(path, flags)
+    except OSError as exc:
+        raise RuntimeError(f"cannot safely open checkpoint {path}: {exc}") from exc
+
+    try:
+        before = os.fstat(descriptor)
+        if not stat.S_ISREG(before.st_mode):
+            raise RuntimeError(f"checkpoint is not a regular file: {path}")
+        snapshot = io.BytesIO()
+        observed_bytes = 0
+        with os.fdopen(descriptor, "rb", closefd=True) as handle:
+            descriptor = -1
+            digest = hashlib.sha256()
+            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+                observed_bytes += len(chunk)
+                digest.update(chunk)
+                snapshot.write(chunk)
+            actual_sha256 = digest.hexdigest()
+            after = os.fstat(handle.fileno())
+        identity = lambda value: (
+            value.st_dev,
+            value.st_ino,
+            value.st_mode,
+            value.st_size,
+            value.st_mtime_ns,
+            value.st_ctime_ns,
+        )
+        if identity(before) != identity(after) or observed_bytes != before.st_size:
+            raise RuntimeError(f"checkpoint changed while it was snapshotted: {path}")
+        if expected is not None and actual_sha256 != expected:
+            raise RuntimeError(
+                "checkpoint SHA-256 mismatch at actual load "
+                f"({actual_sha256} != {expected})"
+            )
