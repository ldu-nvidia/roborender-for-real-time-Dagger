new file mode 100644
index 0000000000000000000000000000000000000000..2cd3e2c10e560d5016fd66b69d8a90bf4f6cc480
--- /dev/null
+++ b/tests/test_paired_scenario_binding.py
@@ -0,0 +1,153 @@
+"""Integration coverage for observed paired-evaluation scenario binding."""
+
+from __future__ import annotations
+
+import ast
+import hashlib
+import json
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+from gr00t.rl.utils.round_dagger_paired_eval import (
+    POLICY_VIEWS,
+    PairedEvaluationEvidence,
+    PairedEvaluationEvidenceError,
+)
+
+
+SOURCE = (
+    Path(__file__).resolve().parents[1]
+    / "gr00t/rl/trl/trainer/distill_trainer_obj_pred_homie_api.py"
+)
+
+
+def _load_finalizer():
+    tree = ast.parse(SOURCE.read_text(encoding="utf-8"))
+    selected = [
+        node
+        for node in tree.body
+        if isinstance(node, ast.FunctionDef)
+        and node.name == "_finalize_paired_episode_evidence"
+    ]
+    assert len(selected) == 1
+    namespace = {}
+    exec(
+        compile(ast.Module(body=selected, type_ignores=[]), str(SOURCE), "exec"),
+        namespace,
+    )
+    return namespace["_finalize_paired_episode_evidence"]
+
+
+def _load_safety_reader():
+    tree = ast.parse(SOURCE.read_text(encoding="utf-8"))
+    selected = [
+        node
+        for node in tree.body
+        if isinstance(node, ast.FunctionDef)
+        and node.name == "_required_paired_safety_violation"
+    ]
+    assert len(selected) == 1
+    namespace = {}
+    exec(
+        compile(ast.Module(body=selected, type_ignores=[]), str(SOURCE), "exec"),
+        namespace,
+    )
+    return namespace["_required_paired_safety_violation"]
+
+
+def _scenario_id(first_condition_sha256: str) -> str:
+    identity = {
+        "seed": 17,
+        "env_index": 0,
+        "first_condition_sha256": first_condition_sha256,
+    }
+    return hashlib.sha256(
+        json.dumps(identity, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    ).hexdigest()
+
+
+def _prepared_evidence(contract_scenario_id: str) -> PairedEvaluationEvidence:
+    evidence = PairedEvaluationEvidence(
+        num_envs=1,
+        generation_seed=17,
+        scenario_ids_by_env={0: contract_scenario_id},
+        runtime_policy_sha256="1" * 64,
+        evaluation_config_sha256="2" * 64,
+        evaluator_code_sha256="3" * 64,
+    )
+    evidence.record_generation_step(
+        {
+            0: {
+                view: np.full((2, 2, 3), index, dtype=np.uint8)
+                for index, view in enumerate(POLICY_VIEWS)
+            }
+        }
+    )
+    evidence.record_action_pair(0, np.zeros(2), np.zeros(2))
+    return evidence
+
+
+def _records(observed_scenario_id: str):
+    return {
+        0: {
+            "scenario_id": observed_scenario_id,
+            "success": True,
+            "episode_length": 1,
+        }
+    }
+
+
+def test_matching_observed_scenario_is_attested():
+    scenario_id = _scenario_id("a" * 64)
+    evidence = _prepared_evidence(scenario_id)
+
+    result = _load_finalizer()(
+        evidence,
+        _records(scenario_id),
+        {0: False},
+        num_envs=1,
+    )
+
+    assert result["_roborender_paired_episodes"][0]["scenario_id"] == scenario_id
+
+
+def test_observed_scenario_mismatch_fails_closed():
+    contract_scenario_id = _scenario_id("a" * 64)
+    observed_scenario_id = _scenario_id("b" * 64)
+    evidence = _prepared_evidence(contract_scenario_id)
+
+    with pytest.raises(
+        PairedEvaluationEvidenceError,
+        match="scenario identity differs from contract",
+    ):
+        _load_finalizer()(
+            evidence,
+            _records(observed_scenario_id),
+            {0: False},
+            num_envs=1,
+        )
+
+    # A rejected observation must not be replaced with the contract value or
+    # partially seal the accumulator.
+    result = _load_finalizer()(
+        evidence,
+        _records(contract_scenario_id),
+        {0: False},
+        num_envs=1,
+    )
+    assert result["_roborender_paired_episodes"][0]["scenario_id"] == contract_scenario_id
+
+
+def test_paired_safety_requires_an_explicit_boolean_simulator_signal():
+    read_safety = _load_safety_reader()
+    assert read_safety({"safety_violation": np.array([False], dtype=np.bool_)}, 0) is False
+    assert read_safety({"safety_violation": np.array([True], dtype=np.bool_)}, 0) is True
+
+    with pytest.raises(RuntimeError, match="requires infos.safety_violation"):
+        read_safety({"time_outs": np.array([False], dtype=np.bool_)}, 0)
+    with pytest.raises(RuntimeError, match="must be boolean"):
+        read_safety({"safety_violation": np.array([0], dtype=np.int64)}, 0)
+    with pytest.raises(RuntimeError, match="malformed"):
+        read_safety({"safety_violation": np.array([], dtype=np.bool_)}, 0)
