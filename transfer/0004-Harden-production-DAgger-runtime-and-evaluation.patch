+import unittest
+from types import SimpleNamespace
+
+from omegaconf import OmegaConf
+
+from gr00t.rl.utils.policy_view_contract import (
+    bind_policy_view_count_contract,
+    policy_view_count_for_trainer,
+)
+
+
+class AttrConfig(SimpleNamespace):
+    def get(self, key, default=None):
+        return getattr(self, key, default)
+
+
+class FreshConfigEnv:
+    """Model wrappers whose config property returns a detached object."""
+
+    @property
+    def config(self):
+        return AttrConfig()
+
+
+def make_root(root_count=3, composed_count=3):
+    return AttrConfig(
+        policy_view_count=root_count,
+        env=AttrConfig(
+            config=AttrConfig(
+                image_dagger_policy_view_count=composed_count,
+            )
+        ),
+    )
+
+
+class PolicyViewRuntimeBindingTest(unittest.TestCase):
+    def test_missing_runtime_mirror_is_bound_from_validated_root(self):
+        env = SimpleNamespace(config=AttrConfig())
+
+        result = bind_policy_view_count_contract(make_root(), env, "3")
+
+        self.assertEqual(result, 3)
+        self.assertEqual(env.config.image_dagger_policy_view_count, 3)
+        self.assertEqual(env.config.get("image_dagger_policy_view_count"), 3)
+
+    def test_matching_runtime_mirror_is_republished_for_trainer(self):
+        env = SimpleNamespace(
+            config=AttrConfig(image_dagger_policy_view_count="3")
+        )
+
+        bind_policy_view_count_contract(make_root(), env, 3)
+
+        self.assertEqual(env.config.get("image_dagger_policy_view_count"), 3)
+
+    def test_stable_env_binding_survives_fresh_runtime_config_objects(self):
+        env = FreshConfigEnv()
+
+        bind_policy_view_count_contract(make_root(), env, "3")
+
+        # A later config lookup cannot see the value bound on the earlier copy.
+        self.assertIsNone(env.config.get("image_dagger_policy_view_count"))
+        self.assertEqual(policy_view_count_for_trainer(env, "3"), 3)
+
+    def test_stable_env_binding_survives_runtime_config_replacement(self):
+        env = SimpleNamespace(config=AttrConfig())
+
+        bind_policy_view_count_contract(make_root(), env, "3")
+        env.config = AttrConfig()
+
+        self.assertEqual(policy_view_count_for_trainer(env, "3"), 3)
+
+        env.config.image_dagger_policy_view_count = 2
+        with self.assertRaisesRegex(RuntimeError, "runtime policy view count disagrees"):
+            policy_view_count_for_trainer(env, "3")
+
+    def test_interpolated_omegaconf_is_bound_to_runtime_dictconfig(self):
+        root = OmegaConf.create(
+            {
+                "policy_view_count": 3,
+                "env": {
+                    "config": {
+                        "image_dagger_policy_view_count": "${policy_view_count}",
+                    }
+                },
+            }
+        )
+        runtime_config = OmegaConf.create({})
+        OmegaConf.set_struct(runtime_config, False)
+        env = SimpleNamespace(config=runtime_config)
+
+        bind_policy_view_count_contract(root, env, "3")
+
+        self.assertEqual(env.config.image_dagger_policy_view_count, 3)
+        self.assertIsInstance(env.config.image_dagger_policy_view_count, int)
+
+    def test_declaration_or_runtime_disagreement_fails_closed(self):
+        cases = (
+            (make_root(root_count=2), AttrConfig(), "declarations disagree"),
+            (make_root(composed_count=2), AttrConfig(), "declarations disagree"),
+            (
+                make_root(),
+                AttrConfig(image_dagger_policy_view_count=2),
+                "runtime policy view count disagrees",
+            ),
+            (
+                make_root(),
+                AttrConfig(image_dagger_policy_view_count="three"),
+                "invalid runtime env policy view count",
+            ),
+        )
+        for root, runtime, message in cases:
+            with self.subTest(message=message), self.assertRaisesRegex(
+                RuntimeError, message
+            ):
+                bind_policy_view_count_contract(
+                    root, SimpleNamespace(config=runtime), 3
+                )
+
+    def test_nonproduction_entrypoint_is_unchanged(self):
+        env = SimpleNamespace(config=AttrConfig())
+
+        self.assertIsNone(bind_policy_view_count_contract(make_root(), env, None))
+        self.assertIsNone(env.config.get("image_dagger_policy_view_count"))
+
+    def test_trainer_gate_rejects_unvalidated_or_conflicting_bindings(self):
+        env = SimpleNamespace(
+            config=AttrConfig(image_dagger_policy_view_count=3)
+        )
+        with self.assertRaisesRegex(RuntimeError, "validated.*binding is missing"):
+            policy_view_count_for_trainer(env, "3")
+
+        bind_policy_view_count_contract(make_root(), env, "3")
+        env.config.image_dagger_policy_view_count = 2
+        with self.assertRaisesRegex(RuntimeError, "runtime policy view count disagrees"):
+            policy_view_count_for_trainer(env, "3")
+
+    def test_nonproduction_trainer_lookup_preserves_visible_config_value(self):
+        env = SimpleNamespace(
+            config=AttrConfig(image_dagger_policy_view_count="legacy")
+        )
+
+        self.assertEqual(policy_view_count_for_trainer(env), "legacy")
+
+
+if __name__ == "__main__":
+    unittest.main()
