+def test_shadow_lifecycle_wraps_rollout_but_not_shard_export():
+    train = _method("train")
+    start = _attribute_calls(train, "start_round")
+    rollout = _attribute_calls(train, "_rollout_step")
+    end = _attribute_calls(train, "end_round")
+    abort = _attribute_calls(train, "abort_round")
+    exports = [
+        node
+        for node in ast.walk(train)
+        if isinstance(node, ast.Call)
+        and isinstance(node.func, ast.Name)
+        and node.func.id == "export_trainer_rollout"
+    ]
+    assert len(start) == len(end) == len(abort) == len(exports) == 1
+    assert len(rollout) == 3
+    legacy_rollouts = tuple(
+        call for call in rollout if call.lineno < start[0].lineno
+    )
+    shadow_rollout = next(call for call in rollout if call.lineno > start[0].lineno)
+    assert len(legacy_rollouts) == 2
+    assert max(call.lineno for call in legacy_rollouts) < start[0].lineno
+    assert start[0].lineno < shadow_rollout.lineno < end[0].lineno < exports[0].lineno
+    assert abort[0].lineno < exports[0].lineno
+    shadow_try = next(
+        node
+        for node in ast.walk(train)
+        if isinstance(node, ast.Try)
+        and node.lineno <= start[0].lineno <= node.end_lineno
+    )
+    assert shadow_try.lineno <= start[0].lineno
+    assert any(
+        abort[0].lineno <= handler.end_lineno
+        and abort[0].lineno >= handler.lineno
+        for handler in shadow_try.handlers
+    )
+
+    default_arm = next(
+        node
+        for node in ast.walk(train)
+        if isinstance(node, ast.If)
+        and ast.unparse(node.test) == "validation_evidence is None"
+    )
+    default_body = ast.Module(body=default_arm.body, type_ignores=[])
+    default_source = ast.unparse(default_body)
+    assert default_source.count("self._rollout_step(model, obs_dict)") == 1
+    assert "_begin_validation_rollout_metrics" not in default_source
