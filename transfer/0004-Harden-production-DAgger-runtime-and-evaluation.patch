+
+class FakeSettings:
+    def __init__(self, values, ignored_paths=()):
+        self.values = dict(values)
+        self.ignored_paths = set(ignored_paths)
+        self.set_calls = []
+
+    def get(self, path):
+        return self.values.get(path)
+
+    def set_bool(self, path, value):
+        self.set_calls.append((path, value))
+        if path not in self.ignored_paths:
+            self.values[path] = value
+
+
+def test_reassert_writes_and_validates_every_required_setting():
+    settings = FakeSettings({path: True for path in REQUIRED_DISABLED_CARB_SETTINGS})
+
+    resolved = reassert_headless_camera_rendering(settings)
+
+    assert settings.set_calls == [
+        (path, False) for path in REQUIRED_DISABLED_CARB_SETTINGS
+    ]
+    assert resolved == {path: False for path in REQUIRED_DISABLED_CARB_SETTINGS}
+
+
+def test_reassert_fails_closed_when_a_setting_write_does_not_stick():
+    unsafe_path = "/rtx/directLighting/sampledLighting/enabled"
+    settings = FakeSettings(
+        {path: True for path in REQUIRED_DISABLED_CARB_SETTINGS},
+        ignored_paths=(unsafe_path,),
+    )
+
+    with pytest.raises(RuntimeError, match=unsafe_path):
+        reassert_headless_camera_rendering(settings)
+
+
+def test_required_settings_cover_active_default_and_transient_namespaces():
+    assert set(REQUIRED_DISABLED_CARB_SETTINGS) == {
+        *ACTIVE_REQUIRED_DISABLED_CARB_SETTINGS,
+        *DEFAULT_REQUIRED_DISABLED_CARB_SETTINGS,
+    }
+    assert any(path.startswith("/rtx-transient/") for path in REQUIRED_DISABLED_CARB_SETTINGS)
+    assert any(path.startswith("/rtx-defaults/") for path in REQUIRED_DISABLED_CARB_SETTINGS)
+    assert any(
+        path.startswith("/rtx-defaults-transient/")
+        for path in REQUIRED_DISABLED_CARB_SETTINGS
+    )
+
+
+@pytest.mark.parametrize(
+    "script_name",
+    ("train_agent_trl.py", "eval_agent_trl.py"),
+)
+def test_train_and_eval_reassert_before_the_existing_validation(script_name):
+    repo_root = Path(__file__).resolve().parents[1]
+    tree = ast.parse((repo_root / "gr00t" / "rl" / script_name).read_text())
+    lifecycle_calls = {
+        node.func.id: node.lineno
+        for node in ast.walk(tree)
+        if isinstance(node, ast.Call)
+        and isinstance(node.func, ast.Name)
+        and node.func.id
+        in {"reassert_headless_camera_rendering", "validate_headless_camera_rendering"}
