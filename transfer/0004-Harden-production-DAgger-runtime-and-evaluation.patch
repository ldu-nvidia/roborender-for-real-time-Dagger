@@ -0,0 +1,128 @@
+"""Regression tests for immutable checkpoint bytes at the pickle boundary."""
+
+from __future__ import annotations
+
+import hashlib
+import pickle
+import tempfile
+import unittest
+from pathlib import Path
+
+from gr00t.rl.trl.trainer.checkpoint_io import load_verified_torch_checkpoint
+
+
+def _write_pickle_side_effect(path: str) -> None:
+    Path(path).write_text("pickle-executed", encoding="utf-8")
+
+
+class _MaliciousReducer:
+    def __init__(self, marker: Path) -> None:
+        self.marker = marker
+
+    def __reduce__(self):
+        return (_write_pickle_side_effect, (str(self.marker),))
+
+
+class _MutatingTorch:
+    def __init__(self, source: Path, replacement: bytes) -> None:
+        self.source = source
+        self.replacement = replacement
+        self.calls = 0
+        self.consumed = b""
+
+    def load(self, stream, **_kwargs):
+        self.calls += 1
+        # This is the critical latch: mutate the already-hashed inode exactly
+        # when deserialization starts.  The loader must consume its immutable
+        # snapshot rather than seeking the mutable file descriptor again.
+        self.source.write_bytes(self.replacement)
+        self.consumed = stream.read()
+        return self.consumed
+
+
+class CheckpointSnapshotTest(unittest.TestCase):
+    def test_weights_only_rejects_pickle_side_effect_after_valid_hash(self) -> None:
+        try:
+            import torch
+        except ModuleNotFoundError:
+            self.skipTest("torch is unavailable in the lightweight control environment")
+
+        with tempfile.TemporaryDirectory() as temporary:
+            source = Path(temporary) / "checkpoint.pt"
+            marker = Path(temporary) / "pickle-side-effect.txt"
+            torch.save(
+                {
+                    "actor_model_state_dict": {},
+                    "malicious": _MaliciousReducer(marker),
+                },
+                source,
+            )
+            expected = hashlib.sha256(source.read_bytes()).hexdigest()
+            with self.assertRaisesRegex(
+                pickle.UnpicklingError, "Weights only load failed"
+            ):
+                load_verified_torch_checkpoint(
+                    torch,
+                    source,
+                    map_location="cpu",
+                    expected_sha256=expected,
+                    require_expected_sha256=True,
+                    weights_only=True,
+                )
+            self.assertFalse(marker.exists())
+
+    def test_required_expected_sha_fails_before_deserializer(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary:
+            source = Path(temporary) / "checkpoint.pt"
+            source.write_bytes(b"not-consumed")
+            fake = _MutatingTorch(source, b"never-consumed")
+            with self.assertRaisesRegex(RuntimeError, "requires a checkpoint SHA-256"):
+                load_verified_torch_checkpoint(
+                    fake,
+                    source,
+                    map_location="cpu",
+                    require_expected_sha256=True,
+                    weights_only=True,
+                )
+            self.assertEqual(fake.calls, 0)
+
+    def test_in_place_mutation_at_deserialize_cannot_change_consumed_bytes(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary:
+            source = Path(temporary) / "checkpoint.pt"
+            benign = b"BENIGN_CONTRACTED_CHECKPOINT"
+            malicious = b"MALICIOUS_REPLACEMENT"
+            source.write_bytes(benign)
+            expected = hashlib.sha256(benign).hexdigest()
+            fake = _MutatingTorch(source, malicious)
+
+            payload, actual = load_verified_torch_checkpoint(
+                fake,
+                source,
+                map_location="cpu",
+                expected_sha256=expected,
+                require_expected_sha256=True,
+            )
+
+            self.assertEqual(actual, expected)
+            self.assertEqual(payload, benign)
+            self.assertEqual(fake.consumed, benign)
+            self.assertEqual(source.read_bytes(), malicious)
+
+    def test_hash_mismatch_fails_before_deserializer_is_called(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary:
+            source = Path(temporary) / "checkpoint.pt"
+            source.write_bytes(b"unexpected")
+            fake = _MutatingTorch(source, b"never-consumed")
+            with self.assertRaisesRegex(RuntimeError, "SHA-256 mismatch"):
+                load_verified_torch_checkpoint(
+                    fake,
+                    source,
+                    map_location="cpu",
+                    expected_sha256=hashlib.sha256(b"expected").hexdigest(),
+                    require_expected_sha256=True,
+                )
+            self.assertEqual(fake.calls, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
