+def _parse_contract_csv(raw, name, cast=str):
+    """Parse a non-empty comma-separated production contract value."""
+    pieces = tuple(piece.strip() for piece in str(raw).split(","))
+    if not pieces or any(not piece for piece in pieces):
+        raise RuntimeError(f"production gate failed: invalid {name}: {raw!r}")
+    try:
+        return tuple(cast(piece) for piece in pieces)
+    except (TypeError, ValueError) as exc:
+        raise RuntimeError(
+            f"production gate failed: invalid {name}: {raw!r}"
+        ) from exc
