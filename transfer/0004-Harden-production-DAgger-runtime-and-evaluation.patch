+"""Structural gates for the default-off round runtime shadow seam.
+
+These tests intentionally parse the trainer instead of importing its Isaac and
+TRL dependency graph.  Behavioral adapter tests live in the outer
+``fast_roborender`` repository.
+"""
+
+from __future__ import annotations
+
+import ast
+import json
+import os
+import stat
+import tempfile
+import time
+from pathlib import Path
+
+
+SOURCE = (
+    Path(__file__).resolve().parents[1]
+    / "gr00t/rl/trl/trainer/distill_trainer_videogen.py"
+)
+TRAIN_SOURCE = Path(__file__).resolve().parents[1] / "gr00t/rl/train_agent_trl.py"
+
+
+def _trainer() -> ast.ClassDef:
+    tree = ast.parse(SOURCE.read_text(encoding="utf-8"))
+    return next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.ClassDef)
+        and node.name == "TRLDistillTrainerVideoGen"
+    )
+
+
+def _module_function(name: str) -> ast.FunctionDef:
+    tree = ast.parse(SOURCE.read_text(encoding="utf-8"))
+    return next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.FunctionDef) and node.name == name
+    )
+
+
+def _train_function(name: str) -> ast.FunctionDef:
+    tree = ast.parse(TRAIN_SOURCE.read_text(encoding="utf-8"))
+    return next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.FunctionDef) and node.name == name
+    )
+
+
+def _load_module_functions(*names: str, extra_globals=None):
+    tree = ast.parse(SOURCE.read_text(encoding="utf-8"))
+    selected = [
+        node
+        for node in tree.body
+        if isinstance(node, ast.FunctionDef) and node.name in names
+    ]
+    assert {node.name for node in selected} == set(names)
+    namespace = {
+        "Path": Path,
+        "json": json,
+        "os": os,
+        "tempfile": tempfile,
+        "time": time,
+    }
+    namespace.update(extra_globals or {})
+    exec(compile(ast.Module(body=selected, type_ignores=[]), str(SOURCE), "exec"), namespace)
+    return tuple(namespace[name] for name in names)
+
+
+def _method(name: str) -> ast.FunctionDef:
+    return next(
+        node
+        for node in _trainer().body
+        if isinstance(node, ast.FunctionDef) and node.name == name
+    )
+
+
+def _attribute_calls(method: ast.FunctionDef, name: str) -> list[ast.Call]:
+    return [
+        node
+        for node in ast.walk(method)
+        if isinstance(node, ast.Call)
+        and isinstance(node.func, ast.Attribute)
+        and node.func.attr == name
+    ]
+
+
+def _subscript_assignment_lines(method: ast.FunctionDef, key: str) -> list[int]:
+    lines = []
+    for node in ast.walk(method):
+        if not isinstance(node, ast.Assign):
+            continue
+        for target in node.targets:
+            if not isinstance(target, ast.Subscript):
+                continue
+            index = target.slice
+            if isinstance(index, ast.Constant) and index.value == key:
+                lines.append(node.lineno)
+    return lines
+
+
+def test_shadow_decision_observes_final_dagger_lineage_without_work_calls():
+    policy_step = _method("policy_step")
+    hooks = _attribute_calls(policy_step, "begin_decision")
+    assert len(hooks) == 1
+    hook = hooks[0]
+
+    final_keys = (
+        "student_actions",
+        "expert_mask",
+        "round_global_env_ids",
+        "round_episode_ids",
+        "round_episode_steps",
+        "round_observation_is_raytraced",
+    )
+    lineage_lines = []
+    for key in final_keys:
+        matches = _subscript_assignment_lines(policy_step, key)
+        assert len(matches) == 1, key
+        lineage_lines.extend(matches)
+    assert hook.lineno > max(lineage_lines)
+
+    random_calls = _attribute_calls(policy_step, "rand")
+    assert len(random_calls) == 1
+    assert hook.lineno > random_calls[0].lineno
+
+    hook_statement = next(
+        node
+        for node in ast.walk(policy_step)
+        if isinstance(node, ast.Expr) and node.value is hook
+    )
+    forbidden = {
+        "clone",
+        "cpu",
+        "numpy",
+        "step",
+        "policy_step",
+        "get_conditioning_views",
+        "_image_dagger_relabel",
+    }
+    called_attributes = {
+        node.func.attr
+        for node in ast.walk(hook_statement)
+        if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute)
+    }
+    assert called_attributes.isdisjoint(forbidden)
