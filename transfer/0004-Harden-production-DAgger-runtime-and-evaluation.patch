+"""Byte-exact loading and validation for fixed Homie controller checkpoints."""
+
+from __future__ import annotations
+
+import hashlib
+import io
+import os
+import re
+import stat
+from collections.abc import Mapping
+from pathlib import Path
+from typing import Any
+
+
+HOMIE_CONTROLLER_ROLES = ("walk", "stand")
+_SHA256_RE = re.compile(r"[0-9a-f]{64}\Z")
+
+
+def validate_homie_controller_sha256(value: Any) -> dict[str, str]:
+    if not isinstance(value, Mapping) or set(value) != set(HOMIE_CONTROLLER_ROLES):
+        raise RuntimeError(
+            "homie_controller_sha256 must contain exactly walk and stand"
+        )
+    result = {}
+    for role in HOMIE_CONTROLLER_ROLES:
+        digest = value[role]
+        if not isinstance(digest, str) or _SHA256_RE.fullmatch(digest) is None:
+            raise RuntimeError(
+                f"Homie {role} controller SHA-256 must be lowercase hexadecimal"
+            )
+        result[role] = digest
+    return result
+
+
+def load_homie_controller_checkpoint(torch_module, path, *, map_location):
+    """Load and hash one immutable byte snapshot, avoiding a hash/load race."""
+
+    candidate = Path(path).expanduser()
+    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
+    nofollow = getattr(os, "O_NOFOLLOW", 0)
+    if not nofollow and candidate.is_symlink():
+        raise RuntimeError("Homie controller must be a regular non-symlink file")
+    flags |= nofollow
+    try:
+        descriptor = os.open(candidate, flags)
+    except OSError as exc:
+        raise RuntimeError(
+            "Homie controller must be a readable regular non-symlink file"
+        ) from exc
+    try:
+        metadata = os.fstat(descriptor)
+        if not stat.S_ISREG(metadata.st_mode):
+            raise RuntimeError(
+                "Homie controller must be a regular non-symlink file"
+            )
+        if metadata.st_size <= 0:
+            raise RuntimeError("Homie controller checkpoint must not be empty")
+        chunks = []
+        while True:
+            chunk = os.read(descriptor, 1024 * 1024)
+            if not chunk:
+                break
+            chunks.append(chunk)
+        payload = b"".join(chunks)
+        if len(payload) != metadata.st_size:
+            raise RuntimeError(
+                "Homie controller changed while its immutable snapshot was read"
+            )
+    finally:
+        os.close(descriptor)
+    if not payload:
+        raise RuntimeError("Homie controller checkpoint must not be empty")
+    digest = hashlib.sha256(payload).hexdigest()
+    try:
+        checkpoint = torch_module.load(
+            io.BytesIO(payload), map_location=map_location, weights_only=False
+        )
+    except Exception as exc:
+        raise RuntimeError(f"cannot load Homie controller: {candidate}") from exc
+    return checkpoint, digest
+
+
+__all__ = [
+    "HOMIE_CONTROLLER_ROLES",
+    "load_homie_controller_checkpoint",
+    "validate_homie_controller_sha256",
+]
