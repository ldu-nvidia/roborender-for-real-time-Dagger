diff --git a/gr00t/rl/simulator/isaacsim/isaacsim.py b/gr00t/rl/simulator/isaacsim/isaacsim.py
index 3bab186..5d0a5ee 100644
--- a/gr00t/rl/simulator/isaacsim/isaacsim.py
+++ b/gr00t/rl/simulator/isaacsim/isaacsim.py
@@ -1987,6 +1987,44 @@ class IsaacSim(BaseSimulator):
             }
         return out
 
+    def get_policy_view_stack(self):
+        """Policy RGB for several views, tiled vertically into one image.
+
+        Returns [B, n_views*H, W, 3] float in 0-1 at cameras.camera_resolutions, or None
+        when cameras.policy_views is unset (single ego view, the historical behaviour).
+        Reuses the conditioning cameras, so this costs a downsample, not a new render.
+        """
+        views = getattr(self.simulator_config.cameras, "policy_views", None)
+        if not views:
+            return None
+        cams = getattr(self, "conditioning_cameras", None)
+        if not cams:
+            return None
+        missing = [v for v in views if v not in cams]
+        if missing:
+            raise ValueError(
+                f"cameras.policy_views {missing} have no conditioning camera; "
+                f"available: {sorted(cams)}"
+            )
+        self.refresh_conditioning_render()
+        out_h, out_w = (int(x) for x in self.simulator_config.cameras.camera_resolutions)
+        tiles = []
+        for vname in views:
+            rgb = self.scene.sensors[f"cond_cam_{vname}"].data.output.get("rgb")
+            if rgb is None:
+                raise ValueError(f"conditioning camera {vname} renders no rgb; "
+                                 "set cameras.depth_hi_robot_rgb: true")
+            rgb = rgb[..., :3].float()
+            if rgb.max() > 1.0:
+                rgb = rgb / 255.0
+            if rgb.shape[1:3] != (out_h, out_w):
+                rgb = torch.nn.functional.interpolate(
+                    rgb.permute(0, 3, 1, 2), size=(out_h, out_w),
+                    mode="bilinear", align_corners=False,
+                ).permute(0, 2, 3, 1)
+            tiles.append(rgb)
+        return torch.cat(tiles, dim=1)  # stack along height
+
     def get_depth_hi_image(self):
         if getattr(self, "depth_hi_camera", None) is None:
             return None
