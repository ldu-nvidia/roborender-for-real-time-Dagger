diff --git a/gr00t/rl/config/exp/loco_manip/wsdpt_image_dagger_3view.yaml b/gr00t/rl/config/exp/loco_manip/wsdpt_image_dagger_3view.yaml
new file mode 100644
index 0000000..1557865
--- /dev/null
+++ b/gr00t/rl/config/exp/loco_manip/wsdpt_image_dagger_3view.yaml
@@ -0,0 +1,120 @@
+# @package _global_
+# Image-model DAgger with a THREE-VIEW policy.
+#
+# vision_obs is the three camera views tiled vertically into one image:
+#
+#     [ head_color ]  108x192
+#     [ hand_left  ]  108x192   ->  vision_obs (324, 192, 3)  ->  ResNet18
+#     [ hand_right ]  108x192
+#
+# Ray-traced envs take the tiles from the conditioning cameras (already rendered for the
+# renderer, downsampled here); relabelled envs take them from Image3F, which is natively a
+# synchronized 3-view model. Both paths therefore produce the same layout.
+#
+# This changes the observation shape, so single-view checkpoints (offline BC 57.3%, image
+# DAgger rounds 1-4 incl. the 69.3% policy) CANNOT be warm-started -- launch with CKPT=none.
+#
+# Kept as a self-contained copy of wsdpt_image_dagger.yaml rather than inheriting from it:
+# Hydra resolves an included config's defaults relative to the including config's group,
+# which turns the parent's `loco_manip/wsdpt_student_...` default into
+# `exp/loco_manip/loco_manip/wsdpt_student_...` and fails to load.
+
+defaults:
+  - loco_manip/wsdpt_student_for_teacher_v8q8.002_resnet_rgb_delay
+  - _self_
+
+exp_var: videogen_collect
+
+# Swap in the videogen trainer (keeps everything else from the homie API trainer).
+trainer:
+  _target_: gr00t.rl.trl.trainer.distill_trainer_videogen.TRLDistillTrainerVideoGen
+
+# Each env chunk costs one video generation (~4-8 s on the render GPU), so run
+# few envs. Override on the CLI with num_envs=N as needed.
+num_envs: 32
+
+simulator:
+  config:
+    cameras:
+      enable_cameras: true
+      # Depth is required: it is the control signal sent to the video model.
+      # RGB stays enabled because the obs pipeline still reads it (the frames
+      # are overwritten with generated RGB before every BC update).
+      camera_types:
+        - rgb: true
+        - depth: true
+      camera_resolutions: [108, 192]
+      stack_depth_image: false
+      depth_hi_resolution: [480, 832]
+      depth_hi_robot_rgb: true
+      # Views the POLICY consumes, in tile order (top to bottom). Each
+      # needs a conditioning camera; RGB requires depth_hi_robot_rgb: true.
+      policy_views: [head_color, hand_left, hand_right]
+      add_scene_walls: true
+      wall_distance: 2.5
+      wall_height: 2.5
+      # native3view conditioning: head + both wrist cameras. Head pose matches
+      # the calibrated d435 mount; wrist extrinsics are initial guesses — tune
+      # pos/rot after inspecting the first dumped frames.
+      conditioning_views:
+        # wrist mounts derived from kinematic probe (palm = +4.2cm along +X of
+        # wrist_yaw_link) + orientation sweep: camera 2cm along hand axis, 3cm
+        # up, looking along the hand (identity in world convention).
+        - {name: hand_left, link: left_wrist_yaw_link, pos: [-0.08, 0.0, -0.06], rot: [1.0, 0.0, 0.0, 0.0]}
+        - {name: hand_right, link: right_wrist_yaw_link, pos: [-0.08, 0.0, -0.06], rot: [1.0, 0.0, 0.0, 0.0]}
+        - {name: head_color, link: d435_link, pos: [0.0, 0.035, 0.0], rot: [0.99955, 0.0, 0.0299955, 0.0]}
+algo:
+  config:
+    num_mini_batches: 1
+    value_loss_coef: 0.0
+    entropy_coef: 0.0
+
+    # One DAgger/BC update per 81-step chunk (= the video model's clip length)
+    # instead of every step.
+    num_steps_per_env: 81
+
+    videogen:
+      enable: true
+      mode: image_dagger
+      image3f_endpoint_files:
+        - /svl/u/ravenh/fast_roborender/image3f_server_endpoint.txt
+        - /svl/u/ravenh/fast_roborender/image3f_server_endpoint_2.txt
+        - /svl/u/ravenh/fast_roborender/image3f_server_endpoint_3.txt
+      anchor_pool_dir: /vision/u/ravenh/anchor_pool_2048
+      anchor_index: 0
+      raytraced_mix_prob: 0.5
+      save_raw_depth: false
+      save_raw_depth_native: false
+      host: 127.0.0.1
+      port: 18913
+      prompt: "This video shows in the background, a bright minimalist room with light gray walls and a light wooden floor. In the foreground, on the white table, there is a plastic bottle and a shallow gray tray. The robot is instructed to pick up the bottle and place it into the tray."
+      seed: 42
+      # Metric depth -> uint8 control-video normalization.
+      control_resolution: [240, 416]
+      depth_mode: h5_v4   # exact Sim2RealGen training recipe (depth_methods.py)
+      depth_h5v4_per_view:
+        head_color: {raw_clip: [0.05, 10.0], inv_clip: [1.0, 40.0], norm_range: [0.05, 2.6]}
+        hand_left:  {raw_clip: [0.0, 1.5],  inv_clip: [0.7, 100.0], raw_pct: [1, 99]}
+        hand_right: {raw_clip: [0.0, 1.5],  inv_clip: [0.7, 100.0], raw_pct: [1, 99]}
+      depth_near: 0.25
+      depth_near_per_view:
+        hand_left: 0.08
+        hand_right: 0.08
+        head_color: 0.25
+      depth_far: 6.0
+      invert_depth: true
+      # teacher: teacher's actions drive the env during the rollout (student is
+      #          trained purely from the relabeled BC loss).
+      # student: student drives, seeing the last generated frame of the
+      #          previous chunk as (stale) vision input.
+      rollout_action_source: teacher
+      # The TRT engine contract is exactly two 416x240 views; the single ego
+      # view is duplicated into both slots and primary_view is used for obs.
+      dump_first_n_chunks: 0
+      dump_dir: /svl/u/ravenh/fast_roborender/videogen_frames
+      view_names: [head_color, hand_left, hand_right]
+      primary_view: head_color
+
+# 3 tiles stacked along height; scales the shared obs config's RGB dims.
+# Keep equal to len(simulator.config.cameras.policy_views).
+policy_view_count: 3
