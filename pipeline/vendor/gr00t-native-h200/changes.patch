+from collections.abc import Mapping
+import hashlib
+import json
+import math
+from pathlib import Path
+import re
+
+
+NATIVE_OBSERVATION_SOURCE = "native"
+NATIVE_ACTOR_ROLES = frozenset(
+    {"bc_collect", "dagger_collect", "validation_collect", "evaluate", "test"}
+)
+NATIVE_POLICY_VIEWS = ("head_color", "hand_left", "hand_right")
+NATIVE_POLICY_IMAGE_SHAPE = (324, 192, 3)
+COLLECTION_ROLES = frozenset({"bc_collect", "dagger_collect", "validation_collect"})
+MOTION_PARTITION_SCHEMA = "fast_roborender.round_dagger.motion_partition.v1"
+_SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
+_PURPOSE_BY_ROLE = {
+    "bc_collect": "train",
+    "dagger_collect": "train",
+    "validation_collect": "validation",
+    "evaluate": "validation",
+    "test": "test",
+}
+_NATIVE_CONFIG_KEYS = frozenset(
+    {
+        "role", "purpose", "observation_source", "rollout_action_source",
+        "beta_schedule", "beta_start", "beta_end", "beta_decay_iters",
+        "view_names", "primary_view", "split_manifest_path",
+        "split_manifest_sha256", "split_sha256", "group_ids", "panel_sha256",
+    }
+)
+
+
+def _require_sha256(value, label: str) -> str:
+    if type(value) is not str or not _SHA256_RE.fullmatch(value):
+        raise ValueError(f"{label} must be a lowercase 64-character SHA-256")
+    return value
+
+
+def _load_partition_manifest(path_value, digest_value) -> dict:
+    if type(path_value) is not str or not path_value:
+        raise ValueError("native_dagger.split_manifest_path must be an explicit file")
+    path = Path(path_value).expanduser()
+    if not path.is_absolute():
+        path = Path.cwd() / path
+    path = path.resolve()
+    if not path.is_file() or path.is_symlink():
+        raise ValueError("native_dagger.split_manifest_path must be a regular file")
+    expected_digest = _require_sha256(digest_value, "native_dagger.split_manifest_sha256")
+    payload = path.read_bytes()
+    actual_digest = hashlib.sha256(payload).hexdigest()
+    if actual_digest != expected_digest:
+        raise ValueError("native_dagger split manifest digest mismatch")
+    try:
+        document = json.loads(payload.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise ValueError("native_dagger split manifest is not valid JSON") from exc
+    if not isinstance(document, dict) or set(document) != {
+        "schema", "split_sha256", "purpose", "groups",
+    }:
+        raise ValueError("native_dagger split manifest has invalid top-level fields")
+    if document["schema"] != MOTION_PARTITION_SCHEMA:
+        raise ValueError(f"native_dagger split manifest schema must be {MOTION_PARTITION_SCHEMA!r}")
+    purpose = document["purpose"]
+    if purpose not in {"train", "validation", "test"}:
+        raise ValueError("native_dagger split manifest purpose is invalid")
+    split_sha256 = _require_sha256(document["split_sha256"], "split_sha256")
+    raw_groups = document["groups"]
+    if not isinstance(raw_groups, list) or not raw_groups:
+        raise ValueError("native_dagger split manifest groups must be non-empty")
+    groups = []
+    seen_ids, seen_paths = set(), set()
+    for index, item in enumerate(raw_groups):
+        if not isinstance(item, dict) or set(item) != {
+            "group_id", "relative_path", "size_bytes", "motion_sha256",
+        }:
+            raise ValueError(f"native_dagger split group {index} has invalid fields")
+        group_id, relative_path, size_bytes = (
+            item["group_id"], item["relative_path"], item["size_bytes"]
+        )
+        if type(group_id) is not str or not group_id or group_id in seen_ids:
+            raise ValueError("native_dagger split group IDs must be unique strings")
+        token = Path(relative_path) if type(relative_path) is str else Path("/")
+        if (type(relative_path) is not str or not relative_path or token.is_absolute()
+                or ".." in token.parts or token.suffix.lower() != ".npz"
+                or relative_path in seen_paths):
+            raise ValueError("native_dagger split relative paths must be unique safe NPZ paths")
+        if type(size_bytes) is not int or size_bytes <= 0:
+            raise ValueError("native_dagger split size_bytes must be a positive integer")
+        motion_sha256 = _require_sha256(
+            item["motion_sha256"], f"group {group_id!r} motion_sha256"
+        )
+        seen_ids.add(group_id)
+        seen_paths.add(relative_path)
+        groups.append({
+            "group_id": group_id, "relative_path": relative_path,
+            "size_bytes": size_bytes, "motion_sha256": motion_sha256,
+        })
+    return {
+        "path": str(path), "manifest_sha256": actual_digest,
+        "split_sha256": split_sha256, "purpose": purpose,
+        "groups": tuple(groups),
+    }
+
+
+def policy_observation_for_role(observation: Mapping, role: str):
+    """Hide privileged teacher state from closed-loop validation and test."""
+    if role not in NATIVE_ACTOR_ROLES:
+        raise ValueError(f"unsupported native actor role: {role!r}")
+    if role in {"evaluate", "test"}:
+        return {key: value for key, value in observation.items() if key != "teacher_obs"}
+    return observation
+
+
+def student_only_native_role(role: str) -> bool:
+    if role not in NATIVE_ACTOR_ROLES:
+        raise ValueError(f"unsupported native actor role: {role!r}")
+    return role in {"evaluate", "test"}
+
+
+def validate_native_split_runtime(reset_config, native: Mapping) -> None:
+    """Prove simulator reset resolution uses this role's exact partition."""
+    if not isinstance(reset_config, Mapping) and not hasattr(reset_config, "get"):
+        raise TypeError("env.config.reset_from_dataset must be a mapping")
+    get = reset_config.get
+    if get("enable", False) is not True or get("use_motion_file_dir", False) is not True:
+        raise ValueError("native actor requires manifest-backed dataset reset")
+    if get("motion_split_verify_content", True) is not True:
+        raise ValueError("native actor motion content verification cannot be disabled")
+    configured_path = Path(str(get("motion_split_manifest", ""))).expanduser()
+    if not configured_path.is_absolute():
+        configured_path = Path.cwd() / configured_path
+    if configured_path.resolve() != Path(native["split_manifest_path"]):
+        raise ValueError("simulator split manifest does not match native_dagger")
+    if get("motion_split_manifest_sha256") != native["split_manifest_sha256"]:
+        raise ValueError("simulator split manifest digest does not match native_dagger")
+    if get("motion_split_role") != native["purpose"]:
+        raise ValueError("simulator motion_split_role does not match native_dagger purpose")
+    if tuple(get("motion_split_group_ids", ()) or ()) != native["group_ids"]:
+        raise ValueError("simulator motion split group IDs do not match native_dagger")
+    if get("motion_split_offset", 0) != 0 or get("motion_split_limit", None) is not None:
+        raise ValueError("native actor split groups forbid unbound motion windows")
+
+
+def validate_native_dagger_config(config: Mapping) -> dict:
+    """Return a plain, validated native actor contract."""
+    if not isinstance(config, Mapping):
+        raise TypeError("algo.config.native_dagger must be a mapping")
+    unknown = sorted(set(config) - _NATIVE_CONFIG_KEYS)
+    if unknown:
+        raise ValueError(f"unsupported native_dagger fields: {unknown}")
+    missing = sorted(key for key in _NATIVE_CONFIG_KEYS - {"beta_decay_iters"} if key not in config)
+    if missing:
+        raise ValueError(f"native_dagger is missing required fields: {missing}")
+    role = config["role"]
+    if type(role) is not str or role not in NATIVE_ACTOR_ROLES:
+        raise ValueError("native_dagger.role must be one of " + ", ".join(sorted(NATIVE_ACTOR_ROLES)))
+    purpose = config["purpose"]
+    expected_purpose = _PURPOSE_BY_ROLE[role]
+    if purpose != expected_purpose:
+        raise ValueError(f"native_dagger role {role!r} requires purpose={expected_purpose!r}")
+    if config["observation_source"] != NATIVE_OBSERVATION_SOURCE:
+        raise ValueError("native_dagger.observation_source must be exactly 'native'")
+    partition = _load_partition_manifest(config["split_manifest_path"], config["split_manifest_sha256"])
+    if partition["purpose"] != purpose:
+        raise ValueError("native_dagger role/purpose does not match the partition manifest")
+    split_sha256 = _require_sha256(config["split_sha256"], "native_dagger.split_sha256")
+    if partition["split_sha256"] != split_sha256:
+        raise ValueError("native_dagger full split digest does not match the partition manifest")
+    raw_group_ids = config["group_ids"]
+    if isinstance(raw_group_ids, (str, bytes)):
+        raise ValueError("native_dagger.group_ids must be a non-empty list")
+    try:
+        group_ids = tuple(raw_group_ids)
+    except TypeError as exc:
+        raise ValueError("native_dagger.group_ids must be a non-empty list") from exc
+    manifest_group_ids = tuple(item["group_id"] for item in partition["groups"])
+    if group_ids != manifest_group_ids:
+        raise ValueError("native_dagger.group_ids must exactly match the ordered partition manifest")
+    panel_sha256 = config["panel_sha256"]
+    if purpose == "train":
+        if panel_sha256 is not None:
+            raise ValueError("native training collection forbids a validation/test panel")
+    else:
+        panel_sha256 = _require_sha256(panel_sha256, f"native_dagger {purpose} panel_sha256")
+
+    views = tuple(config["view_names"])
+    if views != NATIVE_POLICY_VIEWS:
+        raise ValueError("native_dagger.view_names must be exactly " + repr(NATIVE_POLICY_VIEWS))
+    if config["primary_view"] != NATIVE_POLICY_VIEWS[0]:
+        raise ValueError("native_dagger.primary_view must be exactly 'head_color'")
+    source = config["rollout_action_source"]
+    if config["beta_schedule"] != "constant":
+        raise ValueError("native actor beta must be constant within a round")
+    if role in COLLECTION_ROLES:
+        if source != "beta":
+            raise ValueError("native collection requires rollout_action_source=beta")
+    elif source != "student":
+        raise ValueError("native closed-loop evaluation requires student actions")
+    if isinstance(config["beta_start"], bool) or isinstance(config["beta_end"], bool):
+        raise ValueError("native_dagger beta values must be finite numbers")
+    try:
+        beta_start, beta_end = float(config["beta_start"]), float(config["beta_end"])
+    except (TypeError, ValueError) as exc:
+        raise ValueError("native_dagger beta values must be finite numbers") from exc
+    if not (math.isfinite(beta_start) and math.isfinite(beta_end)):
+        raise ValueError("native_dagger beta values must be finite numbers")
+    if not (0.0 <= beta_start <= 1.0 and 0.0 <= beta_end <= 1.0):
+        raise ValueError("native_dagger beta values must be in [0, 1]")
+    if abs(beta_start - beta_end) > 1e-12:
+        raise ValueError("native collection/evaluation beta_start and beta_end must match")
+    if role in {"bc_collect", "validation_collect"} and beta_start != 1.0:
+        raise ValueError(f"{role} requires beta=1 (expert behavior)")
+    if role in {"evaluate", "test"} and beta_start != 0.0:
+        raise ValueError("closed-loop evaluation requires beta=0 (student behavior)")
+    decay_iters = config.get("beta_decay_iters", 1)
+    if type(decay_iters) is not int or decay_iters != 1:
+        raise ValueError("native_dagger.beta_decay_iters must be exactly 1")
+    return {
+        "role": role, "purpose": purpose, "observation_source": NATIVE_OBSERVATION_SOURCE,
+        "rollout_action_source": source, "beta_schedule": "constant",
+        "beta_start": beta_start, "beta_end": beta_end, "beta_decay_iters": decay_iters,
+        "view_names": views, "primary_view": config["primary_view"],
+        "split_manifest_path": partition["path"],
+        "split_manifest_sha256": partition["manifest_sha256"],
+        "split_sha256": split_sha256, "group_ids": group_ids,
+        "panel_sha256": panel_sha256,
+    }
