+    def _setup_storage(self):
+        super()._setup_storage()
+        self.storage.register_key(
+            "student_actions", shape=(self.num_act,), dtype=torch.float
+        )
+        self.storage.register_key("expert_mask", shape=(1,), dtype=torch.bool)
+        self.storage.register_key("round_global_env_ids", shape=(1,), dtype=torch.long)
+        self.storage.register_key("round_episode_ids", shape=(1,), dtype=torch.long)
