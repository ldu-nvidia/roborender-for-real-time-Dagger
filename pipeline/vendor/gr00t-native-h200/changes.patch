+    def test_native_camera_content_requires_each_view_to_be_spatial_and_live(self):
+        namespace = {
+            "np": np,
+            "torch": torch,
+            "NATIVE_OBSERVATION_SOURCE": "native",
+            "NATIVE_POLICY_VIEWS": ("head_color", "hand_left", "hand_right"),
+            "NATIVE_POLICY_IMAGE_SHAPE": (324, 192, 3),
+        }
+        observe = _load_method(
+            TRAINER, "TRLNativeDaggerTrainer", "_native_rgb_observation", namespace
+        )
+        finalize = _load_method(
+            TRAINER, "TRLNativeDaggerTrainer", "_finalize_native_camera_content",
+            {"NATIVE_POLICY_VIEWS": namespace["NATIVE_POLICY_VIEWS"]},
+        )
+        mean = torch.tensor((0.485, 0.456, 0.406)).reshape(1, 1, 1, 1, 3)
+        std = torch.tensor((0.229, 0.224, 0.225)).reshape(1, 1, 1, 1, 3)
+        x = torch.linspace(0.1, 0.7, 192).reshape(1, 1, 1, 192, 1)
+        raw = x.expand(2, 3, 108, 192, 3).clone()
+        raw[:, 1] += 0.05
+        raw[:, 2] += 0.10
+
+        def normalized(value):
+            return ((value - mean) / std).reshape(2, 324, 192, 3)
+
+        messages = []
+        trainer = _native_trainer()
+        trainer._native_rank = 3
+        trainer.accelerator = SimpleNamespace(print=messages.append)
+        observe(trainer, {"vision_obs": normalized(raw)}, None)
+        observe(trainer, {"vision_obs": normalized(torch.roll(raw, 1, dims=3))}, None)
+        trainer._native_camera_temporal_ok = [True, True, True]
+        marker = finalize(trainer)
+        self.assertEqual(
+            marker,
+            "NATIVE_CAMERA_CONTENT_OK rank=3 "
+            "views=head_color,hand_left,hand_right spatial=1 temporal=1 distinct=1",
+        )
+        self.assertEqual(messages, [marker])
+
+        frozen = _native_trainer()
+        frozen._native_rank = 0
+        frozen.accelerator = SimpleNamespace(print=lambda _message: None)
+        observe(frozen, {"vision_obs": normalized(raw)}, None)
+        changed = torch.roll(raw, 1, dims=3)
+        changed[:, 2] = raw[:, 2]
+        observe(frozen, {"vision_obs": normalized(changed)}, None)
+        frozen._native_camera_temporal_ok = [True, True, False]
+        with self.assertRaisesRegex(RuntimeError, "hand_right"):
+            finalize(frozen)
+
+        constant = _native_trainer()
+        constant._native_rank = 0
+        constant.accelerator = SimpleNamespace(print=lambda _message: None)
+        observe(constant, {"vision_obs": torch.zeros_like(normalized(raw))}, None)
+        observe(constant, {"vision_obs": torch.zeros_like(normalized(raw))}, None)
+        constant._native_camera_temporal_ok = [True, True, True]
+        with self.assertRaisesRegex(RuntimeError, "spatial-content"):
+            finalize(constant)
+
+        duplicated = _native_trainer()
+        duplicated._native_rank = 0
+        duplicated.accelerator = SimpleNamespace(print=lambda _message: None)
+        same_views = raw[:, :1].expand(-1, 3, -1, -1, -1).clone()
+        observe(duplicated, {"vision_obs": normalized(same_views)}, None)
+        observe(
+            duplicated,
+            {"vision_obs": normalized(torch.roll(same_views, 1, dims=3))},
+            None,
+        )
+        duplicated._native_camera_temporal_ok = [True, True, True]
+        with self.assertRaisesRegex(RuntimeError, "inter-view distinctness"):
+            finalize(duplicated)
+
+        outside = raw.clone()
+        outside[:, 0, 0, 0, 0] = 1.1
+        with self.assertRaisesRegex(RuntimeError, "RGB range"):
+            observe(_native_trainer(), {"vision_obs": normalized(outside)}, None)
