index 0000000000000000000000000000000000000000..abd373a2df2ff95a10d7a7f355d5d94ded959835
--- /dev/null
+++ b/gr00t/rl/config/exp/loco_manip/wsdpt_round_actor_native_3view.yaml
@@ -0,0 +1,168 @@
+# @package _global_
+# Canonical three-view H200 Isaac conditioning collector.
+#
+# `bc_collect` is the safe default for the first generation. Override role/beta
+# together only after binding a generation-specific rendered policy input:
+#   labeled heldout validation: role=validation_collect, purpose=validation, beta=1
+#   validation:    role=evaluate, action source=student, beta_start=beta_end=0
+#   final test:    role=test, action source=student, beta_start=beta_end=0
+# Isaac collection publishes renderer inputs, never learner-ready simulator RGB.
+# Validation is rendered and scored in a separate heldout process.  Final test
+# keeps only its sealed scenario registry until closed-loop execution.
+
+defaults:
+  - loco_manip/wsdpt_student_for_teacher_v8q8.002_resnet_rgb_delay
+  - _self_
+
+exp_var: round_dagger_actor_native_3view
+
+trainer:
+  _target_: gr00t.rl.trl.trainer.distill_trainer_native_dagger.TRLNativeDaggerTrainer
+
+# One independent actor process on admitted physical GPU 0 owns 128 Isaac
+# environments. Two disjoint sequential waves provide the canonical 256
+# environment streams; the other seven H200s remain host-inventory evidence.
+# Held-out validation/test launchers explicitly override this to their fixed
+# 32-environment panels and are not part of the production collection world.
+num_envs: 128
+
+# The native collector is cold-cache local.  The robot wrapper selects only the
+# canonical articulation prim and replaces its four remote MDLs.  The ground
+# bundle is the exact Isaac 5.1 default plane and its three relative textures.
+robot:
+  asset:
+    usd_file: "g1/g1_43dof_native_local.usda"
+
+terrain:
+  local_ground_usd: "gr00t/rl/data/terrain/isaac_5_1_grid/default_environment.usd"
+
+simulator:
+  config:
+    sim:
+      # 200-Hz physics / 4 = 50-Hz control; one camera refresh every
+      # 40 physics ticks = 10 control transitions = 5 Hz. Native camera
+      # rendering is explicitly authorized at those episode-local states.
+      render_interval: 40
+    cameras:
+      enable_cameras: true
+      policy_camera_mode: roborender_conditioning
+      camera_types:
+        - rgb: true
+      camera_resolutions: [108, 192]
+      stack_depth_image: false
+      policy_views: [head_color, hand_left, hand_right]
+      policy_view_layout: vertical
+      # Three shared sensors provide both the temporary simulator RGB policy
+      # observation and the sparse 5-Hz inputs needed by RoboRender. The
+      # sampled 480x832 capture is compacted to the 240x416 wire contract.
+      depth_hi_resolution: [480, 832]
+      depth_hi_robot_rgb: true
+      conditioning_views:
+        - {name: head_color, link: d435_link, pos: [0.0, 0.035, 0.0], rot: [0.99955, 0.0, 0.0299955, 0.0]}
+        - {name: hand_left, link: left_wrist_yaw_link, pos: [-0.08, 0.0, -0.06], rot: [1.0, 0.0, 0.0, 0.0]}
+        - {name: hand_right, link: right_wrist_yaw_link, pos: [-0.08, 0.0, -0.06], rot: [1.0, 0.0, 0.0, 0.0]}
+      add_scene_walls: true
+      wall_distance: 2.5
+      wall_height: 2.5
+
+env:
+  config:
+    native_policy_view_count: ${policy_view_count}
+    reset_from_dataset:
+      # A launcher must supply the content-bound role-only partition produced
+      # from the committed 33-group split. Missing values are a hard stop.
+      motion_split_manifest: ???
+      motion_split_manifest_sha256: ???
+      motion_split_role: train
+      motion_split_group_ids: ???
+      motion_split_verify_content: true
+      motion_split_offset: 0
+      motion_split_limit: null
+
+# Native policy RGB is normalized exactly once at the simulator boundary.
+domain_rand:
+  # Appearance is produced by RoboRender after capture.  Avoid remote Isaac
+  # asset enumeration/downloads and keep this phase deterministic/offline.
+  # The inherited extrinsics randomizer controls only the removed legacy ego
+  # camera.  The three calibrated RoboRender conditioning sensors must remain
+  # fixed unless a future three-view-aware randomizer is implemented.
+  extrinsics_randomization:
+    enabled: false
+  randomize_dome_light: false
+  randomize_robot_material: false
+  randomize_floor_material: false
+  randomize_table_material: false
+  randomize_object_material: false
+  image_augmentation:
+    enabled: false
+  depth_augmentation:
+    enabled: false
+
+algo:
+  config:
+    num_mini_batches: 1
+    num_learning_epochs: 0
+    value_loss_coef: 0.0
+    entropy_coef: 0.0
+    num_steps_per_env: 512
+    rollout_with_teacher_num_steps: 0
+    enforce_teacher_rollout: false
+    actor:
+      backbone:
+        vision_module:
+          module_config_dict:
+            layer_config:
+              # Checkpoint loading supplies every weight. Constructor downloads
+              # are forbidden in the isolated native actor runtime.
+              pretrained: false
+
+    # Validation/test record exactly one closed-loop episode per environment,
+    # including per-episode success and any explicit simulator safety signal.
+    eval:
+      eval_num_envs_episodes: true
+
+    native_dagger:
+      role: bc_collect
+      purpose: train
+      observation_source: native
+      # The coordinator overrides both values with the round's frozen beta.
+      rollout_action_source: beta
+      beta_schedule: constant
+      beta_start: 1.0
+      beta_end: 1.0
+      beta_decay_iters: 1
+
+      view_names: [head_color, hand_left, hand_right]
+      primary_view: head_color
+
+      # These mirror the simulator reset contract. Validation/test must also
+      # provide their immutable panel SHA-256; collection forbids one.
+      split_manifest_path: ${env.config.reset_from_dataset.motion_split_manifest}
+      split_manifest_sha256: ${env.config.reset_from_dataset.motion_split_manifest_sha256}
+      split_sha256: ???
+      group_ids: ${env.config.reset_from_dataset.motion_split_group_ids}
+      panel_sha256: null
+
+    # Immutable Isaac -> RoboRender input contract.  Text and scalar renderer
+    # inputs are recorded in the JSON sidecar; NPZ shards contain no objects.
+    roborender_conditioning:
+      schema: fast_roborender.round_dagger.isaac_conditioning.v2
+      view_names: [head_color, hand_left, hand_right]
+      sensor_resolution: [480, 832]
+      control_resolution: [240, 416]
+      depth_mode: h5_v4
+      depth_h5v4_per_view:
+        head_color: {raw_clip: [0.05, 10.0], inv_clip: [1.0, 40.0], norm_range: [0.05, 2.6]}
+        hand_left: {raw_clip: [0.0, 1.5], inv_clip: [0.7, 100.0], raw_pct: [1, 99]}
+        hand_right: {raw_clip: [0.0, 1.5], inv_clip: [0.7, 100.0], raw_pct: [1, 99]}
+      prompt: "This video shows in the background, a bright minimalist room with light gray walls and a light wooden floor. In the foreground, on the white table, there is a plastic bottle and a shallow gray tray. The robot is instructed to pick up the bottle and place it into the tray."
+      seed: 42
+      reference_policy: lagged_generated_with_episode_anchor
+      reference_lag: 256
+      reference_lag_unit: control_steps
+      control_hz: 50
+      render_hz: 5
+      image_stride: 10
+
+policy_view_count: 3
+use_wandb: false
