+    def test_native_hold_cache_survives_tiled_camera_full_buffer_overwrite(self):
+        cache_rows = _load_method(
+            SIMULATOR,
+            "IsaacSim",
+            "_cache_native_conditioning_rows",
+            {"torch": torch},
+        )
+        get_views = _load_method(
+            SIMULATOR, "IsaacSim", "get_conditioning_views"
+        )
+        get_policy = _load_method(
+            SIMULATOR, "IsaacSim", "get_policy_view_stack", {"torch": torch}
+        )
+
+        names = ("head_color", "hand_left", "hand_right")
+
+        def raster(values, channels, dtype):
+            rows = [
+                torch.full((2, 2, channels), value, dtype=dtype)
+                for value in values
+            ]
+            return torch.stack(rows)
+
+        cameras = {}
+        for offset, name in enumerate(names):
+            rgb = raster([10 + offset, 20 + offset, 30 + offset], 3, torch.uint8)
+            depth = raster([1 + offset, 2 + offset, 3 + offset], 1, torch.float32)
+            cameras[name] = SimpleNamespace(
+                num_instances=3,
+                data=SimpleNamespace(output={"rgb": rgb, "depth": depth}),
+            )
+        target = SimpleNamespace(
+            conditioning_cameras=cameras,
+            policy_cameras={},
+            _native_conditioning_cache=None,
+            _native_conditioning_policy_cache=None,
+            simulator_config=SimpleNamespace(
+                cameras=SimpleNamespace(
+                    policy_camera_mode="roborender_conditioning",
+                    policy_views=names,
+                    camera_resolutions=(1, 1),
+                    image_mean=(0.0, 0.0, 0.0),
+                    image_std=(1.0, 1.0, 1.0),
+                )
+            ),
+        )
+        target._cond_cam_robot_rgb = lambda name: cameras[name].data.output["rgb"]
+
+        all_rows = torch.tensor([0, 1, 2], dtype=torch.long)
+        self.assertEqual(cache_rows(target, all_rows), ())
+        held_raw = {
+            name: {
+                key: value[1].clone()
+                for key, value in target._native_conditioning_cache[name].items()
+            }
+            for name in names
+        }
+        held_policy = target._native_conditioning_policy_cache[1].clone()
+
+        # Model IsaacLab's tiled updater: a subset request still overwrites
+        # every row of its public output buffers with the latest global tile.
+        for offset, name in enumerate(names):
+            cameras[name].data.output["rgb"] = raster(
+                [110 + offset, 120 + offset, 130 + offset], 3, torch.uint8
+            )
+            cameras[name].data.output["depth"] = raster(
+                [11 + offset, 12 + offset, 13 + offset], 1, torch.float32
+            )
+        self.assertEqual(
+            cache_rows(target, torch.tensor([0, 2], dtype=torch.long)),
+            names,
+        )
+
+        for name in names:
+            for key, expected in held_raw[name].items():
+                torch.testing.assert_close(
+                    target._native_conditioning_cache[name][key][1], expected
+                )
+            self.assertEqual(
+                int(target._native_conditioning_cache[name]["rgb"][0, 0, 0, 0]),
+                110 + names.index(name),
+            )
+            self.assertEqual(
+                int(target._native_conditioning_cache[name]["rgb"][2, 0, 0, 0]),
+                130 + names.index(name),
+            )
+        torch.testing.assert_close(
+            target._native_conditioning_policy_cache[1], held_policy
+        )
+
+        views = get_views(target)
+        policy = get_policy(target)
+        self.assertIs(views["head_color"]["rgb"], target._native_conditioning_cache["head_color"]["rgb"])
+        self.assertIs(policy, target._native_conditioning_policy_cache)
+
+        uninitialized = SimpleNamespace(**vars(target))
+        uninitialized._native_conditioning_cache = None
+        uninitialized._native_conditioning_policy_cache = None
+        with self.assertRaisesRegex(RuntimeError, "first.*every reset environment"):
+            cache_rows(uninitialized, torch.tensor([0], dtype=torch.long))
