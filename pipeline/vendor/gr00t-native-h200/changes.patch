index 0000000000000000000000000000000000000000..02518c47cd891d27ac3c6e5af51be0c9d31178c3
--- /dev/null
+++ b/gr00t/rl/data/robots/g1/g1_43dof_native_local.usda
@@ -0,0 +1,51 @@
+#usda 1.0
+(
+    defaultPrim = "Robot"
+)
+
+# Reference only the canonical robot prim.  The source layer also contains an
+# unused SimpleRoom sibling with a network reference; selecting this prim keeps
+# that sibling out of the native actor's composed stage.
+def Xform "Robot" (
+    prepend references = @g1_43dof_s3.usda@</g1_29dof_with_hand_rev_1_0>
+)
+{
+    # Replace the four network-backed vMaterials with Kit's built-in OmniPBR.
+    # These stronger opinions affect appearance only; the robot articulation,
+    # geometry, collision, and semantic prim topology remain unchanged.
+    over "Looks"
+    {
+        over "Aluminum_Anodized_Silver"
+        {
+            over "Shader"
+            {
+                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
+                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
+            }
+        }
+        over "Aluminum_Anodized"
+        {
+            over "Shader"
+            {
+                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
+                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
+            }
+        }
+        over "Carpaint_Metallic"
+        {
+            over "Shader"
+            {
+                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
+                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
+            }
+        }
+        over "Aluminum_Anodized_Charcoal"
+        {
+            over "Shader"
+            {
+                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
+                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
+            }
+        }
+    }
+}
