+class NativeLocalAssetCompositionTest(unittest.TestCase):
+    @staticmethod
+    def _relative_topology(stage):
+        root = stage.GetDefaultPrim()
+        root_path = root.GetPath().pathString
+        topology = {}
+        for prim in stage.TraverseAll():
+            path = prim.GetPath().pathString
+            if not prim.GetPath().HasPrefix(root.GetPath()):
+                continue
+            relative = "." if path == root_path else path[len(root_path) + 1 :]
+            topology[relative] = (
+                prim.GetTypeName(),
+                tuple(sorted(prim.GetAppliedSchemas())),
+                tuple(sorted(prop.GetName() for prop in prim.GetProperties())),
+            )
+        return topology
+
+    def _assert_local_composition(self, stage, *, allowed_root: Path):
+        for layer in stage.GetUsedLayers():
+            identifier = layer.realPath or layer.identifier
+            if identifier.startswith("anon:"):
+                continue
+            resolved = Path(identifier).resolve(strict=True)
+            resolved.relative_to(allowed_root)
+
+        for prim in stage.Traverse():
+            for attr in prim.GetAttributes():
+                if attr.GetTypeName() != Sdf.ValueTypeNames.Asset:
+                    continue
+                value = attr.Get()
+                if value is None or value.path == "OmniPBR.mdl":
+                    continue
+                self.assertNotIn("://", value.path)
+                resolved = Path(value.resolvedPath).resolve(strict=True)
+                resolved.relative_to(allowed_root)
+
+    def test_robot_topology_is_preserved_and_composition_has_no_remote_assets(self):
+        original = Usd.Stage.CreateInMemory()
+        original_root = original.DefinePrim("/Robot", "Xform")
+        original_root.GetReferences().AddReference(
+            str(ROBOT_SOURCE),
+            Sdf.Path("/g1_29dof_with_hand_rev_1_0"),
+        )
+        original.SetDefaultPrim(original_root)
+        wrapped = Usd.Stage.Open(str(ROBOT), load=Usd.Stage.LoadNone)
+        self.assertTrue(original)
+        self.assertTrue(wrapped)
+        self.assertEqual(self._relative_topology(original), self._relative_topology(wrapped))
+        self.assertEqual(len(self._relative_topology(wrapped)), 205)
+        self._assert_local_composition(wrapped, allowed_root=ROOT)
+
+    def test_ground_textures_resolve_inside_exact_bundle(self):
+        stage = Usd.Stage.Open(str(GROUND), load=Usd.Stage.LoadNone)
+        self.assertTrue(stage)
+        self._assert_local_composition(stage, allowed_root=GROUND_ROOT)
+
+    def test_imported_ground_collision_accepts_verified_physics_binding(self):
+        stage = Usd.Stage.CreateInMemory()
+        terrain = stage.DefinePrim("/World/ground/terrain", "Xform")
+        self.assertTrue(terrain.GetReferences().AddReference(str(GROUND)))
+        collision = stage.GetPrimAtPath(
+            "/World/ground/terrain/GroundPlane/CollisionPlane"
+        )
+        self.assertTrue(collision.IsValid())
+        self.assertTrue(collision.HasAPI(UsdPhysics.CollisionAPI))
+
+        material_path = Sdf.Path("/World/ground/terrain/physicsMaterial")
+        material = UsdShade.Material.Define(stage, material_path)
+        UsdPhysics.MaterialAPI.Apply(material.GetPrim())
+        UsdShade.MaterialBindingAPI.Apply(collision).Bind(
+            material,
+            bindingStrength=UsdShade.Tokens.strongerThanDescendants,
+            materialPurpose="physics",
+        )
+
+        bound_path = (
+            UsdShade.MaterialBindingAPI(collision)
+            .GetDirectBinding("physics")
+            .GetMaterialPath()
+        )
+        self.assertEqual(bound_path, material_path)
+
