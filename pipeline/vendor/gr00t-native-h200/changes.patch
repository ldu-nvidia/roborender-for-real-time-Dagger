+    def test_native_camera_gate_maps_async_episode_steps_to_source_indices(self):
+        prepare = _load_method(
+            SIMULATOR,
+            "IsaacSim",
+            "prepare_native_conditioning_observation",
+            {"torch": torch},
+        )
+
+        class Target:
+            def __init__(self):
+                camera = SimpleNamespace(num_instances=3)
+                self.conditioning_cameras = {
+                    name: camera
+                    for name in ("head_color", "hand_left", "hand_right")
+                }
+                self.simulator_config = SimpleNamespace(
+                    sim=SimpleNamespace(
+                        fps=200, control_decimation=4, render_interval=40
+                    )
+                )
+                self._native_conditioning_rollout_active = True
+                self._native_conditioning_next_source_transition = 0
+                self._native_conditioning_source_transition_limit = 4
+                self._native_conditioning_render_serial = 0
+                self._native_conditioning_last_attestation = None
+                self.refreshed = []
+
+            def refresh_conditioning_render(self, env_ids):
+                self.refreshed.append(tuple(env_ids.tolist()))
+                self._native_conditioning_render_serial += 1
+                self._native_conditioning_last_changed_views = (
+                    ()
+                    if self._native_conditioning_render_serial == 1
+                    else ("head_color", "hand_left", "hand_right")
+                )
+                return self._native_conditioning_render_serial
+
+        target = Target()
+        states = (
+            ([0, 0, 0], (0, 1, 2), True, 0),
+            ([1, 1, 1], (), False, 1),
+            ([0, 7, 10], (0, 2), True, 2),
+            ([1, 8, 11], (), False, 3),
+        )
+        for steps, sampled, rendered, source_index in states:
+            attestation = prepare(target, torch.tensor(steps, dtype=torch.long))
+            self.assertEqual(attestation["source_transition_index"], source_index)
+            self.assertEqual(attestation["episode_steps"], tuple(steps))
+            self.assertEqual(attestation["sample_env_indices"], sampled)
+            self.assertIs(attestation["rendered"], rendered)
+            self.assertEqual(attestation["render_calls"], 2 if rendered else 0)
+            expected_changed = (
+                ("head_color", "hand_left", "hand_right")
+                if source_index == 2
+                else ()
+            )
+            self.assertEqual(attestation["changed_views"], expected_changed)
+        self.assertEqual(target.refreshed, [(0, 1, 2), (0, 2)])
+
+        # PPO computes one final, unused observation after its last stored
+        # transition. The fixed source limit must prevent an extra render.
+        previous = dict(target._native_conditioning_last_attestation)
+        self.assertIsNone(prepare(target, torch.tensor([0, 0, 0])))
+        self.assertEqual(target._native_conditioning_last_attestation, previous)
+        self.assertEqual(target.refreshed, [(0, 1, 2), (0, 2)])
