+            )
+        if batch <= 0:
+            raise RuntimeError("native actor local environment count must be positive")
+        expected_shape = (batch, *NATIVE_POLICY_IMAGE_SHAPE)
+        if tuple(vision.shape) != expected_shape:
+            raise RuntimeError(
+                f"native simulator vision_obs shape must be {expected_shape}, "
+                f"got {tuple(vision.shape)}"
+            )
+        if cur_dones is not None:
+            if not isinstance(cur_dones, torch.Tensor):
