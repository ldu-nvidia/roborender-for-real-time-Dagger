+def validate_native_cadence(sim_config, conditioning_contract):
+    """Bind Isaac's physical timing to the immutable sparse image contract."""
+
+    try:
+        raw_physics_hz = sim_config.fps
+        raw_decimation = sim_config.control_decimation
+        raw_render_interval = sim_config.render_interval
+        physics_hz = float(raw_physics_hz)
+        control_decimation = int(raw_decimation)
+        render_interval = int(raw_render_interval)
+        control_hz = int(conditioning_contract["control_hz"])
+        render_hz = int(conditioning_contract["render_hz"])
+        image_stride = int(conditioning_contract["image_stride"])
+    except (AttributeError, KeyError, TypeError, ValueError) as exc:
+        raise RuntimeError("native actor simulator cadence is malformed") from exc
+    if (
+        isinstance(raw_physics_hz, bool)
+        or isinstance(raw_decimation, bool)
+        or isinstance(raw_render_interval, bool)
+        or not np.isfinite(physics_hz)
+        or physics_hz <= 0
+        or control_decimation <= 0
+        or float(raw_decimation) != control_decimation
+        or render_interval <= 0
+        or float(raw_render_interval) != render_interval
+        or control_hz != 50
+        or render_hz != 5
+        or image_stride != 10
+        or physics_hz != 200.0
+        or control_decimation != 4
+        or render_interval != 40
+        or physics_hz / control_decimation != control_hz
+        or physics_hz / render_interval != render_hz
+        or render_interval / control_decimation != image_stride
+        or control_hz // render_hz != image_stride
+        or control_hz % render_hz != 0
+    ):
+        raise RuntimeError(
+            "native actor requires exact 50-Hz control and 5-Hz image cadence"
+        )
+    return {
+        "physics_hz": physics_hz,
+        "control_decimation": control_decimation,
+        "render_interval": render_interval,
+        "control_hz": control_hz,
+        "render_hz": render_hz,
+        "image_stride": image_stride,
+    }
+
+
+def mix_native_actions(student_actions, expert_actions, beta):
+    """Choose behavior actions while retaining every expert label."""
+
+    if student_actions.shape != expert_actions.shape:
+        raise RuntimeError("student and expert action shapes must match")
+    if beta == 1.0:
+        expert_mask = torch.ones(
+            student_actions.shape[0], device=student_actions.device, dtype=torch.bool
+        )
+        behavior_actions = expert_actions.clone()
+    elif beta == 0.0:
+        expert_mask = torch.zeros(
+            student_actions.shape[0], device=student_actions.device, dtype=torch.bool
+        )
+        behavior_actions = student_actions
+    else:
+        expert_mask = (
+            torch.rand(student_actions.shape[0], device=student_actions.device) < beta
+        )
+        mask_shape = (-1,) + (1,) * (student_actions.dim() - 1)
+        behavior_actions = torch.where(
+            expert_mask.reshape(mask_shape), expert_actions, student_actions
+        )
+    return behavior_actions, expert_mask
+
+
+def validate_native_runtime_ready_attestation(attestation, num_envs, image_stride):
+    """Validate the first collected state after a full environment reset.
+
+    ``changed_views`` is intentionally empty for this first cache fill: there
+    is no earlier cached frame against which pixel changes can be measured.
+    The successful all-environment render and exact three-view camera contract
+    establish freshness here; later refreshes provide temporal-change evidence.
+    """
+
+    if (
+        type(num_envs) is not int
+        or num_envs <= 0
+        or type(image_stride) is not int
+        or image_stride <= 0
+    ):
+        raise RuntimeError(
+            "native runtime-ready reset lacks a fresh three-view render"
+        )
+    required = {
+        "source_transition_index",
+        "episode_steps",
+        "sample_env_indices",
+        "image_stride",
+        "rendered",
+        "render_calls",
+        "render_serial",
+        "changed_views",
+    }
+    expected_env_indices = tuple(range(num_envs))
+    if (
+        not isinstance(attestation, dict)
+        or set(attestation) != required
+        or attestation["source_transition_index"] != 0
+        or tuple(attestation["episode_steps"]) != (0,) * num_envs
+        or tuple(attestation["sample_env_indices"]) != expected_env_indices
+        or attestation["image_stride"] != image_stride
+        or attestation["rendered"] is not True
+        or attestation["render_calls"] != 2
+        or type(attestation["render_serial"]) is not int
+        or attestation["render_serial"] <= 0
+        or tuple(attestation["changed_views"]) != ()
+    ):
+        raise RuntimeError(
+            "native runtime-ready reset lacks a fresh three-view render"
+        )
+    return dict(attestation)
+
