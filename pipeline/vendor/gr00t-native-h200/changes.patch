+        if previous_serial is not None:
+            expected_serial = previous_serial + (1 if expected_rendered else 0)
+            if render_serial != expected_serial:
+                raise RuntimeError("native conditioning render serial skipped or advanced early")
+        elif not expected_rendered:
+            raise RuntimeError("first native conditioning source transition was held")
+        self._native_conditioning_last_render_serial = render_serial
+        self._native_conditioning_attestations += 1
+        self._native_conditioning_render_events += int(expected_rendered)
+        for view in changed_views:
+            self._native_camera_temporal_ok[NATIVE_POLICY_VIEWS.index(view)] = True
+
+    def _finalize_native_conditioning_cadence(self, expected_transitions):
+        """Emit the rank-health marker only after exact source mapping passed."""
+
+        if self._native_conditioning_attestations != expected_transitions:
+            raise RuntimeError(
+                "native conditioning attestation count differs from rollout length"
+            )
+        minimum_render_events = 1 + (
+            expected_transitions - 1
+        ) // self.roborender_cadence["image_stride"]
+        if self._native_conditioning_render_events < minimum_render_events:
+            raise RuntimeError(
+                "native conditioning rollout missed scheduled render events"
+            )
+        if not all(self._native_camera_temporal_ok):
+            raise RuntimeError("native conditioning authorized refreshes were not live")
+        marker = (
+            f"NATIVE_CAMERA_CADENCE_OK rank={self._native_rank} "
+            "control_hz=50 render_hz=5 stride=10 "
+            "fresh_reset_step0=1 source_mapping=1"
+        )
+        self.accelerator.print(marker)
+        return marker
+
+    def policy_step(self, policy_model, obs_dict, cur_dones=None):
+        obs_dict = self._native_rgb_observation(obs_dict, cur_dones)
+        batch = int(self.env.num_envs)
+        global_offset = int(os.environ.get("ROUND_DAGGER_GLOBAL_ENV_OFFSET", "0"))
+        global_ids = (
+            global_offset
+            + self._native_rank * batch
+            + np.arange(batch, dtype=np.int64)
+        )
+        episode_steps = self._native_episode_steps - 1
+        if bool(np.any(episode_steps < 0)):
+            raise RuntimeError("native actor observed a negative episode step")
+
+        if self._in_native_collection:
+            capture = self._conditioning_capture
+            if capture is None:
+                raise RuntimeError("native collection has no conditioning capture buffer")
+            self._validate_native_conditioning_attestation(episode_steps)
+            views = self.env.simulator.get_conditioning_views()
+            if views is None:
+                raise RuntimeError("native collection received no conditioning views")
+            try:
+                capture.append(
+                    views,
+                    global_env_ids=global_ids,
+                    episode_ids=self._native_episode_ids,
+                    episode_steps=episode_steps,
+                )
+            except ConditioningCaptureError as exc:
+                raise RuntimeError(f"RoboRender conditioning capture failed: {exc}") from exc
+
+        # Privileged state remains inside the simulator for validation/test and
+        # is never passed to the policy stack or written to replay.
+        policy_observation = policy_observation_for_role(obs_dict, self.native_role)
+        policy_state = super().policy_step(
+            policy_model, policy_observation, cur_dones=cur_dones
+        )
+        if not self._in_native_collection:
+            return policy_state
+        if self.native_role not in COLLECTION_ROLES:
+            raise RuntimeError("only collection roles may populate replay storage")
+        if "gt_actions" not in policy_state:
+            raise RuntimeError("native collection requires an expert label at every state")
+        if "actions" not in policy_state:
+            raise RuntimeError("native collection requires student behavior actions")
+
+        student_actions = policy_state["actions"].clone()
+        expert_actions = policy_state["gt_actions"]
+        behavior_actions, expert_mask = mix_native_actions(
+            student_actions, expert_actions, self.native_beta
+        )
+
+        policy_state = dict(policy_state)
+        policy_state["actions"] = behavior_actions
+        policy_state["student_actions"] = student_actions
+        policy_state["expert_mask"] = expert_mask[:, None]
+
+        policy_state["round_global_env_ids"] = torch.as_tensor(
+            global_ids, device=student_actions.device, dtype=torch.long
+        )[:, None]
+        policy_state["round_episode_ids"] = torch.as_tensor(
+            self._native_episode_ids, device=student_actions.device, dtype=torch.long
+        )[:, None]
+        policy_state["round_episode_steps"] = torch.as_tensor(
+            episode_steps, device=student_actions.device, dtype=torch.long
+        )[:, None]
+        return policy_state
+
+    def roborender_conditioning_slice(
