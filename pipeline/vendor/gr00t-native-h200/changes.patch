+def _class_method(source: Path, class_name: str, method_name: str):
+    tree = ast.parse(source.read_text(encoding="utf-8"), filename=str(source))
+    owner = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.ClassDef) and node.name == class_name
+    )
+    return next(
+        node
+        for node in owner.body
+        if isinstance(node, ast.FunctionDef) and node.name == method_name
+    )
+
+
+def _load_method(source: Path, class_name: str, method_name: str, namespace=None):
+    namespace = dict(namespace or {})
+    node = _class_method(source, class_name, method_name)
+    exec(
+        compile(
+            ast.fix_missing_locations(ast.Module(body=[node], type_ignores=[])),
+            str(source),
+            "exec",
+        ),
+        namespace,
+    )
+    return namespace[method_name]
+
+
+def _load_function(name: str, namespace=None):
+    namespace = dict(namespace or {})
+    tree = ast.parse(TRAINER.read_text(encoding="utf-8"), filename=str(TRAINER))
+    node = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.FunctionDef) and node.name == name
+    )
+    exec(
+        compile(
+            ast.fix_missing_locations(ast.Module(body=[node], type_ignores=[])),
+            str(TRAINER),
+            "exec",
+        ),
+        namespace,
+    )
+    return namespace[name]
+
+
+_PARTITION_TEMP = tempfile.TemporaryDirectory()
+_PARTITION_ROOT = Path(_PARTITION_TEMP.name)
+
+
+def _partition(purpose):
+    motion = _PARTITION_ROOT / f"{purpose}.npz"
+    motion.write_bytes(f"{purpose}-motion".encode())
+    group_id = f"{purpose}-group-v1"
+    document = {
+        "schema": "fast_roborender.round_dagger.motion_partition.v1",
+        "split_sha256": "1" * 64,
+        "purpose": purpose,
+        "groups": [{
+            "group_id": group_id,
+            "relative_path": motion.name,
+            "size_bytes": motion.stat().st_size,
+            "motion_sha256": hashlib.sha256(motion.read_bytes()).hexdigest(),
+        }],
+    }
+    manifest = _PARTITION_ROOT / f"{purpose}.json"
+    manifest.write_text(json.dumps(document, sort_keys=True), encoding="utf-8")
+    return {
+        "path": str(manifest),
+        "sha256": hashlib.sha256(manifest.read_bytes()).hexdigest(),
+        "group_ids": [group_id],
+    }
+
+
+_PARTITIONS = {purpose: _partition(purpose) for purpose in ("train", "validation", "test")}
+
+
+def _contract(role="dagger_collect", beta=0.5, action_source="beta"):
+    purpose = {"bc_collect": "train", "dagger_collect": "train",
+               "validation_collect": "validation",
+               "evaluate": "validation", "test": "test"}[role]
+    partition = _PARTITIONS[purpose]
+    return {
+        "role": role,
+        "purpose": purpose,
+        "observation_source": "native",
+        "rollout_action_source": action_source,
+        "beta_schedule": "constant",
+        "beta_start": beta,
+        "beta_end": beta,
+        "beta_decay_iters": 1,
+        "view_names": ["head_color", "hand_left", "hand_right"],
+        "primary_view": "head_color",
+        "split_manifest_path": partition["path"],
+        "split_manifest_sha256": partition["sha256"],
+        "split_sha256": "1" * 64,
+        "group_ids": partition["group_ids"],
+        "panel_sha256": None if purpose == "train" else "2" * 64,
+    }
+
+
