@@ -0,0 +1,109 @@
+from __future__ import annotations
+
+import ast
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+
+SOURCE = (
+    Path(__file__).resolve().parents[1]
+    / "gr00t/rl/simulator/isaacsim/isaacsim.py"
+)
+
+
+def _set_task_visual_state_tensor():
+    tree = ast.parse(SOURCE.read_text(encoding="utf-8"))
+    simulator = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.ClassDef) and node.name == "IsaacSim"
+    )
+    method = next(
+        node
+        for node in simulator.body
+        if isinstance(node, ast.FunctionDef)
+        and node.name == "set_task_visual_state_tensor"
+    )
+    namespace = {}
+    exec(
+        compile(ast.Module(body=[method], type_ignores=[]), str(SOURCE), "exec"),
+        namespace,
+    )
+    return namespace[method.name]
+
+
+class _ShaderInput:
+    def __init__(self):
+        self.values = []
+
+    def Set(self, value):
+        self.values.append(value)
+
+
+class _ShaderPrim:
+    def IsValid(self):
+        return True
+
+
+class _Stage:
+    def __init__(self):
+        self.requested_paths = []
+
+    def GetPrimAtPath(self, path):
+        self.requested_paths.append(path)
+        if path.endswith("/hold_object/material/Shader"):
+            return _ShaderPrim()
+        return None
+
+
+class _Random:
+    def __init__(self):
+        self.calls = []
+
+    def rand(self, size):
+        self.calls.append(size)
+        return (0.1, 0.2, 0.3)
+
+
+class TrayMaterialRandomizationTest(unittest.TestCase):
+    def test_mesh_only_tray_is_left_gray_without_a_shader_probe(self):
+        stage = _Stage()
+        shader_input = _ShaderInput()
+        random = _Random()
+        context = SimpleNamespace(get_stage=lambda: stage)
+        namespace = {
+            "np": SimpleNamespace(random=random),
+            "omni": SimpleNamespace(
+                usd=SimpleNamespace(get_context=lambda: context)
+            ),
+            "UsdShade": SimpleNamespace(
+                Shader=lambda _prim: SimpleNamespace(
+                    GetInput=lambda name: shader_input
+                    if name == "diffuseColor"
+                    else None
+                )
+            ),
+        }
+        method = _set_task_visual_state_tensor()
+        method.__globals__.update(namespace)
+        simulator = SimpleNamespace(
+            task_config=SimpleNamespace(
+                hold_object="hold_object",
+                tray_object="tray_object",
+            ),
+            _task={"hold_object": object()},
+        )
+
+        method(simulator, [0])
+
+        self.assertEqual(
+            stage.requested_paths,
+            ["/World/envs/env_0/hold_object/material/Shader"],
+        )
+        self.assertEqual(len(shader_input.values), 1)
+        self.assertEqual(shader_input.values[0], (0.1, 0.2, 0.3))
+        self.assertEqual(random.calls, [3])
+
+
+if __name__ == "__main__":
+    unittest.main()
