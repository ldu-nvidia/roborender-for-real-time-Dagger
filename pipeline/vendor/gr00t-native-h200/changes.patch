+    def test_behavior_selection_supports_bc_and_dagger(self):
+        mix = _load_function("mix_native_actions", {"torch": torch})
+        student = torch.zeros((8, 3))
+        expert = torch.ones((8, 3))
+
+        behavior, mask = mix(student, expert, 1.0)
+        torch.testing.assert_close(behavior, expert)
+        self.assertTrue(bool(mask.all()))
+
+        behavior, mask = mix(student, expert, 0.0)
+        torch.testing.assert_close(behavior, student)
+        self.assertFalse(bool(mask.any()))
+
+        torch.manual_seed(7)
+        behavior, mask = mix(student, expert, 0.5)
+        expected = torch.where(mask[:, None], expert, student)
+        torch.testing.assert_close(behavior, expected)
+        self.assertTrue(bool(mask.any()))
+        self.assertTrue(bool((~mask).any()))
