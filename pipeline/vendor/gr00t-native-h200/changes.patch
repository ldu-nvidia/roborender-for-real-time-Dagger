-def _atomic_write(path: Path, payload: bytes) -> None:
-    path.parent.mkdir(parents=True, exist_ok=True)
-    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
-    try:
-        with os.fdopen(descriptor, "wb") as handle:
-            handle.write(payload)
-            handle.flush()
-            # Isaac actors run as root in the validated container, whereas the
-            # W&B uploader and human/operator checks run as the submitting
-            # user.  Preserve the atomic write while making completed telemetry
-            # readable after the container exits.
-            os.fchmod(handle.fileno(), 0o444)
-            os.fsync(handle.fileno())
-        os.replace(temporary_name, path)
-    finally:
-        if os.path.exists(temporary_name):
-            os.unlink(temporary_name)
