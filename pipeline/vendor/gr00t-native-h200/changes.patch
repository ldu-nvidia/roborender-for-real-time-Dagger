+"""Fail-closed path resolution for the native H200 Isaac asset bundle."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+
+GR00T_SOURCE_ROOT = Path(__file__).resolve().parents[3]
+
+
+def resolve_native_local_asset(path_value, *, label: str) -> Path:
+    """Resolve a regular asset file contained by the GR00T source snapshot."""
+
+    raw = str(path_value).strip() if path_value is not None else ""
+    if not raw:
+        raise ValueError(f"{label} must name a local asset")
+    if "://" in raw or raw.startswith("~"):
+        raise ValueError(f"{label} must be a bundle-relative local path")
+
+    configured = Path(raw)
+    candidate = configured if configured.is_absolute() else GR00T_SOURCE_ROOT / configured
+    try:
+        resolved = candidate.resolve(strict=True)
+        resolved.relative_to(GR00T_SOURCE_ROOT)
+    except (FileNotFoundError, RuntimeError, ValueError) as exc:
+        raise ValueError(
+            f"{label} must resolve inside {GR00T_SOURCE_ROOT}: {raw!r}"
+        ) from exc
+    if not resolved.is_file() or resolved.stat().st_size <= 0:
+        raise ValueError(f"{label} must resolve to a non-empty regular file: {resolved}")
+    return resolved
