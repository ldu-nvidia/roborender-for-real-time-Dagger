+    def _native_rgb_observation(self, obs_dict, cur_dones):
+        """Validate and identity-return the already normalized simulator RGB."""
+
+        if self.observation_source != NATIVE_OBSERVATION_SOURCE:
+            raise RuntimeError("native actor observation source changed after initialization")
+        if "vision_obs" not in obs_dict:
+            raise RuntimeError("native actor requires simulator vision_obs")
+        vision = obs_dict["vision_obs"]
+        if not isinstance(vision, torch.Tensor):
+            raise RuntimeError("native simulator vision_obs must be a torch.Tensor")
+        if not torch.is_floating_point(vision):
+            raise RuntimeError("native simulator vision_obs must use a floating dtype")
+        if not bool(torch.isfinite(vision).all().item()):
+            raise RuntimeError("native simulator vision_obs must contain only finite values")
+        if self._policy_views != NATIVE_POLICY_VIEWS:
+            raise RuntimeError("native actor policy views changed after initialization")
+
+        try:
+            image_shape = tuple(int(value) for value in self.camera_resolution)
