+    def _validate_native_conditioning_attestation(self, episode_steps):
+        """Bind the simulator render decision to the capture buffer's source row."""
+
+        capture = self._conditioning_capture
+        if capture is None:
+            raise RuntimeError("native collection has no conditioning capture buffer")
+        getter = getattr(
+            self.env.simulator, "get_native_conditioning_attestation", None
+        )
+        if not callable(getter):
+            raise RuntimeError("native simulator has no conditioning render attestation")
+        attestation = getter()
+        required = {
+            "source_transition_index",
+            "episode_steps",
+            "sample_env_indices",
+            "image_stride",
+            "rendered",
+            "render_calls",
+            "render_serial",
+            "changed_views",
+        }
+        if not isinstance(attestation, dict) or set(attestation) != required:
+            raise RuntimeError("native conditioning render attestation is malformed")
+
+        expected_source = int(capture.steps_captured)
+        expected_steps = tuple(int(value) for value in episode_steps.tolist())
+        expected_samples = tuple(
+            int(value)
+            for value in np.flatnonzero(
+                episode_steps % self.roborender_cadence["image_stride"] == 0
+            ).tolist()
+        )
+        expected_rendered = bool(expected_samples)
+        if (
+            attestation["source_transition_index"] != expected_source
+            or tuple(attestation["episode_steps"]) != expected_steps
+            or tuple(attestation["sample_env_indices"]) != expected_samples
+            or attestation["image_stride"]
+            != self.roborender_cadence["image_stride"]
+            or attestation["rendered"] is not expected_rendered
+            or attestation["render_calls"] != (2 if expected_rendered else 0)
+        ):
+            raise RuntimeError(
+                "native conditioning render does not match the source transition"
+            )
+        changed_views = tuple(attestation["changed_views"])
+        if (
+            len(changed_views) != len(set(changed_views))
+            or any(view not in NATIVE_POLICY_VIEWS for view in changed_views)
+            or (not expected_rendered and changed_views)
+        ):
+            raise RuntimeError("native conditioning changed-view evidence is malformed")
+        if expected_source == 0 and (
+            any(step != 0 for step in expected_steps)
+            or expected_samples != tuple(range(int(self.env.num_envs)))
+        ):
