+def _publish_native_actor_trainer_success_marker(environment=None) -> str | None:
+    """Durably prove that the trainer body returned before Kit shutdown.
+
+    ``SimulationApp.close(skip_cleanup=True)`` delegates to Kit's immediate
+    framework shutdown.  That native boundary can terminate the interpreter
+    with status zero before a context manager can replace an active Python
+    exception with ``SystemExit(1)``.  A native actor rank therefore requires
+    this create-only proof, published only after all training work succeeds and
+    before lifecycle cleanup starts.
+    """
+
+    source = os.environ if environment is None else environment
+    raw_path = source.get(_NATIVE_ACTOR_TRAINER_SUCCESS_ENV)
+    if raw_path is None:
+        return None
+    phase = source.get("ROUND_DAGGER_SATURATION_PHASE", "")
+    raw_tmpdir = source.get("TMPDIR", "")
+    identity = actor_process_identity(source)
+    if identity is None or identity.world_size != 1 or identity.rank != 0:
+        raise RuntimeError(
+            "native trainer success marker requires world-1/rank-0 actor identity"
+        )
+    rank = str(identity.rank)
+    if phase not in {"smoke", "probe", "collect"}:
+        raise RuntimeError(
+            "native trainer success marker requires smoke, probe, or collect phase"
+        )
+    path = Path(raw_path)
+    tmpdir = Path(raw_tmpdir)
+    expected = tmpdir.parent / "trainer-body.success"
+    if (
+        not path.is_absolute()
+        or not tmpdir.is_absolute()
+        or tmpdir.name != "tmp"
+        or not tmpdir.is_dir()
+        or tmpdir.is_symlink()
+        or tmpdir.resolve(strict=True) != tmpdir
+        or path != expected
+        or not path.parent.is_dir()
+        or path.parent.is_symlink()
+        or path.parent.resolve(strict=True) != path.parent
+    ):
+        raise RuntimeError("native trainer success marker path is not canonical")
+    payload = f"NATIVE_ACTOR_TRAINER_BODY_OK rank={rank} phase={phase}\n".encode(
+        "ascii"
+    )
+    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
+    flags |= getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
+    try:
+        descriptor = os.open(path, flags, 0o400)
+    except FileExistsError as exc:
+        raise RuntimeError("native trainer success marker already exists") from exc
+    try:
+        view = memoryview(payload)
+        while view:
+            written = os.write(descriptor, view)
+            if written <= 0:
+                raise OSError("short write while publishing trainer success marker")
+            view = view[written:]
+        os.fsync(descriptor)
+    finally:
+        os.close(descriptor)
+    directory_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
+    directory_flags |= getattr(os, "O_CLOEXEC", 0) | getattr(
