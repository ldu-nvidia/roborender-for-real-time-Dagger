{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roborender.dagger.rtx.phase-boundary.v1",
  "title": "RTX native vector DAgger phase-boundary event",
  "type": "object",
  "required": [
    "schema",
    "sequence",
    "run_id",
    "round_id",
    "vector_step",
    "phase",
    "event",
    "started_at_utc",
    "finished_at_utc",
    "elapsed_ms",
    "completed",
    "total",
    "status",
    "counts"
  ],
  "properties": {
    "schema": {"const": "roborender.dagger.rtx.phase-boundary.v1"},
    "sequence": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "round_id": {"type": "integer", "minimum": 1, "maximum": 4},
    "vector_step": {"type": "integer", "minimum": 0},
    "phase": {"type": "string", "minLength": 1, "maxLength": 96},
    "event": {"enum": ["start", "end", "progress", "error"]},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "finished_at_utc": {
      "oneOf": [
        {"type": "string", "format": "date-time"},
        {"type": "null"}
      ]
    },
    "elapsed_ms": {
      "oneOf": [
        {"type": "number", "minimum": 0},
        {"type": "null"}
      ]
    },
    "completed": {"type": "integer", "minimum": 0},
    "total": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "minLength": 1, "maxLength": 96},
    "counts": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": ["boolean", "integer", "number", "string", "null"]
      }
    }
  },
  "additionalProperties": true
}
