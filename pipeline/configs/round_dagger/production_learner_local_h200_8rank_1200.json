{
  "schema": "fast_roborender.round_dagger.production_local_h200_learner_contract.v1",
  "execution": {
    "backend": "local_h200",
    "mode": "direct",
    "resource_shape": "my.gpu.8xh200",
    "nodes": 1,
    "python": "/workspace/project/roborender/runtime/envs/h200_learner/bin/python",
    "entrypoint": "scripts/round_dagger/run_8rank_learner.sh"
  },
  "allocation": {
    "world_size": 8,
    "batch_size_per_rank": 8,
    "global_batch_size": 64
  },
  "optimization": {
    "optimizer_steps": 1200,
    "save_every_steps": 5,
    "learning_rate": 2.5e-5,
    "weight_decay": 0.01,
    "seed": 17,
    "partition_seed": 23
  },
  "artifacts": {
    "mode": "in_place_campaign",
    "replay_directory": "replay",
    "learner_directory": "learner"
  },
  "telemetry": {
    "backend": "local_jsonl",
    "external_reporting_required": false
  },
  "source": {
    "must_be_sealed": true,
    "inventory_schema": "fast_roborender.source_inventory.v1",
    "attestation_schema": "fast_roborender.source_snapshot_attestation.v2"
  }
}
