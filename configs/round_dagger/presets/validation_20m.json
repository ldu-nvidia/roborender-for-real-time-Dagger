{
  "schema": "fast_roborender.round_dagger.campaign_preset.v1",
  "preset_id": "validation_20m",
  "mode": "validation",
  "description": "Bounded live end-to-end validation; proves collection, learning, evaluation, promotion, and telemetry within a hard 20-minute budget.",
  "runner": "bounded_validation",
  "topology": {
    "target_environments": 8,
    "active_environments": 8,
    "cohort_count": 1,
    "actor_ranks_per_cohort": 2,
    "environments_per_actor_rank": 4,
    "macro_round_count": 1,
    "steps_per_environment": 16,
    "transitions_per_cohort": 128,
    "transitions_per_macro_round": 128,
    "transitions_per_campaign": 128
  },
  "learner": {
    "backend": "lepton_reserved_h200",
    "nodes": 1,
    "world_size": 8,
    "batch_size_per_rank": 1,
    "global_batch_size": 8,
    "optimizer_steps": 20,
    "save_every_steps": 10
  },
  "evaluation": {
    "interval_steps": 10,
    "required_optimizer_steps": [
      0,
      10,
      20
    ],
    "heldout_cases": 32,
    "paired_seed_count": 2,
    "environments_per_seed": 2
  },
  "time_budget": {
    "hard_wall_time_seconds": 1200
  },
  "telemetry": {
    "wandb_project": "lepton-dagger-production-1",
    "wandb_run_name_binding": "operator_required"
  },
  "isolation": {
    "artifact_namespace": "validation_20m",
    "production_contract_mutation_allowed": false
  },
  "immutable_contracts": []
}
