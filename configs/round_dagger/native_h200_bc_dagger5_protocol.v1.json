      "parallel_processes": 1,
      "gpus_per_process": 8,
      "fixed_environment": {
        "ROUND_DAGGER_OBSERVATION_SOURCE": "native",
        "ROUND_DAGGER_EVALUATION_PURPOSE": "test_success",
        "ROUND_DAGGER_EVALUATOR_WORLD_SIZE": "8"
      },
      "input_bindings": ["checkpoint", "test_registry", "test_result_output"]
    }
